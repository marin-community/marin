{
  "Control": {
    "$defs": {
      "Candidate": {
        "properties": {
          "files": {
            "default": [],
            "items": {
              "$ref": "#/$defs/TaskResource"
            },
            "title": "Files",
            "type": "array"
          },
          "reply": {
            "title": "Reply",
            "type": "string"
          }
        },
        "required": [
          "reply"
        ],
        "title": "Candidate",
        "type": "object"
      },
      "ControlKind": {
        "enum": [
          "positive",
          "negative",
          "malformed"
        ],
        "title": "ControlKind",
        "type": "string"
      },
      "InlineFile": {
        "additionalProperties": false,
        "description": "File bytes encoded as canonical base64, including UTF-8 text files.",
        "properties": {
          "content_base64": {
            "title": "Content Base64",
            "type": "string"
          },
          "kind": {
            "const": "inline_file",
            "default": "inline_file",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "content_base64"
        ],
        "title": "InlineFile",
        "type": "object"
      },
      "Outcome": {
        "enum": [
          "graded",
          "submission_failure",
          "invalid_task",
          "infra_error",
          "unavailable"
        ],
        "title": "Outcome",
        "type": "string"
      },
      "RewardBand": {
        "description": "The grade a control must receive.\n\nA graded expectation with only an upper bound, or with a lower bound of 0.0 that\nevery reward meets, is a no-credit expectation: a submission failure, which\nscores zero, meets it as well as a graded reward within the bound.",
        "properties": {
          "reward_max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reward Max"
          },
          "reward_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reward Min"
          },
          "status": {
            "$ref": "#/$defs/Outcome"
          }
        },
        "required": [
          "status"
        ],
        "title": "RewardBand",
        "type": "object"
      },
      "TaskResource": {
        "additionalProperties": false,
        "description": "One inline regular file in a workspace or build context.",
        "properties": {
          "mode": {
            "anyOf": [
              {
                "pattern": "^[0-7]{3,4}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Mode"
          },
          "mtime_ns": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Mtime Ns"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/InlineFile"
          }
        },
        "required": [
          "path",
          "source"
        ],
        "title": "TaskResource",
        "type": "object"
      }
    },
    "properties": {
      "candidate": {
        "$ref": "#/$defs/Candidate"
      },
      "expected": {
        "$ref": "#/$defs/RewardBand"
      },
      "kind": {
        "$ref": "#/$defs/ControlKind"
      }
    },
    "required": [
      "candidate",
      "expected",
      "kind"
    ],
    "title": "Control",
    "type": "object"
  },
  "TaskSpec": {
    "$defs": {
      "AnswerCall": {
        "additionalProperties": false,
        "description": "The string ``answer`` argument of one ``submit_answer`` function call.",
        "properties": {
          "kind": {
            "const": "answer_call",
            "default": "answer_call",
            "title": "Kind",
            "type": "string"
          }
        },
        "title": "AnswerCall",
        "type": "object"
      },
      "AnswerType": {
        "description": "The kind of result the task asks the model to produce.",
        "enum": [
          "text",
          "number",
          "json",
          "file",
          "state",
          "workspace_state",
          "native_action"
        ],
        "title": "AnswerType",
        "type": "string"
      },
      "ArtifactKind": {
        "enum": [
          "file",
          "directory",
          "auto"
        ],
        "title": "ArtifactKind",
        "type": "string"
      },
      "AssistantToolCalls": {
        "additionalProperties": false,
        "description": "An assistant message containing function calls.",
        "properties": {
          "calls": {
            "items": {
              "$ref": "#/$defs/ConversationToolCall"
            },
            "minItems": 1,
            "title": "Calls",
            "type": "array"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Content"
          },
          "type": {
            "const": "assistant_tool_calls",
            "default": "assistant_tool_calls",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "calls"
        ],
        "title": "AssistantToolCalls",
        "type": "object"
      },
      "Boxed": {
        "additionalProperties": false,
        "description": "The content of the last ``\\boxed{...}`` in the final assistant message, else the whole message.",
        "properties": {
          "kind": {
            "const": "boxed",
            "default": "boxed",
            "title": "Kind",
            "type": "string"
          }
        },
        "title": "Boxed",
        "type": "object"
      },
      "CommandSemantics": {
        "description": "Execution behavior required by a task, independent of deployment backend.",
        "enum": [
          "linux_process",
          "shell_simulator"
        ],
        "title": "CommandSemantics",
        "type": "string"
      },
      "Constraint": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          }
        },
        "required": [
          "name"
        ],
        "title": "Constraint",
        "type": "object"
      },
      "ConversationInput": {
        "additionalProperties": false,
        "description": "Model-visible conversation prefix, without provider reasoning state.",
        "properties": {
          "events": {
            "items": {
              "discriminator": {
                "mapping": {
                  "assistant_tool_calls": "#/$defs/AssistantToolCalls",
                  "message": "#/$defs/TextMessage",
                  "tool_result": "#/$defs/ToolResult"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextMessage"
                },
                {
                  "$ref": "#/$defs/AssistantToolCalls"
                },
                {
                  "$ref": "#/$defs/ToolResult"
                }
              ]
            },
            "title": "Events",
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "title": "ConversationInput",
        "type": "object"
      },
      "ConversationToolCall": {
        "additionalProperties": false,
        "description": "A recorded call, including JSON arguments rejected by the tool.",
        "properties": {
          "arguments": {
            "$ref": "#/$defs/JsonValue"
          },
          "call_id": {
            "minLength": 1,
            "title": "Call Id",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "call_id",
          "name",
          "arguments"
        ],
        "title": "ConversationToolCall",
        "type": "object"
      },
      "DockerBuildContext": {
        "additionalProperties": false,
        "description": "Unresolved Docker build inputs, preserved as data without executing the recipe.\n\nPaths are relative to the context root, including ``Dockerfile``. Retaining the\nrecipe does not pin mutable base images or downloads made during a build.",
        "properties": {
          "files": {
            "items": {
              "$ref": "#/$defs/TaskResource"
            },
            "title": "Files",
            "type": "array"
          }
        },
        "required": [
          "files"
        ],
        "title": "DockerBuildContext",
        "type": "object"
      },
      "EmptyOutputPolicy": {
        "description": "Whether a present empty answer is scored zero or passed to its grader.",
        "enum": [
          "zero",
          "grade"
        ],
        "title": "EmptyOutputPolicy",
        "type": "string"
      },
      "EnvironmentRequirements": {
        "additionalProperties": false,
        "description": "Operations, initial workspace or unresolved recipe, and tool-provider contracts.",
        "properties": {
          "capabilities": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "command_semantics": {
            "anyOf": [
              {
                "$ref": "#/$defs/CommandSemantics"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "docker_build": {
            "anyOf": [
              {
                "$ref": "#/$defs/DockerBuildContext"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "docker_image": {
            "anyOf": [
              {
                "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Docker Image"
          },
          "environment_variables": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Environment Variables",
            "type": "object"
          },
          "package_spec": {
            "anyOf": [
              {
                "$ref": "#/$defs/PackageSpec"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "packages_lock": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Packages Lock"
          },
          "setup_commands": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Setup Commands",
            "type": "array"
          },
          "tool_providers": {
            "additionalProperties": {
              "$ref": "#/$defs/ProviderRequirement"
            },
            "title": "Tool Providers",
            "type": "object"
          },
          "working_directory": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Working Directory"
          }
        },
        "title": "EnvironmentRequirements",
        "type": "object"
      },
      "ExitCodeReward": {
        "additionalProperties": false,
        "description": "Score a test command as one on exit zero and zero on failure or command timeout.\n\nMachine and preparation failures remain infrastructure errors.",
        "properties": {
          "kind": {
            "const": "exit_code",
            "default": "exit_code",
            "title": "Kind",
            "type": "string"
          }
        },
        "title": "ExitCodeReward",
        "type": "object"
      },
      "FileReward": {
        "additionalProperties": false,
        "description": "The first existing file supplies the score; a missing, empty, or invalid file is a grading failure.\n\nA JSON file's ``detail`` object, when present, becomes the grade detail. ``verdict_json``\nreads a Verifyit verdict, preserving unscored task and infrastructure failures.",
        "properties": {
          "files": {
            "items": {
              "$ref": "#/$defs/RewardFile"
            },
            "minItems": 1,
            "title": "Files",
            "type": "array"
          },
          "kind": {
            "const": "file",
            "default": "file",
            "title": "Kind",
            "type": "string"
          },
          "pass_above": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Pass Above"
          }
        },
        "required": [
          "files"
        ],
        "title": "FileReward",
        "type": "object"
      },
      "FinalAction": {
        "additionalProperties": false,
        "description": "The final assistant message itself: function calls to the task's final tools, or text.",
        "properties": {
          "kind": {
            "const": "final_action",
            "default": "final_action",
            "title": "Kind",
            "type": "string"
          },
          "max_calls": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Calls"
          },
          "normal_submission": {
            "anyOf": [
              {
                "discriminator": {
                  "mapping": {
                    "answer_call": "#/$defs/AnswerCall",
                    "boxed": "#/$defs/Boxed",
                    "json_answer": "#/$defs/JsonAnswer",
                    "json_value": "#/$defs/JsonValueAnswer",
                    "plain_text": "#/$defs/PlainText"
                  },
                  "propertyName": "kind"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/PlainText"
                  },
                  {
                    "$ref": "#/$defs/Boxed"
                  },
                  {
                    "$ref": "#/$defs/JsonAnswer"
                  },
                  {
                    "$ref": "#/$defs/JsonValueAnswer"
                  },
                  {
                    "$ref": "#/$defs/AnswerCall"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Normal Submission"
          },
          "require_call": {
            "default": false,
            "title": "Require Call",
            "type": "boolean"
          }
        },
        "title": "FinalAction",
        "type": "object"
      },
      "FunctionDefinition": {
        "additionalProperties": false,
        "description": "Function advertised to the model, without an execution binding.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Description"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "title": "Parameters",
            "type": "object"
          },
          "strict": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Strict"
          }
        },
        "required": [
          "name",
          "parameters"
        ],
        "title": "FunctionDefinition",
        "type": "object"
      },
      "InlineFile": {
        "additionalProperties": false,
        "description": "File bytes encoded as canonical base64, including UTF-8 text files.",
        "properties": {
          "content_base64": {
            "title": "Content Base64",
            "type": "string"
          },
          "kind": {
            "const": "inline_file",
            "default": "inline_file",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "content_base64"
        ],
        "title": "InlineFile",
        "type": "object"
      },
      "JsonAnswer": {
        "additionalProperties": false,
        "description": "The string ``answer`` field of a JSON object in the final assistant message.",
        "properties": {
          "kind": {
            "const": "json_answer",
            "default": "json_answer",
            "title": "Kind",
            "type": "string"
          }
        },
        "title": "JsonAnswer",
        "type": "object"
      },
      "JsonValue": {},
      "JsonValueAnswer": {
        "additionalProperties": false,
        "description": "The complete final assistant message parsed as one JSON value.",
        "properties": {
          "kind": {
            "const": "json_value",
            "default": "json_value",
            "title": "Kind",
            "type": "string"
          }
        },
        "title": "JsonValueAnswer",
        "type": "object"
      },
      "JudgeCompletionPolicy": {
        "enum": [
          "completed_text",
          "content"
        ],
        "title": "JudgeCompletionPolicy",
        "type": "string"
      },
      "JudgeSpec": {
        "additionalProperties": false,
        "description": "An LLM judge over the answer file.\n\nRubric ``reference`` asks whether the answer matches any of ``references``, after an exact\ngate that answers verbatim matches without a model call. Rubric ``checklist`` asks one yes/no\nquestion per entry of ``criteria`` and scores the fraction answered yes. ``context`` names a\nfile under the tests directory (a conversation transcript, say) shown to the judge alongside the\nanswer. ``constraints`` are IFEval checks that must all pass before the judge is consulted.\n\nRubric ``pairwise`` compares the answer with the single baseline in ``references`` twice, once\nin each position, as Arena-Hard does. ``prompt_template`` places the two answers with\n``{answer_a}`` and ``{answer_b}``. The last match of the first ``verdict_patterns`` entry that\nmatches the reply names a verdict, ``label_scores`` gives assistant A's score for it, and\n``label_weights`` repeats it as several games (Arena-Hard counts a decisive verdict three times).",
        "properties": {
          "api": {
            "default": "chat_completions",
            "title": "Api",
            "type": "string"
          },
          "completion_policy": {
            "$ref": "#/$defs/JudgeCompletionPolicy",
            "default": "completed_text"
          },
          "constraints": {
            "default": [],
            "items": {
              "$ref": "#/$defs/Constraint"
            },
            "title": "Constraints",
            "type": "array"
          },
          "context": {
            "default": "",
            "title": "Context",
            "type": "string"
          },
          "criteria": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Criteria",
            "type": "array"
          },
          "empty_output": {
            "$ref": "#/$defs/EmptyOutputPolicy",
            "default": "zero"
          },
          "exact_gate": {
            "default": true,
            "title": "Exact Gate",
            "type": "boolean"
          },
          "exact_gate_answers": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Exact Gate Answers",
            "type": "array"
          },
          "exact_gate_label": {
            "default": "",
            "title": "Exact Gate Label",
            "type": "string"
          },
          "incomplete_retry_tokens": {
            "default": 0,
            "title": "Incomplete Retry Tokens",
            "type": "integer"
          },
          "label_case": {
            "default": "sensitive",
            "title": "Label Case",
            "type": "string"
          },
          "label_metrics": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            "title": "Label Metrics",
            "type": "object"
          },
          "label_scan": {
            "default": "literal",
            "title": "Label Scan",
            "type": "string"
          },
          "label_scores": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Label Scores",
            "type": "object"
          },
          "label_weights": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Label Weights",
            "type": "object"
          },
          "max_completion_tokens": {
            "default": 8192,
            "title": "Max Completion Tokens",
            "type": "integer"
          },
          "model": {
            "default": "",
            "title": "Model",
            "type": "string"
          },
          "output": {
            "default": "/app/answer.txt",
            "title": "Output",
            "type": "string"
          },
          "prompt_template": {
            "default": "",
            "title": "Prompt Template",
            "type": "string"
          },
          "question": {
            "default": "",
            "title": "Question",
            "type": "string"
          },
          "reasoning_effort": {
            "default": "",
            "title": "Reasoning Effort",
            "type": "string"
          },
          "references": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "References",
            "type": "array"
          },
          "request_timeout": {
            "default": 120.0,
            "title": "Request Timeout",
            "type": "number"
          },
          "rubric": {
            "default": "reference",
            "title": "Rubric",
            "type": "string"
          },
          "strip_candidate_reasoning_blocks": {
            "default": false,
            "title": "Strip Candidate Reasoning Blocks",
            "type": "boolean"
          },
          "strip_reasoning_blocks": {
            "default": false,
            "title": "Strip Reasoning Blocks",
            "type": "boolean"
          },
          "system_prompt": {
            "default": "",
            "title": "System Prompt",
            "type": "string"
          },
          "transport_attempts": {
            "default": 1,
            "title": "Transport Attempts",
            "type": "integer"
          },
          "transport_budget": {
            "default": 180.0,
            "title": "Transport Budget",
            "type": "number"
          },
          "verdict_patterns": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Verdict Patterns",
            "type": "array"
          }
        },
        "title": "JudgeSpec",
        "type": "object"
      },
      "MissingArtifactPolicy": {
        "enum": [
          "error",
          "skip"
        ],
        "title": "MissingArtifactPolicy",
        "type": "string"
      },
      "NoGrader": {
        "additionalProperties": false,
        "description": "A task without a runnable grader; ``contract`` keeps the source's grading terms.",
        "properties": {
          "contract": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "title": "Contract",
            "type": "object"
          },
          "kind": {
            "const": "none",
            "default": "none",
            "title": "Kind",
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "NoGrader",
        "type": "object"
      },
      "PackageSpec": {
        "additionalProperties": false,
        "description": "Python requirements and tools resolved by the selected execution backend.",
        "properties": {
          "pypi_packages": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Pypi Packages"
          },
          "tools": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Tools",
            "type": "array"
          }
        },
        "title": "PackageSpec",
        "type": "object"
      },
      "PlainText": {
        "additionalProperties": false,
        "description": "The whole final assistant message.",
        "properties": {
          "kind": {
            "const": "plain_text",
            "default": "plain_text",
            "title": "Kind",
            "type": "string"
          }
        },
        "title": "PlainText",
        "type": "object"
      },
      "ProviderRequirement": {
        "additionalProperties": false,
        "description": "One versioned action interface and literal JSON initial state.",
        "properties": {
          "action_interface": {
            "minLength": 1,
            "title": "Action Interface",
            "type": "string"
          },
          "initial_state": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        "required": [
          "action_interface",
          "initial_state"
        ],
        "title": "ProviderRequirement",
        "type": "object"
      },
      "ReasoningMarkupPolicy": {
