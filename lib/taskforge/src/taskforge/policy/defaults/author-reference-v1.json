      "ScriptGrader": {
        "additionalProperties": false,
        "description": "A command run in a fresh machine built from ``environment``; ``reward`` says how it scores.\n\nBefore ``argv`` runs in ``cwd``, ``collect`` commands run on the agent's machine, ``artifacts``\nare copied from it, verifier resources are installed under ``/tests``, the extracted answer is\nwritten to ``answer_path`` (``None`` when the agent's files are the result), and the\nconversation is written to ``conversation_path`` as JSON chat messages.\n\n``judge`` declares a required service contract, staged as ``/tests/judge.toml``. The runtime\nsupplies endpoint credentials only to the grading machine. ``empty_output`` permits scripts\nto grade blank plain-text submissions when the source requires per-item metrics for them.",
        "properties": {
          "answer_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "/app/answer.txt",
            "title": "Answer Path"
          },
          "argv": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Argv",
            "type": "array"
          },
          "artifacts": {
            "default": [],
            "items": {
              "$ref": "#/$defs/VerifierArtifact"
            },
            "title": "Artifacts",
            "type": "array"
          },
          "collect": {
            "default": [],
            "items": {
              "$ref": "#/$defs/VerifierCommand"
            },
            "title": "Collect",
            "type": "array"
          },
          "conversation_path": {
            "default": "/tests/conversation.json",
            "title": "Conversation Path",
            "type": "string"
          },
          "cwd": {
            "default": "/app",
            "title": "Cwd",
            "type": "string"
          },
          "empty_output": {
            "$ref": "#/$defs/EmptyOutputPolicy",
            "default": "zero"
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Env",
            "type": "object"
          },
          "environment": {
            "$ref": "#/$defs/EnvironmentRequirements"
          },
          "judge": {
            "anyOf": [
              {
                "$ref": "#/$defs/JudgeSpec"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "kind": {
            "const": "script",
            "default": "script",
            "title": "Kind",
            "type": "string"
          },
          "reward": {
            "default": {
              "kind": "stdout"
            },
            "discriminator": {
              "mapping": {
                "exit_code": "#/$defs/ExitCodeReward",
                "file": "#/$defs/FileReward",
                "stdout": "#/$defs/StdoutReward"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/StdoutReward"
              },
              {
                "$ref": "#/$defs/ExitCodeReward"
              },
              {
                "$ref": "#/$defs/FileReward"
              }
            ],
            "title": "Reward"
          },
          "timeout": {
            "default": 600.0,
            "exclusiveMinimum": 0,
            "title": "Timeout",
            "type": "number"
          }
        },
        "required": [
          "argv",
          "environment"
        ],
        "title": "ScriptGrader",
        "type": "object"
      },
