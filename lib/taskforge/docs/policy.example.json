{
  "run_id": "capability-run-001",
  "root": "taskforge_run",
  "host": "iris",
  "glm": {
    "kind": "relay",
    "relay_job": "/muchanem/glm53-relay-rno2a",
    "token_env": "GLM_API_TOKEN",
    "pool": "bulk"
  },
  "web": {
    "kind": "key_env",
    "env": "PARALLEL_KEY"
  },
  "policy": {
    "proposals_per_idea": 10,
    "max_idea_reproposals": 1,
    "max_triage_repairs": 1,
    "max_build_revisions": 3,
    "max_repairs": 2,
    "max_validation_retries": 2,
    "retry_backoff": {"initial": 60.0, "maximum": 900.0, "factor": 2.0, "jitter": 0.1},
    "output_token_budget": 1000000,
    "validation": {
      "k": 8,
      "adversary_k": 2,
      "roles": ["shortcut", "leak", "ambiguity"],
      "band": {"min_solve_rate": 0.125, "max_solve_rate": 0.875},
      "sampling": {
        "max_tokens": 131072,
        "reasoning_effort": "high",
        "temperature": 0.7,
        "stall_timeout": 600.0,
        "max_continuations": 0
      },
      "deadlines": {"agent_timeout": 1800.0, "attempt_timeout": 2400.0},
      "max_retries": 2,
      "token_contract_retries": 2,
      "retry_backoff": {"initial": 5.0, "maximum": 60.0, "factor": 2.0, "jitter": 0.1}
    }
  },
  "engine": {
    "max_turns": 40,
    "command_timeout": 120.0,
    "cleanup_timeout": 120.0,
    "conventions": [
      {"type": "PlainText", "convention": {"id": "plain_text"}},
      {"type": "JsonAnswer", "convention": {"id": "json_answer"}},
      {"type": "JsonValueAnswer", "convention": {"id": "json_value_answer"}}
    ]
  },
  "width": 256,
  "restore_from": null
}
