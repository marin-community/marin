+class StartedTask:
+    def __init__(self, states):
+        self.states = list(states)
+        self.task_id = SimpleNamespace(to_wire=lambda: "/user/shellbox/0")
+
+    def status(self):
+        state = self.states.pop(0) if len(self.states) > 1 else self.states[0]
+        return SimpleNamespace(state=state, error_message="container exited")
+
+
+class SubmittingClient(LocalClient):
+    def __init__(self, task):
+        self.task = task
+        self.job = LocalJob()
+        self.submitted = {}
+
+    def submit(self, **kwargs):
+        self.submitted = kwargs
+        self.job.tasks = lambda: [self.task]
+        return self.job
+
+
+def factory_with(monkeypatch, states):
+    client = SubmittingClient(StartedTask(states))
+    monkeypatch.setattr(
+        iris_backend,
+        "connect_controller",
+        lambda **_: SimpleNamespace(url="http://c", credentials=None, close=lambda: None),
+    )
+    monkeypatch.setattr(iris_backend.IrisClient, "remote", lambda *_, **__: client)
+    monkeypatch.setattr(iris_backend, "ControllerServiceClientSync", lambda **_: LocalRpc())
+    monkeypatch.setattr(iris_backend.time, "sleep", lambda _: None)
+    return iris_backend.IrisMachineFactory(controller_url="http://c", network=NetworkPolicy.DENY), client
+
