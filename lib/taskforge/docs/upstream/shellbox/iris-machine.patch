+LINUX_MAX_ARG_STRLEN = 128 * 1024
+
+
+class ArgumentLimitedRpc(LocalRpc):
+    """Reject an exec whose single argument exceeds Linux's MAX_ARG_STRLEN, as docker exec does."""
+
+    def exec_in_container(self, request, timeout_ms):
+        if max(len(argument.encode()) for argument in request.command) > LINUX_MAX_ARG_STRLEN:
+            return SimpleNamespace(exit_code=None, stdout="", stderr="", error="[Errno 7] Argument list too long")
+        return super().exec_in_container(request, timeout_ms)
+
+
+def test_upload_and_download_of_a_file_larger_than_one_exec_argument(tmp_path: Path) -> None:
+    async def scenario() -> None:
+        spec = MachineSpec(source=RegistryImage("ubuntu:24.04"), workdir=str(tmp_path), network=NetworkPolicy.DENY)
+        machine = IrisMachine(LocalEndpoint(), LocalClient(), ArgumentLimitedRpc(), LocalJob(), "task", spec)  # type: ignore[arg-type]
+        payload = bytes(range(256)) * 2048
+        source = tmp_path / "large.bin"
+        source.write_bytes(payload)
+        await machine.upload(source, str(tmp_path / "remote.bin"))
+        await machine.download(str(tmp_path / "remote.bin"), tmp_path / "back.bin")
+        assert (tmp_path / "back.bin").read_bytes() == payload
+        await machine.close()

     asyncio.run(scenario())
