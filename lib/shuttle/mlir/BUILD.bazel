load("@llvm-project//mlir:tblgen.bzl", "gentbl_cc_library", "td_library")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@xla//xla:lit.bzl", "lit_test_suite")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

td_library(
    name = "shuttle_td_files",
    srcs = glob(["include/shuttle/**/*.td"]),
    includes = ["include"],
    deps = [
        "@llvm-project//mlir:OpBaseTdFiles",
        "@llvm-project//mlir:PassBaseTdFiles",
        "@llvm-project//mlir:SideEffectInterfacesTdFiles",
    ],
)

gentbl_cc_library(
    name = "shuttle_dialect_inc_gen",
    strip_include_prefix = "include",
    tbl_outs = {
        "include/shuttle/IR/ShuttleDialect.cc.inc": ["-gen-dialect-defs"],
        "include/shuttle/IR/ShuttleDialect.h.inc": ["-gen-dialect-decls"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/shuttle/IR/ShuttleDialect.td",
    deps = [":shuttle_td_files"],
)

gentbl_cc_library(
    name = "shuttle_attrs_inc_gen",
    strip_include_prefix = "include",
    tbl_outs = {
        "include/shuttle/IR/ShuttleAttrs.cc.inc": ["-gen-attrdef-defs"],
        "include/shuttle/IR/ShuttleAttrs.h.inc": ["-gen-attrdef-decls"],
        "include/shuttle/IR/ShuttleEnums.cc.inc": ["-gen-enum-defs"],
        "include/shuttle/IR/ShuttleEnums.h.inc": ["-gen-enum-decls"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/shuttle/IR/ShuttleAttrs.td",
    deps = [":shuttle_td_files"],
)

gentbl_cc_library(
    name = "shuttle_ops_inc_gen",
    strip_include_prefix = "include",
    tbl_outs = {
        "include/shuttle/IR/ShuttleOps.cc.inc": ["-gen-op-defs"],
        "include/shuttle/IR/ShuttleOps.h.inc": ["-gen-op-decls"],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/shuttle/IR/ShuttleOps.td",
    deps = [":shuttle_td_files"],
)

gentbl_cc_library(
    name = "shuttle_passes_inc_gen",
    strip_include_prefix = "include",
    tbl_outs = {"include/shuttle/Transforms/Passes.h.inc": [
        "-gen-pass-decls",
        "-name=Shuttle",
    ]},
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/shuttle/Transforms/Passes.td",
    deps = [":shuttle_td_files"],
)

cc_library(
    name = "ShuttleDialect",
    srcs = ["lib/IR/ShuttleDialect.cc"],
    hdrs = glob(["include/shuttle/IR/*.h"]),
    strip_include_prefix = "include",
    deps = [
        ":shuttle_attrs_inc_gen",
        ":shuttle_dialect_inc_gen",
        ":shuttle_ops_inc_gen",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:BytecodeOpInterface",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:SideEffectInterfaces",
        "@llvm-project//mlir:Support",
    ],
)

cc_library(
    name = "ShuttlePasses",
    srcs = [
        "lib/Transforms/Observer.cc",
        "lib/Transforms/ObserverInternal.h",
        "lib/Transforms/ObserverTestInternal.h",
        "lib/Transforms/Passes.cc",
    ],
    hdrs = [
        "include/shuttle/Transforms/Observer.h",
        "include/shuttle/Transforms/Passes.h",
    ],
    strip_include_prefix = "include",
    deps = [
        ":ShuttleDialect",
        ":shuttle_passes_inc_gen",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:AffineDialect",
        "@llvm-project//mlir:ArithDialect",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:MathDialect",
        "@llvm-project//mlir:Pass",
        "@llvm-project//mlir:Support",
        "@stablehlo//:stablehlo_ops",
    ],
)

cc_library(
    name = "ShuttleTestPasses",
    testonly = True,
    srcs = ["test/TestPasses.cc"],
    hdrs = ["test/TestPasses.h"],
    deps = [
        ":ShuttleDialect",
        ":ShuttlePasses",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:Pass",
        "@stablehlo//:stablehlo_ops",
    ],
)

cc_library(
    name = "ShuttleXlaRegistration",
    srcs = ["lib/Transforms/XlaRegistration.cc"],
    hdrs = ["include/shuttle/Transforms/XlaRegistration.h"],
    strip_include_prefix = "include",
    deps = [
        ":ShuttlePasses",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:Pass",
        "@llvm-project//mlir:Support",
    ],
)

# Link this target into the final CPU jaxlib module. Keeping static
# registration in a separate alwayslink library preserves XLA's generic hook.
cc_library(
    name = "ShuttleXlaRegistryAdapter",
    srcs = ["lib/Transforms/XlaRegistryRegistration.cc"],
    alwayslink = True,
    deps = [
        ":ShuttleXlaRegistration",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/strings",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
        "@xla//xla/pjrt:stablehlo_module_transform",
    ],
)

cc_binary(
    name = "shuttle-opt",
    srcs = ["tools/shuttle-opt.cc"],
    deps = [
        ":ShuttleDialect",
        ":ShuttlePasses",
        "@llvm-project//mlir:ArithDialect",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:MathDialect",
        "@llvm-project//mlir:MlirOptLib",
        "@llvm-project//mlir:SCFDialect",
        "@llvm-project//mlir:TensorDialect",
        "@stablehlo//:register",
    ],
)

cc_binary(
    name = "shuttle-test-opt",
    testonly = True,
    srcs = ["tools/shuttle-test-opt.cc"],
    deps = [
        ":ShuttleDialect",
        ":ShuttlePasses",
        ":ShuttleTestPasses",
        "@llvm-project//mlir:ArithDialect",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:MathDialect",
        "@llvm-project//mlir:MlirOptLib",
        "@llvm-project//mlir:SCFDialect",
        "@llvm-project//mlir:TensorDialect",
        "@stablehlo//:register",
    ],
)

cc_test(
    name = "pipeline_observer_test",
    srcs = [
        "lib/Transforms/ObserverTestInternal.h",
        "test/pipeline-observer-test.cc",
    ],
    deps = [
        ":ShuttleDialect",
        ":ShuttlePasses",
        ":ShuttleXlaRegistration",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:ArithDialect",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:Parser",
        "@llvm-project//mlir:Pass",
        "@llvm-project//mlir:SCFDialect",
        "@stablehlo//:register",
    ],
)

cc_test(
    name = "xla_registration_test",
    srcs = ["test/xla-registration-test.cc"],
    deps = [
        ":ShuttleXlaRegistration",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_googletest//:gtest_main",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:Parser",
        "@stablehlo//:register",
    ],
)

cc_test(
    name = "xla_registry_adapter_test",
    srcs = ["test/xla-registry-adapter-test.cc"],
    deps = [
        ":ShuttlePasses",
        ":ShuttleXlaRegistryAdapter",
        "@com_google_absl//absl/status",
        "@com_google_googletest//:gtest_main",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:ArithDialect",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:Parser",
        "@llvm-project//mlir:SCFDialect",
        "@stablehlo//:register",
        "@xla//xla/pjrt:stablehlo_module_transform",
    ],
)

lit_test_suite(
    name = "mlir_tests",
    srcs = glob(
        ["test/**/*.mlir"],
        exclude = ["test/Inputs/**"],
    ),
    cfg = "test/lit.cfg.py",
    data = glob(["test/Inputs/*.mlir"]),
    tools = [
        ":shuttle-opt",
        ":shuttle-test-opt",
        "@llvm-project//llvm:FileCheck",
        "@llvm-project//llvm:not",
    ],
)
