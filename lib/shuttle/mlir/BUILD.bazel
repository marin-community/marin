# Link this target into the final CPU jaxlib module. Keeping static
# registration in a separate alwayslink library preserves XLA's generic hook.
cc_library(
    name = "ShuttleXlaRegistryAdapter",
    srcs = ["lib/Transforms/XlaRegistryRegistration.cc"],
    alwayslink = True,
    deps = [
        ":ShuttleCpuBytecode",
        ":ShuttleXlaRegistration",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/strings",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
        "@xla//xla/ffi",
        "@xla//xla/pjrt:stablehlo_module_transform",
    ],
)

# This bridge is linked only into the dedicated validation jaxlib selected by
# the pinned JAX patch's SHUTTLE_TEST_OBSERVER build define. It is not part of
# Shuttle options or the compilation cache identity.
cc_library(
    name = "ShuttleObserverTestBridge",
    srcs = ["lib/Transforms/ObserverTestBridge.cc"],
    hdrs = ["include/shuttle/Testing/ObserverTestBridge.h"],
    strip_include_prefix = "include",
    visibility = ["//:__pkg__"],
    deps = [":ShuttlePasses"],
)

