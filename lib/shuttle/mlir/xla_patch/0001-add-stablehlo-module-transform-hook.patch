+#include "xla/pjrt/stablehlo_module_transform.h"
+
+#include <string>
+#include <utility>
+
+#include "absl/base/no_destructor.h"
+#include "absl/status/status.h"
+#include "absl/strings/str_cat.h"
+#include "absl/strings/string_view.h"
+#include "absl/synchronization/mutex.h"
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/IR/OwningOpRef.h"
+#include "mlir/IR/Verifier.h"
+
+namespace xla {
+
+StablehloModuleTransformRegistry& StablehloModuleTransformRegistry::Global() {
+  static absl::NoDestructor<StablehloModuleTransformRegistry> global_registry;
+  return *global_registry;
+}
+
+absl::Status StablehloModuleTransformRegistry::Register(
+    absl::string_view name, StablehloModuleTransform transform) {
+  if (name.empty()) {
+    return absl::InvalidArgumentError("Transform name cannot be empty");
+  }
+  if (!transform) {
+    return absl::InvalidArgumentError("Transform cannot be empty");
+  }
+
+  absl::MutexLock lock(&mutex_);
+  if (sealed_) {
+    return absl::FailedPreconditionError(
+        "StableHLO module transform registry is already sealed");
+  }
+  for (const Entry& entry : entries_) {
+    if (entry.name == name) {
+      return absl::AlreadyExistsError(absl::StrCat(
+          "StableHLO module transform already registered: ", name));
+    }
+  }
+  entries_.push_back(Entry{std::string(name), std::move(transform)});
+  return absl::OkStatus();
+}
+
+absl::Status StablehloModuleTransformRegistry::Run(
+    mlir::ModuleOp module, absl::string_view serialized_options,
+    absl::string_view required_transform) const {
+  StablehloModuleTransform transform;
+  {
+    absl::MutexLock lock(&mutex_);
+    sealed_ = true;
+    for (const Entry& entry : entries_) {
+      if (entry.name == required_transform) {
+        transform = entry.transform;
+        break;
+      }
+    }
+    if (!transform && entries_.empty()) {
+      return absl::FailedPreconditionError(
+          "StableHLO module transforms were enabled, but none are registered");
+    }
+  }
+  if (!transform) {
+    return absl::FailedPreconditionError(
+        absl::StrCat("Required StableHLO module transform is not registered: ",
+                     required_transform));
+  }
+
+  mlir::OwningOpRef<mlir::ModuleOp> transformed(module.clone());
+  absl::Status status = transform(*transformed, serialized_options);
+  if (!status.ok()) {
+    return absl::Status(
+        status.code(),
+        absl::StrCat("StableHLO module transform '", required_transform,
+                     "' failed: ", status.message()));
+  }
+  if (mlir::failed(mlir::verify(*transformed))) {
+    return absl::InvalidArgumentError(
+        "StableHLO module transforms produced an invalid MLIR module");
+  }
+
+  mlir::Operation* module_operation = module.getOperation();
+  mlir::Operation* transformed_operation = transformed->getOperation();
+  module_operation->copyProperties(
+      transformed_operation->getPropertiesStorage());
+  module_operation->setAttrs(transformed_operation->getAttrDictionary());
+  module_operation->setLoc(transformed_operation->getLoc());
+  module.getBodyRegion().takeBody(transformed->getBodyRegion());
+  return absl::OkStatus();
+}
+
+}  // namespace xla
