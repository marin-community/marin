+#include "mlir/IR/BuiltinOps.h"
+
+namespace xla {
+
+using StablehloModuleTransform =
+    std::function<absl::Status(mlir::ModuleOp, absl::string_view)>;
+
+// Stores StableHLO transforms supplied by components linked into XLA. Run()
+// applies the selected transform to a clone and updates the input module only
+// after the transform and MLIR verification succeed.
+class StablehloModuleTransformRegistry {
+ public:
+  StablehloModuleTransformRegistry() = default;
+  ~StablehloModuleTransformRegistry() = default;
+
+  StablehloModuleTransformRegistry(const StablehloModuleTransformRegistry&) =
+      delete;
+  StablehloModuleTransformRegistry& operator=(
+      const StablehloModuleTransformRegistry&) = delete;
+
+  static StablehloModuleTransformRegistry& Global();
+
+  // Registers a transform under a stable diagnostic name. The registry is
+  // sealed atomically on the first Run(), and later registrations fail.
+  absl::Status Register(absl::string_view name,
+                        StablehloModuleTransform transform);
+
+  // Runs required_transform transactionally. Other registered transforms are
+  // not invoked. Returns an error without changing module when the required
+  // transform is absent, fails, or produces a module that does not verify.
+  absl::Status Run(mlir::ModuleOp module, absl::string_view serialized_options,
+                   absl::string_view required_transform) const;
+
+ private:
+  struct Entry {
+    std::string name;
+    StablehloModuleTransform transform;
+  };
+
+  mutable absl::Mutex mutex_;
+  mutable bool sealed_ ABSL_GUARDED_BY(mutex_) = false;
+  std::vector<Entry> entries_ ABSL_GUARDED_BY(mutex_);
+};
+
+}  // namespace xla
+
+#endif  // XLA_PJRT_STABLEHLO_MODULE_TRANSFORM_H_
