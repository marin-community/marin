diff --git a/xla/pjrt/stablehlo_module_transform.cc b/xla/pjrt/stablehlo_module_transform.cc
new file mode 100644
index 0000000..92143b0
--- /dev/null
+++ b/xla/pjrt/stablehlo_module_transform.cc
@@ -0,0 +1,90 @@
+/* Copyright 2026 The OpenXLA Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+==============================================================================*/
+
+#include "xla/pjrt/stablehlo_module_transform.h"
+
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "absl/base/no_destructor.h"
+#include "absl/status/status.h"
+#include "absl/strings/str_cat.h"
+#include "absl/strings/string_view.h"
+#include "absl/synchronization/mutex.h"
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/IR/OwningOpRef.h"
+#include "mlir/IR/Verifier.h"
+
+namespace xla {
+
+StablehloModuleTransformRegistry& StablehloModuleTransformRegistry::Global() {
+  static absl::NoDestructor<StablehloModuleTransformRegistry> global_registry;
+  return *global_registry;
+}
+
+absl::Status StablehloModuleTransformRegistry::Register(
+    absl::string_view name, StablehloModuleTransform transform) {
+  if (name.empty()) {
+    return absl::InvalidArgumentError("Transform name cannot be empty");
+  }
+  if (!transform) {
+    return absl::InvalidArgumentError("Transform cannot be empty");
+  }
+
+  absl::MutexLock lock(&mutex_);
+  for (const Entry& entry : entries_) {
+    if (entry.name == name) {
+      return absl::AlreadyExistsError(absl::StrCat(
+          "StableHLO module transform already registered: ", name));
+    }
+  }
+  entries_.push_back(Entry{std::string(name), std::move(transform)});
+  return absl::OkStatus();
+}
+
+absl::Status StablehloModuleTransformRegistry::Run(
+    mlir::ModuleOp module, absl::string_view serialized_options) const {
+  std::vector<Entry> entries;
+  {
+    absl::MutexLock lock(&mutex_);
+    entries = entries_;
+  }
+  if (entries.empty()) {
+    return absl::FailedPreconditionError(
+        "StableHLO module transforms were enabled, but none are registered");
+  }
+
+  mlir::OwningOpRef<mlir::ModuleOp> transformed(module.clone());
+  for (const Entry& entry : entries) {
+    absl::Status status = entry.transform(*transformed, serialized_options);
+    if (!status.ok()) {
+      return absl::Status(
+          status.code(),
+          absl::StrCat("StableHLO module transform '", entry.name,
+                       "' failed: ", status.message()));
+    }
+  }
+  if (mlir::failed(mlir::verify(*transformed))) {
+    return absl::InvalidArgumentError(
+        "StableHLO module transforms produced an invalid MLIR module");
+  }
+
+  module->setAttrs(transformed->getAttrs());
+  module.getBodyRegion().takeBody(transformed->getBodyRegion());
+  return absl::OkStatus();
+}
+
+}  // namespace xla
diff --git a/xla/pjrt/stablehlo_module_transform.h b/xla/pjrt/stablehlo_module_transform.h
new file mode 100644
index 0000000..6af67d9
--- /dev/null
+++ b/xla/pjrt/stablehlo_module_transform.h
@@ -0,0 +1,72 @@
+/* Copyright 2026 The OpenXLA Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+==============================================================================*/
+
+#ifndef XLA_PJRT_STABLEHLO_MODULE_TRANSFORM_H_
+#define XLA_PJRT_STABLEHLO_MODULE_TRANSFORM_H_
+
+#include <functional>
+#include <string>
+#include <vector>
+
+#include "absl/base/thread_annotations.h"
+#include "absl/status/status.h"
+#include "absl/strings/string_view.h"
+#include "absl/synchronization/mutex.h"
+#include "mlir/IR/BuiltinOps.h"
+
+namespace xla {
+
+using StablehloModuleTransform =
+    std::function<absl::Status(mlir::ModuleOp, absl::string_view)>;
+
+// Stores StableHLO transforms supplied by components linked into XLA. Run()
+// applies a snapshot of the registered transforms to a clone and updates the
+// input module only after every transform and MLIR verification succeed.
+class StablehloModuleTransformRegistry {
+ public:
+  StablehloModuleTransformRegistry() = default;
+  ~StablehloModuleTransformRegistry() = default;
+
+  StablehloModuleTransformRegistry(const StablehloModuleTransformRegistry&) =
+      delete;
+  StablehloModuleTransformRegistry& operator=(
+      const StablehloModuleTransformRegistry&) = delete;
+
+  static StablehloModuleTransformRegistry& Global();
+
+  // Registers a transform under a stable diagnostic name. Transforms run in
+  // registration order.
+  absl::Status Register(absl::string_view name,
+                        StablehloModuleTransform transform);
+
+  // Runs all registered transforms transactionally. Returns an error without
+  // changing module when there is no transform, a transform fails, or the
+  // transformed module does not verify.
+  absl::Status Run(mlir::ModuleOp module,
+                   absl::string_view serialized_options) const;
+
+ private:
+  struct Entry {
+    std::string name;
+    StablehloModuleTransform transform;
+  };
+
+  mutable absl::Mutex mutex_;
+  std::vector<Entry> entries_ ABSL_GUARDED_BY(mutex_);
+};
+
+}  // namespace xla
+
+#endif  // XLA_PJRT_STABLEHLO_MODULE_TRANSFORM_H_
diff --git a/xla/pjrt/stablehlo_module_transform_test.cc b/xla/pjrt/stablehlo_module_transform_test.cc
new file mode 100644
index 0000000..5fbd6a9
--- /dev/null
+++ b/xla/pjrt/stablehlo_module_transform_test.cc
@@ -0,0 +1,128 @@
+/* Copyright 2026 The OpenXLA Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+==============================================================================*/
+
+#include "xla/pjrt/stablehlo_module_transform.h"
+
+#include <gmock/gmock.h>
+#include <gtest/gtest.h>
+#include "absl/status/status.h"
+#include "absl/status/status_matchers.h"
+#include "absl/strings/string_view.h"
+#include "mlir/IR/BuiltinAttributes.h"
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/IR/MLIRContext.h"
+#include "mlir/IR/OwningOpRef.h"
+#include "mlir/IR/Verifier.h"
+#include "xla/hlo/testlib/test.h"
+#include "xla/pjrt/mlir_to_hlo.h"
+#include "xla/tsl/platform/statusor.h"
+
+namespace xla {
+namespace {
+
+using ::absl_testing::StatusIs;
+using ::testing::HasSubstr;
+
+constexpr absl::string_view kProgram = R"(
+  func.func @main(%arg0: tensor<f32>) -> tensor<f32> {
+    %0 = stablehlo.negate %arg0 : tensor<f32>
+    return %0 : tensor<f32>
+  }
+)";
+
+TEST(StablehloModuleTransformRegistryTest, CommitsSuccessfulTransform) {
+  mlir::MLIRContext context;
+  TF_ASSERT_OK_AND_ASSIGN(mlir::OwningOpRef<mlir::ModuleOp> module,
+                          ParseMlirModuleString(kProgram, context));
+  StablehloModuleTransformRegistry registry;
+  TF_ASSERT_OK(registry.Register(
+      "marker", [](mlir::ModuleOp module, absl::string_view options) {
+        module->setAttr("test.marker",
+                        mlir::StringAttr::get(module.getContext(), options));
+        return absl::OkStatus();
+      }));
+
+  TF_EXPECT_OK(registry.Run(*module, "source_ordered"));
+
+  auto marker = module->getAttrOfType<mlir::StringAttr>("test.marker");
+  ASSERT_TRUE(marker);
+  EXPECT_EQ(marker.getValue(), "source_ordered");
+}
+
+TEST(StablehloModuleTransformRegistryTest, FailsClosedWithoutRegistration) {
+  mlir::MLIRContext context;
+  TF_ASSERT_OK_AND_ASSIGN(mlir::OwningOpRef<mlir::ModuleOp> module,
+                          ParseMlirModuleString(kProgram, context));
+  StablehloModuleTransformRegistry registry;
+
+  EXPECT_THAT(registry.Run(*module, "fast"),
+              StatusIs(absl::StatusCode::kFailedPrecondition,
+                       HasSubstr("none are registered")));
+}
+
+TEST(StablehloModuleTransformRegistryTest, RejectsAmbiguousRegistration) {
+  StablehloModuleTransformRegistry registry;
+  StablehloModuleTransform transform = [](mlir::ModuleOp, absl::string_view) {
+    return absl::OkStatus();
+  };
+
+  EXPECT_THAT(registry.Register("", transform),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+  EXPECT_THAT(registry.Register("empty", StablehloModuleTransform()),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+  TF_ASSERT_OK(registry.Register("duplicate", transform));
+  EXPECT_THAT(registry.Register("duplicate", transform),
+              StatusIs(absl::StatusCode::kAlreadyExists));
+}
+
+TEST(StablehloModuleTransformRegistryTest, PreservesModuleAfterFailure) {
+  mlir::MLIRContext context;
+  TF_ASSERT_OK_AND_ASSIGN(mlir::OwningOpRef<mlir::ModuleOp> module,
+                          ParseMlirModuleString(kProgram, context));
+  StablehloModuleTransformRegistry registry;
+  TF_ASSERT_OK(registry.Register(
+      "failing", [](mlir::ModuleOp module, absl::string_view) {
+        module->setAttr("test.marker",
+                        mlir::StringAttr::get(module.getContext(), "changed"));
+        return absl::InternalError("transform rejected the module");
+      }));
+
+  EXPECT_THAT(
+      registry.Run(*module, "fast"),
+      StatusIs(absl::StatusCode::kInternal, HasSubstr("failing' failed")));
+  EXPECT_FALSE(module->hasAttr("test.marker"));
+}
+
+TEST(StablehloModuleTransformRegistryTest,
+     RejectsInvalidResultTransactionally) {
+  mlir::MLIRContext context;
+  TF_ASSERT_OK_AND_ASSIGN(mlir::OwningOpRef<mlir::ModuleOp> module,
+                          ParseMlirModuleString(kProgram, context));
+  StablehloModuleTransformRegistry registry;
+  TF_ASSERT_OK(registry.Register(
+      "invalid", [](mlir::ModuleOp module, absl::string_view) {
+        mlir::Operation& function = module.getBody()->front();
+        function.getRegion(0).front().getTerminator()->erase();
+        return absl::OkStatus();
+      }));
+
+  EXPECT_THAT(registry.Run(*module, "fast"),
+              StatusIs(absl::StatusCode::kInvalidArgument,
+                       HasSubstr("invalid MLIR module")));
+  EXPECT_TRUE(mlir::succeeded(mlir::verify(*module)));
+}
+
+}  // namespace
+}  // namespace xla
