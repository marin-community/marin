+#include "xla/pjrt/stablehlo_module_transform.h"
+
+#include <string>
+#include <thread>
+#include <utility>
+
+#include <gmock/gmock.h>
+#include <gtest/gtest.h>
+#include "absl/status/status.h"
+#include "absl/status/status_matchers.h"
+#include "absl/strings/string_view.h"
+#include "absl/synchronization/notification.h"
+#include "mlir/IR/BuiltinAttributes.h"
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/IR/MLIRContext.h"
+#include "mlir/IR/OwningOpRef.h"
+#include "mlir/IR/Verifier.h"
+#include "xla/hlo/testlib/test.h"
+#include "xla/pjrt/mlir_to_hlo.h"
+#include "xla/tsl/lib/core/status_test_util.h"
+#include "xla/tsl/platform/statusor.h"
+
+namespace xla {
+namespace {
+
+using ::absl_testing::StatusIs;
+using ::testing::HasSubstr;
+
+constexpr absl::string_view kProgram = R"(
+  func.func @main(%arg0: tensor<f32>) -> tensor<f32> {
+    %0 = stablehlo.negate %arg0 : tensor<f32>
+    return %0 : tensor<f32>
+  }
+)";
+
+StablehloModuleTransform AppendExecutionOrder(std::string name) {
+  return [name = std::move(name)](mlir::ModuleOp module, absl::string_view) {
+    auto current = module->getAttrOfType<mlir::StringAttr>("test.order");
+    std::string order = current ? std::string(current.getValue()) : "";
+    if (!order.empty()) {
+      order.append(",");
+    }
+    order.append(name);
+    module->setAttr("test.order",
+                    mlir::StringAttr::get(module.getContext(), order));
+    return absl::OkStatus();
+  };
+}
+
+TEST(StablehloModuleTransformRegistryTest, CommitsSuccessfulTransform) {
+  mlir::MLIRContext context;
+  TF_ASSERT_OK_AND_ASSIGN(mlir::OwningOpRef<mlir::ModuleOp> module,
+                          ParseMlirModuleString(kProgram, context));
+  module->getOperation()->setAttr(
+      "sym_name", mlir::StringAttr::get(&context, "before_transform"));
+  mlir::Location transformed_location =
+      mlir::NameLoc::get(mlir::StringAttr::get(&context, "transformed_module"));
+  StablehloModuleTransformRegistry registry;
+  TF_ASSERT_OK(registry.Register(
+      "shuttle",
+      [transformed_location](mlir::ModuleOp module, absl::string_view options) {
+        module->removeAttr("sym_name");
+        module->setLoc(transformed_location);
+        mlir::Operation& function = module.getBody()->front();
+        mlir::Operation& operation = function.getRegion(0).front().front();
+        operation.setAttr("test.marker",
+                          mlir::StringAttr::get(module.getContext(), options));
+        return absl::OkStatus();
+      }));
+
+  TF_EXPECT_OK(registry.Run(*module, "source_ordered", "shuttle"));
+
+  mlir::Operation& function = module->getBody()->front();
+  mlir::Operation& operation = function.getRegion(0).front().front();
+  auto marker = operation.getAttrOfType<mlir::StringAttr>("test.marker");
+  ASSERT_TRUE(marker);
+  EXPECT_EQ(marker.getValue(), "source_ordered");
+  EXPECT_FALSE(module->getOperation()->hasAttr("sym_name"));
+  EXPECT_EQ(module->getOperation()->getLoc(), transformed_location);
+}
+
+TEST(StablehloModuleTransformRegistryTest, FailsClosedWithoutRegistration) {
+  mlir::MLIRContext context;
+  TF_ASSERT_OK_AND_ASSIGN(mlir::OwningOpRef<mlir::ModuleOp> module,
+                          ParseMlirModuleString(kProgram, context));
+  StablehloModuleTransformRegistry registry;
+
+  EXPECT_THAT(registry.Run(*module, "fast", "shuttle"),
+              StatusIs(absl::StatusCode::kFailedPrecondition,
+                       HasSubstr("none are registered")));
+}
+
+TEST(StablehloModuleTransformRegistryTest,
+     UnrelatedTransformDoesNotSatisfyRequiredPipeline) {
+  mlir::MLIRContext context;
+  TF_ASSERT_OK_AND_ASSIGN(mlir::OwningOpRef<mlir::ModuleOp> module,
+                          ParseMlirModuleString(kProgram, context));
+  StablehloModuleTransformRegistry registry;
+  TF_ASSERT_OK(
+      registry.Register("unrelated", AppendExecutionOrder("unrelated")));
+
+  EXPECT_THAT(registry.Run(*module, "fast", "shuttle"),
+              StatusIs(absl::StatusCode::kFailedPrecondition,
+                       HasSubstr("not registered: shuttle")));
+  EXPECT_FALSE(module->getOperation()->hasAttr("test.order"));
+}
+
+TEST(StablehloModuleTransformRegistryTest,
+     UnrelatedTransformIsNotRunAlongsideRequiredPipeline) {
+  mlir::MLIRContext context;
+  TF_ASSERT_OK_AND_ASSIGN(mlir::OwningOpRef<mlir::ModuleOp> module,
+                          ParseMlirModuleString(kProgram, context));
+  StablehloModuleTransformRegistry registry;
+  TF_ASSERT_OK(
+      registry.Register("unrelated", AppendExecutionOrder("unrelated")));
+  TF_ASSERT_OK(registry.Register("shuttle", AppendExecutionOrder("shuttle")));
+
+  TF_EXPECT_OK(registry.Run(*module, "fast", "shuttle"));
+
+  auto order =
+      module->getOperation()->getAttrOfType<mlir::StringAttr>("test.order");
+  ASSERT_TRUE(order);
+  EXPECT_EQ(order.getValue(), "shuttle");
+}
+
+TEST(StablehloModuleTransformRegistryTest, RejectsAmbiguousRegistration) {
+  StablehloModuleTransformRegistry registry;
+  StablehloModuleTransform transform = [](mlir::ModuleOp, absl::string_view) {
+    return absl::OkStatus();
+  };
+
+  EXPECT_THAT(registry.Register("", transform),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+  EXPECT_THAT(registry.Register("empty", StablehloModuleTransform()),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+  TF_ASSERT_OK(registry.Register("duplicate", transform));
+  EXPECT_THAT(registry.Register("duplicate", transform),
+              StatusIs(absl::StatusCode::kAlreadyExists));
+}
+
+TEST(StablehloModuleTransformRegistryTest, RejectsRegistrationAfterRun) {
+  mlir::MLIRContext context;
+  TF_ASSERT_OK_AND_ASSIGN(mlir::OwningOpRef<mlir::ModuleOp> module,
+                          ParseMlirModuleString(kProgram, context));
+  StablehloModuleTransformRegistry registry;
+  TF_ASSERT_OK(registry.Register("shuttle", AppendExecutionOrder("base")));
+  TF_ASSERT_OK(registry.Run(*module, "fast", "shuttle"));
+
+  EXPECT_THAT(registry.Register("late", AppendExecutionOrder("late")),
+              StatusIs(absl::StatusCode::kFailedPrecondition,
+                       HasSubstr("already sealed")));
+}
+
+TEST(StablehloModuleTransformRegistryTest,
+     ConcurrentUnrelatedRegistrationCannotAffectRun) {
+  mlir::MLIRContext context;
+  TF_ASSERT_OK_AND_ASSIGN(mlir::OwningOpRef<mlir::ModuleOp> module,
+                          ParseMlirModuleString(kProgram, context));
+  StablehloModuleTransformRegistry registry;
+  TF_ASSERT_OK(registry.Register("shuttle", AppendExecutionOrder("base")));
+  absl::Notification start;
+  absl::Status run_status;
+  absl::Status register_status;
+  std::thread run_thread([&] {
+    start.WaitForNotification();
+    run_status = registry.Run(*module, "fast", "shuttle");
+  });
+  std::thread register_thread([&] {
+    start.WaitForNotification();
+    register_status = registry.Register("late", AppendExecutionOrder("late"));
+  });
+
+  start.Notify();
+  run_thread.join();
+  register_thread.join();
+
+  TF_EXPECT_OK(run_status);
+  auto order =
+      module->getOperation()->getAttrOfType<mlir::StringAttr>("test.order");
+  ASSERT_TRUE(order);
+  EXPECT_EQ(order.getValue(), "base");
+  if (!register_status.ok()) {
+    EXPECT_THAT(register_status,
+                StatusIs(absl::StatusCode::kFailedPrecondition));
+  }
+}
+
+TEST(StablehloModuleTransformRegistryTest, PreservesModuleAfterFailure) {
+  mlir::MLIRContext context;
+  TF_ASSERT_OK_AND_ASSIGN(mlir::OwningOpRef<mlir::ModuleOp> module,
+                          ParseMlirModuleString(kProgram, context));
+  StablehloModuleTransformRegistry registry;
+  TF_ASSERT_OK(registry.Register("shuttle", [](mlir::ModuleOp module,
+                                               absl::string_view) {
+    mlir::Operation& function = module.getBody()->front();
+    mlir::Operation& operation = function.getRegion(0).front().front();
+    operation.setAttr("test.marker", mlir::UnitAttr::get(module.getContext()));
+    return absl::InternalError("transform rejected the module");
+  }));
+
+  EXPECT_THAT(
+      registry.Run(*module, "fast", "shuttle"),
+      StatusIs(absl::StatusCode::kInternal, HasSubstr("shuttle' failed")));
+  mlir::Operation& function = module->getBody()->front();
+  mlir::Operation& operation = function.getRegion(0).front().front();
+  EXPECT_FALSE(operation.hasAttr("test.marker"));
+}
+
+TEST(StablehloModuleTransformRegistryTest,
+     RejectsInvalidResultTransactionally) {
+  mlir::MLIRContext context;
+  TF_ASSERT_OK_AND_ASSIGN(mlir::OwningOpRef<mlir::ModuleOp> module,
+                          ParseMlirModuleString(kProgram, context));
+  StablehloModuleTransformRegistry registry;
+  TF_ASSERT_OK(registry.Register(
+      "shuttle", [](mlir::ModuleOp module, absl::string_view) {
+        mlir::Operation& function = module.getBody()->front();
+        function.getRegion(0).front().getTerminator()->erase();
+        return absl::OkStatus();
+      }));
+
+  EXPECT_THAT(registry.Run(*module, "fast", "shuttle"),
+              StatusIs(absl::StatusCode::kInvalidArgument,
+                       HasSubstr("invalid MLIR module")));
+  EXPECT_TRUE(mlir::succeeded(mlir::verify(*module)));
+}
+
+}  // namespace
+}  // namespace xla
