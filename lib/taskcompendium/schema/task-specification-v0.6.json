{
  "$ref": "#/$defs/TaskSpecification",
  "$defs": {
    "TaskSpecification": {
      "title": "TaskSpecification",
      "description": "One fixed semantic instance, including private correctness criteria.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepSpecification"
          }
        },
        "requirements": {
          "$ref": "#/$defs/TaskRequirements"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resource"
          }
        },
        "metadata": {
          "$ref": "#/$defs/TaskMetadata"
        },
        "success_policy": {
          "$ref": "#/$defs/TaskSuccessPolicy",
          "default": "all_required_steps"
        },
        "schema_version": {
          "type": "string",
          "default": "0.6"
        }
      },
      "required": [
        "id",
        "steps",
        "requirements",
        "resources",
        "metadata"
      ],
      "additionalProperties": false
    },
    "StepSpecification": {
      "title": "StepSpecification",
      "type": "object",
      "properties": {
        "instructions": {
          "type": "string"
        },
        "verifier": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskTroveVerifier"
            },
            {
              "$ref": "#/$defs/PredictedActionVerifier"
            },
            {
              "$ref": "#/$defs/ConstraintVerifier"
            },
            {
              "$ref": "#/$defs/ProviderStateVerifier"
            },
            {
              "$ref": "#/$defs/CodeAnswerVerifier"
            }
          ],
          "discriminator": {
            "propertyName": "kind",
            "mapping": {
              "tasktrove": "#/$defs/TaskTroveVerifier",
              "predicted_action": "#/$defs/PredictedActionVerifier",
              "instruction_constraints": "#/$defs/ConstraintVerifier",
              "provider_state": "#/$defs/ProviderStateVerifier",
              "code_answer": "#/$defs/CodeAnswerVerifier"
            }
          }
        },
        "answer_requirements": {
          "$ref": "#/$defs/AnswerRequirements",
          "default": {
            "kind": "text"
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resource"
          },
          "default": []
        },
        "context_requirement": {
          "$ref": "#/$defs/ContextRequirement",
          "default": "instruction_and_workspace"
        }
      },
      "required": [
        "instructions",
        "verifier"
      ],
      "additionalProperties": false
    },
    "TaskTroveVerifier": {
      "title": "TaskTroveVerifier",
      "description": "Parameters use the pinned tasktrove-verify ontology, without submission paths.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "tasktrove"
          ]
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "parameters": {
          "type": "object"
        },
        "judge": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/JudgeConfig"
            }
          ],
          "default": null
        },
        "runtime": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ContainerRuntime"
            }
          ],
          "default": null
        },
        "implementation_revision": {
          "type": "string",
          "default": "b2b68d8b0a770cdc0ab3903780172c4b3eea81b1"
        }
      },
      "required": [
        "kind",
        "mode",
        "parameters"
      ],
      "additionalProperties": false
    },
    "Mode": {
      "title": "Mode",
      "enum": [
        "csv-columns",
        "exact",
        "gotest",
        "ifeval",
        "json-schema",
        "judge",
        "junit",
        "math",
        "mcq",
        "numeric",
        "pytest",
        "reasoning-gym",
        "script",
        "stdio",
        "xml-elements"
      ]
    },
    "JudgeConfig": {
      "title": "JudgeConfig",
      "type": "object",
      "properties": {
        "policy": {
          "$ref": "#/$defs/JudgeModelPolicy"
        },
        "view": {
          "$ref": "#/$defs/JudgeView"
        }
      },
      "required": [
        "policy",
        "view"
      ],
      "additionalProperties": false
    },
    "JudgeModelPolicy": {
      "title": "JudgeModelPolicy",
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "size_class": {
          "enum": [
            "large",
            "medium",
            "small"
          ]
        },
        "provider": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        },
        "samples": {
          "type": "integer",
          "default": 1
        },
        "aggregation": {
          "enum": [
            "mean"
          ],
          "default": "mean"
        },
        "temperature": {
          "type": "number",
          "default": 0.0
        }
      },
      "required": [
        "model",
        "size_class",
        "provider",
        "base_url"
      ],
      "additionalProperties": false
    },
    "JudgeView": {
      "title": "JudgeView",
      "type": "object",
      "properties": {
        "transcript": {
          "type": "boolean",
          "default": false
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "reference_context": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ContainerRuntime": {
      "title": "ContainerRuntime",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "container"
          ]
        },
        "image": {
          "type": "string"
        },
        "timeout": {
          "type": "number",
          "default": 120.0
        },
        "revision": {
          "type": "string",
          "default": "b2b68d8b0a770cdc0ab3903780172c4b3eea81b1"
        },
        "workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmptyWorkspace"
            },
            {
              "$ref": "#/$defs/ImageOverlay"
            }
          ],
          "discriminator": {
            "propertyName": "kind",
            "mapping": {
              "empty": "#/$defs/EmptyWorkspace",
              "image_overlay": "#/$defs/ImageOverlay"
            }
          },
          "default": {
            "kind": "empty"
          }
        },
        "supervisor_python": {
          "type": "string",
          "default": "python3"
        }
      },
      "required": [
        "kind",
        "image"
      ],
      "additionalProperties": false
    },
    "EmptyWorkspace": {
      "title": "EmptyWorkspace",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "empty"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "ImageOverlay": {
      "title": "ImageOverlay",
      "description": "Retain image dependencies while replacing all submitted workspace content.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "image_overlay"
          ]
        },
        "preserved_directories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "preserved_directories"
      ],
      "additionalProperties": false
    },
    "PredictedActionVerifier": {
      "title": "PredictedActionVerifier",
      "description": "Private NeMo next-action target and source comparison behavior.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "predicted_action"
          ]
        },
        "expected_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExpectedMessage"
            },
            {
              "$ref": "#/$defs/ExpectedFunctionCall"
            },
            {
              "$ref": "#/$defs/ExpectedFunctionCallBatch"
            }
          ],
          "discriminator": {
            "propertyName": "type",
            "mapping": {
              "message": "#/$defs/ExpectedMessage",
              "function_call": "#/$defs/ExpectedFunctionCall",
              "function_call_batch": "#/$defs/ExpectedFunctionCallBatch"
            }
          }
        },
        "comparator": {
          "$ref": "#/$defs/ToolCallComparatorConfig"
        },
        "source_revision": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "expected_action",
        "comparator",
        "source_revision"
      ],
      "additionalProperties": false
    },
    "ExpectedMessage": {
      "title": "ExpectedMessage",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "message"
          ]
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "ExpectedFunctionCall": {
      "title": "ExpectedFunctionCall",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "function_call"
          ]
        },
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "ExpectedFunctionCallBatch": {
      "title": "ExpectedFunctionCallBatch",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "function_call_batch"
          ]
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FunctionCall"
          }
        }
      },
      "required": [
        "type",
        "calls"
      ],
      "additionalProperties": false
    },
    "FunctionCall": {
      "title": "FunctionCall",
      "description": "A source-native function call, retained without dispatching it.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "ToolCallComparatorConfig": {
      "title": "ToolCallComparatorConfig",
      "description": "Pinned source comparator settings; defaults preserve existing NeMo rows.",
      "type": "object",
      "properties": {
        "word_count_similarity_threshold": {
          "type": "number"
        },
        "floating_point_comparison_threshold": {
          "type": "number",
          "default": 1e-06
        },
        "parallel_tool_call_rewarding": {
          "type": "boolean",
          "default": false
        },
        "allow_subset": {
          "type": "boolean",
          "default": false
        },
        "allow_superset": {
          "type": "boolean",
          "default": false
        },
        "parallel_tool_call_reward_mode": {
          "$ref": "#/$defs/ParallelToolCallRewardMode",
          "default": "binary_strict"
        }
      },
      "required": [
        "word_count_similarity_threshold"
      ],
      "additionalProperties": false
    },
    "ParallelToolCallRewardMode": {
      "title": "ParallelToolCallRewardMode",
      "enum": [
        "binary_strict",
        "f1",
        "fractional"
      ]
    },
    "ConstraintVerifier": {
      "title": "ConstraintVerifier",
      "description": "Private IFEval checks evaluated through the pinned source registry.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "instruction_constraints"
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InstructionConstraint"
          }
        },
        "aggregation": {
          "enum": [
            "binary",
            "fraction"
          ]
        }
      },
      "required": [
        "kind",
        "constraints",
        "aggregation"
      ],
      "additionalProperties": false
    },
    "InstructionConstraint": {
      "title": "InstructionConstraint",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "params"
      ],
      "additionalProperties": false
    },
    "ProviderStateVerifier": {
      "title": "ProviderStateVerifier",
      "description": "Private source-adapter verifier over authoritative provider state, not agent claims.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "provider_state"
          ]
        },
        "interface": {
          "$ref": "#/$defs/ActionInterface"
        },
        "adapter": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "kind",
        "interface",
        "adapter",
        "parameters"
      ],
      "additionalProperties": false
    },
    "ActionInterface": {
      "title": "ActionInterface",
      "description": "A semantic, provider-independent stateful action surface and pinned seed digest.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "seed_sha256": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "seed_sha256"
      ],
      "additionalProperties": false
    },
    "CodeAnswerVerifier": {
      "title": "CodeAnswerVerifier",
      "description": "Materialize an answer-only code payload before an isolated source verifier runs.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "code_answer"
          ]
        },
        "verifier": {
          "$ref": "#/$defs/TaskTroveVerifier"
        },
        "output_path": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "verifier",
        "output_path"
      ],
      "additionalProperties": false
    },
    "AnswerRequirements": {
      "title": "AnswerRequirements",
      "description": "The semantic form of a task's submitted answer.\n\n    ``text`` accepts an unconstrained assistant response. Renderings can add a\n    transport wrapper, but they do not change this intrinsic answer form.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "csv",
            "final_state",
            "json",
            "literal",
            "text",
            "xml"
          ],
          "default": "text"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Resource": {
      "title": "Resource",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceRole"
          }
        },
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/Embedded"
            },
            {
              "$ref": "#/$defs/ResourceRef"
            }
          ],
          "discriminator": {
            "propertyName": "kind",
            "mapping": {
              "embedded": "#/$defs/Embedded",
              "reference": "#/$defs/ResourceRef"
            }
          }
        },
        "executable": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "path",
        "roles",
        "content"
      ],
      "additionalProperties": false
    },
    "ResourceRole": {
      "title": "ResourceRole",
      "enum": [
        "agent",
        "oracle",
        "verifier"
      ]
    },
    "Embedded": {
      "title": "Embedded",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "embedded"
          ]
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64"
        }
      },
      "required": [
        "kind",
        "data"
      ],
      "additionalProperties": false
    },
    "ResourceRef": {
      "title": "ResourceRef",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "reference"
          ]
        },
        "uri": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "uri",
        "sha256"
      ],
      "additionalProperties": false
    },
    "ContextRequirement": {
      "title": "ContextRequirement",
      "enum": [
        "instruction_and_workspace",
        "prior_conversation"
      ]
    },
    "TaskRequirements": {
      "title": "TaskRequirements",
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "default": []
        },
        "state": {
          "$ref": "#/$defs/WorkspaceState",
          "default": {
            "image": null,
            "workdir": "/app",
            "setup_commands": [],
            "additional_directories": []
          }
        },
        "action_interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionInterface"
          },
          "default": []
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Capability": {
      "title": "Capability",
      "enum": [
        "filesystem",
        "process",
        "shell"
      ]
    },
    "WorkspaceState": {
      "title": "WorkspaceState",
      "description": "Required initial state, independent of the service that materializes it.",
      "type": "object",
      "properties": {
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workdir": {
          "type": "string",
          "default": "/app"
        },
        "setup_commands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "additional_directories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "TaskMetadata": {
      "title": "TaskMetadata",
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/Source"
        },
        "competencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "task_shape": {
          "type": "string",
          "default": "answer"
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "Source": {
      "title": "Source",
      "type": "object",
      "properties": {
        "dataset": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "row": {
          "type": "string"
        },
        "importer_revision": {
          "type": "string"
        }
      },
      "required": [
        "dataset",
        "revision",
        "row",
        "importer_revision"
      ],
      "additionalProperties": false
    },
    "TaskSuccessPolicy": {
      "title": "TaskSuccessPolicy",
      "enum": [
        "all_required_steps",
        "final",
        "mean"
      ]
    }
  }
}
