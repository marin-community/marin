{
  "$ref": "#/$defs/Task",
  "$defs": {
    "Task": {
      "title": "Task",
      "description": "Public rendered instance; private evaluation stays with its specification.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "specification_sha256": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TaskStep"
          }
        },
        "requirements": {
          "$ref": "#/$defs/TaskRequirements"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PublicResource"
          }
        },
        "metadata": {
          "$ref": "#/$defs/TaskMetadata"
        }
      },
      "required": [
        "id",
        "specification_sha256",
        "steps",
        "requirements",
        "resources",
        "metadata"
      ],
      "additionalProperties": false
    },
    "TaskStep": {
      "title": "TaskStep",
      "type": "object",
      "properties": {
        "instructions": {
          "type": "string"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PublicResource"
          }
        },
        "submission": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssistantFinal"
            },
            {
              "$ref": "#/$defs/FileSubmission"
            },
            {
              "$ref": "#/$defs/FinalState"
            },
            {
              "$ref": "#/$defs/FinalActionSubmission"
            }
          ],
          "discriminator": {
            "propertyName": "kind",
            "mapping": {
              "assistant_final": "#/$defs/AssistantFinal",
              "file": "#/$defs/FileSubmission",
              "final_state": "#/$defs/FinalState",
              "final_action": "#/$defs/FinalActionSubmission"
            }
          }
        },
        "context_requirement": {
          "$ref": "#/$defs/ContextRequirement"
        }
      },
      "required": [
        "instructions",
        "resources",
        "submission",
        "context_requirement"
      ],
      "additionalProperties": false
    },
    "PublicResource": {
      "title": "PublicResource",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/Embedded"
            },
            {
              "$ref": "#/$defs/ResourceRef"
            }
          ],
          "discriminator": {
            "propertyName": "kind",
            "mapping": {
              "embedded": "#/$defs/Embedded",
              "reference": "#/$defs/ResourceRef"
            }
          }
        },
        "executable": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "path",
        "content"
      ],
      "additionalProperties": false
    },
    "Embedded": {
      "title": "Embedded",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "embedded"
          ]
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64"
        }
      },
      "required": [
        "kind",
        "data"
      ],
      "additionalProperties": false
    },
    "ResourceRef": {
      "title": "ResourceRef",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "reference"
          ]
        },
        "uri": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "uri",
        "sha256"
      ],
      "additionalProperties": false
    },
    "AssistantFinal": {
      "title": "AssistantFinal",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "assistant_final"
          ]
        },
        "extractor": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlainText"
            },
            {
              "$ref": "#/$defs/BoxedLatex"
            },
            {
              "$ref": "#/$defs/JsonPath"
            },
            {
              "$ref": "#/$defs/XmlPath"
            }
          ],
          "discriminator": {
            "propertyName": "kind",
            "mapping": {
              "plain": "#/$defs/PlainText",
              "boxed_latex": "#/$defs/BoxedLatex",
              "json_path": "#/$defs/JsonPath",
              "xml_path": "#/$defs/XmlPath"
            }
          },
          "default": {
            "kind": "plain"
          }
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "PlainText": {
      "title": "PlainText",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "plain"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "BoxedLatex": {
      "title": "BoxedLatex",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "boxed_latex"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "JsonPath": {
      "title": "JsonPath",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "json_path"
          ]
        },
        "path": {
          "type": "string",
          "default": "$.answer"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "XmlPath": {
      "title": "XmlPath",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "xml_path"
          ]
        },
        "path": {
          "type": "string",
          "default": "/answer"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "FileSubmission": {
      "title": "FileSubmission",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "file"
          ]
        },
        "path": {
          "type": "string"
        },
        "extractor": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlainText"
            },
            {
              "$ref": "#/$defs/BoxedLatex"
            },
            {
              "$ref": "#/$defs/JsonPath"
            },
            {
              "$ref": "#/$defs/XmlPath"
            }
          ],
          "discriminator": {
            "propertyName": "kind",
            "mapping": {
              "plain": "#/$defs/PlainText",
              "boxed_latex": "#/$defs/BoxedLatex",
              "json_path": "#/$defs/JsonPath",
              "xml_path": "#/$defs/XmlPath"
            }
          },
          "default": {
            "kind": "plain"
          }
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "additionalProperties": false
    },
    "FinalState": {
      "title": "FinalState",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "final_state"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "kind",
        "paths"
      ],
      "additionalProperties": false
    },
    "FinalActionSubmission": {
      "title": "FinalActionSubmission",
      "description": "A final model action represented natively, with no domain-action dispatch.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "final_action"
          ]
        },
        "functions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NativeFunction"
          }
        },
        "allow_message": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "kind",
        "functions"
      ],
      "additionalProperties": false
    },
    "NativeFunction": {
      "title": "NativeFunction",
      "description": "A provider-native advertised function definition, without an execution binding.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "strict": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "parameters"
      ],
      "additionalProperties": false
    },
    "ContextRequirement": {
      "title": "ContextRequirement",
      "enum": [
        "instruction_and_workspace",
        "prior_conversation"
      ]
    },
    "TaskRequirements": {
      "title": "TaskRequirements",
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "default": []
        },
        "state": {
          "$ref": "#/$defs/WorkspaceState",
          "default": {
            "image": null,
            "workdir": "/app",
            "setup_commands": [],
            "additional_directories": []
          }
        },
        "action_interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionInterface"
          },
          "default": []
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Capability": {
      "title": "Capability",
      "enum": [
        "filesystem",
        "process",
        "shell"
      ]
    },
    "WorkspaceState": {
      "title": "WorkspaceState",
      "description": "Required initial state, independent of the service that materializes it.",
      "type": "object",
      "properties": {
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workdir": {
          "type": "string",
          "default": "/app"
        },
        "setup_commands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "additional_directories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ActionInterface": {
      "title": "ActionInterface",
      "description": "A semantic, provider-independent stateful action surface and pinned seed digest.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "seed_sha256": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "seed_sha256"
      ],
      "additionalProperties": false
    },
    "TaskMetadata": {
      "title": "TaskMetadata",
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/Source"
        },
        "competencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "task_shape": {
          "type": "string",
          "default": "answer"
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "Source": {
      "title": "Source",
      "type": "object",
      "properties": {
        "dataset": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "row": {
          "type": "string"
        },
        "importer_revision": {
          "type": "string"
        }
      },
      "required": [
        "dataset",
        "revision",
        "row",
        "importer_revision"
      ],
      "additionalProperties": false
    }
  }
}
