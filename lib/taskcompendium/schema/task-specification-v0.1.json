{
  "$ref": "#/$defs/TaskSpecification",
  "$defs": {
    "TaskSpecification": {
      "title": "TaskSpecification",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "environment": {
          "anyOf": [
            {
              "$ref": "#/$defs/NoEnvironment"
            },
            {
              "$ref": "#/$defs/ShellSimEnvironment"
            },
            {
              "$ref": "#/$defs/DockerEnvironment"
            }
          ],
          "discriminator": {
            "propertyName": "kind",
            "mapping": {
              "none": "#/$defs/NoEnvironment",
              "shellsim": "#/$defs/ShellSimEnvironment",
              "docker": "#/$defs/DockerEnvironment"
            }
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resource"
          }
        },
        "verifier": {
          "$ref": "#/$defs/VerifierSpec"
        },
        "verifier_runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/PythonRuntime"
            },
            {
              "$ref": "#/$defs/ContainerRuntime"
            }
          ],
          "discriminator": {
            "propertyName": "kind",
            "mapping": {
              "python": "#/$defs/PythonRuntime",
              "container": "#/$defs/ContainerRuntime"
            }
          }
        },
        "metadata": {
          "$ref": "#/$defs/TaskMetadata"
        },
        "answer_requirements": {
          "$ref": "#/$defs/AnswerRequirements",
          "default": {
            "kind": "value"
          }
        },
        "schema_version": {
          "type": "string",
          "default": "0.1"
        }
      },
      "required": [
        "id",
        "instructions",
        "environment",
        "resources",
        "verifier",
        "verifier_runtime",
        "metadata"
      ],
      "additionalProperties": false
    },
    "NoEnvironment": {
      "title": "NoEnvironment",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "none"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "ShellSimEnvironment": {
      "title": "ShellSimEnvironment",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "shellsim"
          ]
        },
        "workdir": {
          "type": "string",
          "default": "/app"
        },
        "max_steps": {
          "type": "integer",
          "default": 100000
        },
        "max_output_bytes": {
          "type": "integer",
          "default": 1048576
        },
        "setup_commands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "additional_directories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "DockerEnvironment": {
      "title": "DockerEnvironment",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "docker"
          ]
        },
        "image": {
          "type": "string"
        },
        "workdir": {
          "type": "string",
          "default": "/app"
        },
        "setup_commands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "additional_directories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "kind",
        "image"
      ],
      "additionalProperties": false
    },
    "Resource": {
      "title": "Resource",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceRole"
          }
        },
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/Embedded"
            },
            {
              "$ref": "#/$defs/ResourceRef"
            }
          ],
          "discriminator": {
            "propertyName": "kind",
            "mapping": {
              "embedded": "#/$defs/Embedded",
              "reference": "#/$defs/ResourceRef"
            }
          }
        },
        "executable": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "path",
        "roles",
        "content"
      ],
      "additionalProperties": false
    },
    "ResourceRole": {
      "title": "ResourceRole",
      "enum": [
        "agent",
        "oracle",
        "verifier"
      ]
    },
    "Embedded": {
      "title": "Embedded",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "embedded"
          ]
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64"
        }
      },
      "required": [
        "kind",
        "data"
      ],
      "additionalProperties": false
    },
    "ResourceRef": {
      "title": "ResourceRef",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "reference"
          ]
        },
        "uri": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "uri",
        "sha256"
      ],
      "additionalProperties": false
    },
    "VerifierSpec": {
      "title": "VerifierSpec",
      "description": "Parameters use the pinned tasktrove-verify ontology, without submission paths.",
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "parameters": {
          "type": "object"
        },
        "judge": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/JudgeConfig"
            }
          ],
          "default": null
        }
      },
      "required": [
        "mode",
        "parameters"
      ],
      "additionalProperties": false
    },
    "Mode": {
      "title": "Mode",
      "enum": [
        "csv-columns",
        "exact",
        "gotest",
        "ifeval",
        "json-schema",
        "judge",
        "junit",
        "math",
        "mcq",
        "numeric",
        "pytest",
        "reasoning-gym",
        "script",
        "stdio",
        "xml-elements"
      ]
    },
    "JudgeConfig": {
      "title": "JudgeConfig",
      "type": "object",
      "properties": {
        "policy": {
          "$ref": "#/$defs/JudgeModelPolicy"
        },
        "view": {
          "$ref": "#/$defs/JudgeView"
        }
      },
      "required": [
        "policy",
        "view"
      ],
      "additionalProperties": false
    },
    "JudgeModelPolicy": {
      "title": "JudgeModelPolicy",
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "size_class": {
          "enum": [
            "large",
            "medium",
            "small"
          ]
        },
        "provider": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        },
        "samples": {
          "type": "integer",
          "default": 1
        },
        "aggregation": {
          "enum": [
            "mean"
          ],
          "default": "mean"
        },
        "temperature": {
          "type": "number",
          "default": 0.0
        }
      },
      "required": [
        "model",
        "size_class",
        "provider",
        "base_url"
      ],
      "additionalProperties": false
    },
    "JudgeView": {
      "title": "JudgeView",
      "type": "object",
      "properties": {
        "transcript": {
          "type": "boolean",
          "default": false
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "reference_context": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "PythonRuntime": {
      "title": "PythonRuntime",
      "description": "Trusted answer graders only; never executes source programs.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "python"
          ]
        },
        "revision": {
          "type": "string",
          "default": "b2b68d8b0a770cdc0ab3903780172c4b3eea81b1"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "ContainerRuntime": {
      "title": "ContainerRuntime",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "container"
          ]
        },
        "image": {
          "type": "string"
        },
        "timeout": {
          "type": "number",
          "default": 120.0
        },
        "revision": {
          "type": "string",
          "default": "b2b68d8b0a770cdc0ab3903780172c4b3eea81b1"
        },
        "workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmptyWorkspace"
            },
            {
              "$ref": "#/$defs/ImageOverlay"
            }
          ],
          "discriminator": {
            "propertyName": "kind",
            "mapping": {
              "empty": "#/$defs/EmptyWorkspace",
              "image_overlay": "#/$defs/ImageOverlay"
            }
          },
          "default": {
            "kind": "empty"
          }
        },
        "supervisor_python": {
          "type": "string",
          "default": "python3"
        }
      },
      "required": [
        "kind",
        "image"
      ],
      "additionalProperties": false
    },
    "EmptyWorkspace": {
      "title": "EmptyWorkspace",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "empty"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "ImageOverlay": {
      "title": "ImageOverlay",
      "description": "Retain image dependencies while replacing all submitted workspace content.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "image_overlay"
          ]
        },
        "preserved_directories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "preserved_directories"
      ],
      "additionalProperties": false
    },
    "TaskMetadata": {
      "title": "TaskMetadata",
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/Source"
        },
        "competencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "task_shape": {
          "type": "string",
          "default": "answer"
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "Source": {
      "title": "Source",
      "type": "object",
      "properties": {
        "dataset": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "row": {
          "type": "string"
        },
        "importer_revision": {
          "type": "string"
        }
      },
      "required": [
        "dataset",
        "revision",
        "row",
        "importer_revision"
      ],
      "additionalProperties": false
    },
    "AnswerRequirements": {
      "title": "AnswerRequirements",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "csv",
            "final_state",
            "json",
            "literal",
            "value",
            "xml"
          ],
          "default": "value"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
