# syntax=docker/dockerfile:1.7

# Source-free GPU task image. NVIDIA owns the accelerator stack; Iris overlays
# the submitted workspace at runtime.
FROM ghcr.io/nvidia/jax:jax-2026-07-18@sha256:5eaf737a4d598313b83087b0e508e835ca882bc0915a57c30320575b8b10e775

LABEL org.opencontainers.image.source="https://github.com/marin-community/marin"
LABEL org.opencontainers.image.description="Iris GPU task base image backed by NVIDIA JAX-Toolbox"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    ffmpeg \
    git \
    lldb \
    openssh-client \
    unzip \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.10.3 /uv /uvx /bin/

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:$PATH"

# CUTLASS DSL imports Torch for dtype and tensor adapters even when Marin runs
# only JAX kernels. Keep a CPU Torch in the image so the overlay does not pull a
# CUDA-12 Torch stack into the CUDA-13 Toolbox runtime.
RUN python3 -m pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
    torch==2.11.0+cpu

# The setup script records which declared distributions exist before syncing
# and excludes every name from the overlay venv. Keep this list to one coherent
# binary stack rather than preserving jax/jaxlib alone.
RUN python3 - <<'PY'
import importlib.metadata as metadata
import pathlib

candidates = (
    "jax",
    "jaxlib",
    "jax-cuda13-pjrt",
    "jax-cuda13-plugin",
    "transformer-engine",
    "transformer-engine-jax",
    "torch",
    "cuda-bindings",
    "cuda-core",
    "cuda-pathfinder",
    "cuda-python",
    "cuda-tile",
    "cuda-toolkit",
    "nvidia-cublas",
    "nvidia-cublas-cu12",
    "nvidia-cuda-crt",
    "nvidia-cuda-cupti",
    "nvidia-cuda-cupti-cu12",
    "nvidia-cuda-nvcc",
    "nvidia-cuda-nvdisasm",
    "nvidia-cuda-nvrtc",
    "nvidia-cuda-nvrtc-cu12",
    "nvidia-cuda-runtime",
    "nvidia-cuda-runtime-cu12",
    "nvidia-cudnn-cu12",
    "nvidia-cudnn-cu13",
    "nvidia-cufft",
    "nvidia-cufft-cu12",
    "nvidia-cufile-cu12",
    "nvidia-curand-cu12",
    "nvidia-cusolver",
    "nvidia-cusolver-cu12",
    "nvidia-cusolvermp-cu13",
    "nvidia-cusparse",
    "nvidia-cusparse-cu12",
    "nvidia-cusparselt-cu12",
    "nvidia-cutlass-dsl",
    "nvidia-cutlass-dsl-libs-base",
    "nvidia-cutlass-dsl-libs-core",
    "nvidia-cutlass-dsl-libs-cu12",
    "nvidia-cutlass-dsl-libs-cu13",
    "nvidia-nccl-cu12",
    "nvidia-nccl-cu13",
    "nvidia-nvjitlink",
    "nvidia-nvjitlink-cu12",
    "nvidia-nvshmem-cu12",
    "nvidia-nvshmem-cu13",
    "nvidia-nvtx-cu12",
    "nvidia-nvvm",
)
installed = set()
for name in candidates:
    try:
        metadata.distribution(name)
    except metadata.PackageNotFoundError:
        continue
    installed.add(name)

required = {"jax", "jaxlib", "jax-cuda13-pjrt", "jax-cuda13-plugin"}
missing = required.difference(installed)
if missing:
    raise SystemExit(f"JAX-Toolbox image is missing required distributions: {sorted(missing)}")

iris_dir = pathlib.Path("/etc/iris")
iris_dir.mkdir(parents=True, exist_ok=True)
(iris_dir / "preserved-python-packages").write_text("\n".join(candidates) + "\n")
(iris_dir / "system-cuda-toolchain").touch()
PY

ARG IRIS_GIT_HASH=unknown
ENV IRIS_GIT_HASH=${IRIS_GIT_HASH}

WORKDIR /app
