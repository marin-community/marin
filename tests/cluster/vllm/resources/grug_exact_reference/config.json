{
  "architectures": [
    "GrugMoeForCausalLM"
  ],
  "attention_head_dim": 16,
  "attn_gate": true,
  "disable_long_rope": true,
  "disable_pko": true,
  "dtype": "float32",
  "gated_norm": true,
  "global_every": 6,
  "global_kv_heads": 1,
  "head_dim": 16,
  "hidden_dim": 64,
  "hidden_size": 64,
  "initializer_range": 0.02,
  "initializer_std": 0.02,
  "intermediate_dim": 16,
  "intermediate_size": 16,
  "layer_norm_eps": 1e-05,
  "legacy_input_output_gated_norm": false,
  "local_kv_heads": 2,
  "max_position_embeddings": 1024,
  "max_seq_len": 1024,
  "model_type": "grug_moe",
  "moe_intermediate_size": 16,
  "mtp_dense": true,
  "mtp_depth": 1,
  "num_attention_heads": 4,
  "num_experts": 4,
  "num_experts_per_tok": 2,
  "num_experts_per_token": 2,
  "num_heads": 4,
  "num_hidden_layers": 7,
  "num_key_value_heads": 2,
  "num_kv_heads": 2,
  "num_layers": 7,
  "num_local_experts": 4,
  "num_shared_experts": 2,
  "over_encoding_vocab_size": 0,
  "qb_routing": true,
  "qk_mult": 1.3,
  "qk_mult_long_scale": 1.0,
  "rms_norm_eps": 1e-05,
  "rope": {
    "theta": 10000.0
  },
  "rope_fraction": 0.5,
  "rope_fused": true,
  "rope_parameters": {
    "rope_theta": 10000.0,
    "rope_type": "default"
  },
  "rope_theta": 10000.0,
  "sconv": true,
  "sconv_kernel": 4,
  "sconv_sites": [
    "k",
    "v",
    "attn",
    "mlp"
  ],
  "shared_expert_intermediate_dim": 32,
  "shared_expert_intermediate_size": 32,
  "sliding_window": 512,
  "tie_word_embeddings": false,
  "torch_dtype": "float32",
  "use_cache": true,
  "vocab_size": 64,
  "xsa": true
}
