+def test_load_tokenizer_concurrent_processes_share_complete_files(fake_tokenizer_dir):
+    # Local GPU ranks share /tmp; overlapping downloads must not truncate a
+    # tokenizer that a sibling process is reading during startup.
+    tokenizer_path = fake_tokenizer_dir / "tokenizer.json"
+    tokenizer_path.write_text(tokenizer_path.read_text() + " " * (16 * 1024 * 1024))
+    script = """
+import json
+import sys
+from levanter.tokenizers import load_tokenizer
+print("ready", flush=True)
+sys.stdin.readline()
+print(json.dumps(load_tokenizer(sys.argv[1]).get_vocab()), flush=True)
+"""
+    processes = [
+        subprocess.Popen(
+            [sys.executable, "-c", script, f"file://{fake_tokenizer_dir}"],
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for _ in range(4)
+    ]
+    try:
+        for process in processes:
+            assert process.stdout.readline().strip() == "ready"
+        for process in processes:
+            process.stdin.write("go\n")
+            process.stdin.flush()
+        for process in processes:
+            output, error = process.communicate(timeout=30)
+            assert process.returncode == 0, error
+            assert json.loads(output) == {}
+    finally:
+        for process in processes:
+            if process.poll() is None:
+                process.kill()
+            process.wait(timeout=5)
+
+
 def test_as_hf_tokenizer_loads_object_storage_path(fake_tokenizer_dir, clear_stage_cache):
     url = f"file://{fake_tokenizer_dir}"
     tokenizer = load_tokenizer(url)
