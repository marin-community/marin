      - SandboxBuildFailedError
      - ContainerRegistryThrottledError
      - AgentSetupTimeoutError
      - DaytonaSandboxStopError
      - DaytonaProcessError
      - TrialTimeoutError
      - ArtifactWriteTimeoutError
      - Tau3RuntimeInfrastructureError
      - Tau3TargetInfrastructureError
      - VerifierTimeoutError
      - VerifierRuntimeError
      wait_multiplier: 2.0
      min_wait_sec: 1.0
      max_wait_sec: 60.0
      exclude_exceptions: []
    environment:
      type: daytona
    agents:
    - name: terminus-2
      override_timeout_sec: 1800.0
      override_setup_timeout_sec: 360.0
      kwargs:
        thinking_format: chat-template
        model_info:
          max_input_tokens: 32768
          max_output_tokens: 8192
        llm_call_kwargs:
          max_tokens: 8192
        extra_body:
          chat_template_kwargs:
            enable_thinking: true
    datasets:
