+def test_attention_data_parallel_ranks_count_toward_per_gpu_throughput(tmp_path: Path) -> None:
+    result_dir = _write_fixture(tmp_path)
+    single = _run_processor(result_dir, tmp_path / "single", {"TP": "1", "EP_SIZE": "1"})
+    parallel = _run_processor(
+        result_dir,
+        tmp_path / "parallel",
+        {"TP": "1", "EP_SIZE": "2", "DP_SIZE": "2", "DP_ATTENTION": "true"},
+    )
+    assert parallel["num_gpus"] == 2
+    assert parallel["tp"] == 1
+    assert parallel["ep"] == 2
+    assert (
+        parallel["request_metrics"]["throughput"]["total"]
+        == single["request_metrics"]["throughput"]["total"]
+    )
+    assert parallel["request_metrics"]["throughput"]["per_gpu"]["output_tput_tps"] == pytest.approx(
+        single["request_metrics"]["throughput"]["per_gpu"]["output_tput_tps"] / 2,
+        abs=0.00001,
+    )
