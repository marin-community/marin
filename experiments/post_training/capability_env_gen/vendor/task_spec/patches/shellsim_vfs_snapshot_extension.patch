+    #[test]
+    fn snapshot_hashes_large_files_without_read_response_limit() {
+        let mut state = Some(Interp::with_limits(Limits {
+            cpu: 10000, memory: 128 * 1024 * 1024, disk: 64 * 1024 * 1024, output: 4096,
+        }));
+        let sim = state.as_mut().unwrap();
+        sim.vfs.mkdir_all("/", "/work/empty").unwrap();
+        sim.vfs.write("/", "/work/large.bin", &vec![b'x'; 17 * 1024 * 1024], 0o640).unwrap();
+        sim.vfs.symlink("/", "large.bin", "/work/link").unwrap();
+        let response = handle(&mut state, Request::Snapshot {
+            path: "/work".to_string(),
+            limits: SnapshotLimits { max_entries: 8, max_file_bytes: 32 * 1024 * 1024,
+                max_response_bytes: 4096 },
+        }).unwrap();
+        let entries = response["snapshot"]["entries"].as_array().unwrap();
+        assert_eq!(entries.len(), 4);
+        assert_eq!(entries[1]["path"], "empty");
+        assert_eq!(entries[2]["mode"], 0o640);
+        assert_eq!(entries[3]["target"], "large.bin");
+        assert_eq!(entries[2]["sha256"], sha256_hex(&vec![b'x'; 17 * 1024 * 1024]));
+    }
+
