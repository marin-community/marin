  "recognition_rules": {
    "skills": {
      "normalization": "normaliz|normalis|sctransform|variance.stabili|size.factor",
      "transformation": "log10|log1p|log2.transfor|log.transfor|logarithm|variance.stabili",
      "dimension-reduction": "\\bpca\\b|principal.component|dimensionality.reduction|\\bumap\\b|t.sne|latent.space|latent.representation|embedding|matrix.factorization|\\bnmf\\b",
      "feature-selection": "highly.variable|variable.gene|feature.selection|select.{0,20}(?:features|genes)|\\bhvg",
      "association": "correlat|spearman|pearson|chi.square|association.test|test.{0,20}association|co.expression",
      "regression": "regression|logistic|log.odds|mixed.effect|linear.model|\\bglm\\b|\\bgam\\b|quadratic|cubic|spline",
      "group-comparison": "mann.whitney|wilcoxon|\\banova\\b|t.test|compare.{0,45}(?:groups|conditions|cohorts)|group.comparison|paired.test",
      "multiple-testing": "benjamini|bonferroni|multiple.test|multi.test|false.discovery",
      "differential-expression": "differential.{0,20}express|\\bdeseq2?\\b|\\bedger\\b|\\bdeg[s]?\\b|pseudobulk|\\blimma\\b|rna.seq.contrast|shrunken.effects",
      "enrichment": "enrich|over.represent|\\bgsea\\b|\\bora\\b",
      "sensitivity": "sensitivity.analysis|repeat.{0,50}(?:exclud|without)|excluding.the.third|robustness|sensitivity.and",
      "clustering": "cluster|leiden|louvain|dendrogram|community.detect",
      "classification": "(?:train|fit|build|evaluate).{0,60}classif|predict.{0,25}(?:label|class|diagnos|probabil)|label.projection|cell.type.projection",
      "prediction": "predict.{0,45}(?:affinity|response|activity|measurement|expression|value)|imput|forecast|held.out.assay|property.regression",
