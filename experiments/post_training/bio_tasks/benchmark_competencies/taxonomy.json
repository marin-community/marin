{
  "schema_version": 1,
  "purpose": "Find missing scientific capabilities and design realistic, executable Harbor workflows. Skills and biological applications are independent facets; they are not a hierarchy or a Cartesian task-generation grid.",
  "skills": [
    {
      "id": "normalization",
      "name": "Normalization",
      "outcome": "Adjust measurement scale or composition using a declared normalization procedure."
    },
    {
      "id": "transformation",
      "name": "Data transformation",
      "outcome": "Apply a defined mathematical transformation while preserving identities, missingness and units."
    },
    {
      "id": "dimension-reduction",
      "name": "Dimensionality reduction",
      "outcome": "Construct a reduced representation and check its fit, variance or neighborhood properties."
    },
    {
      "id": "feature-selection",
      "name": "Feature selection",
      "outcome": "Select informative features under a declared criterion without leaking evaluation data."
    },
    {
      "id": "association",
      "name": "Association analysis",
      "outcome": "Estimate or test an association on correctly matched observations with the stated unit of replication."
    },
    {
      "id": "regression",
      "name": "Regression modeling",
      "outcome": "Fit a specified response model and report parameters, uncertainty or fit diagnostics."
    },
    {
      "id": "group-comparison",
      "name": "Group comparison",
      "outcome": "Estimate or test a group contrast with explicit sampling, pairing and effect direction."
    },
    {
      "id": "multiple-testing",
      "name": "Multiple-testing correction",
      "outcome": "Correct a declared family of hypothesis tests and retain its tested population."
    },
    {
      "id": "differential-expression",
      "name": "Differential expression analysis",
      "outcome": "Estimate expression contrasts under an explicit design, measurement model and gene-selection rule."
    },
    {
      "id": "enrichment",
      "name": "Enrichment analysis",
      "outcome": "Quantify gene-set, pathway or feature overrepresentation relative to a declared universe."
    },
    {
      "id": "sensitivity",
      "name": "Sensitivity analysis",
      "outcome": "Repeat an analysis under controlled changes and quantify the resulting differences."
    },
    {
      "id": "clustering",
      "name": "Clustering",
      "outcome": "Partition observations and assess grouping stability, separation or external agreement."
    },
    {
      "id": "classification",
      "name": "Predictive classification",
      "outcome": "Predict labels or probabilities for withheld observations with a prespecified metric."
    },
    {
      "id": "prediction",
      "name": "Predictive regression",
      "outcome": "Predict continuous outcomes for withheld observations and evaluate all required predictions."
    },
    {
      "id": "model-evaluation",
      "name": "Model evaluation",
      "outcome": "Evaluate complete predictions with a fixed metric and biological grouping or split policy."
    },
    {
      "id": "survival",
      "name": "Survival analysis",
      "outcome": "Estimate time-to-event quantities using explicit censoring, risk sets and covariates."
    },
    {
      "id": "causal-inference",
      "name": "Causal inference",
      "outcome": "Estimate a specified causal contrast under explicit identification and sensitivity assumptions."
    },
    {
      "id": "sequence-alignment",
      "name": "Sequence alignment",
      "outcome": "Align sequences or reads and interpret correspondence, scores and coordinate conventions."
    },
    {
      "id": "sequence-query",
      "name": "Sequence and annotation analysis",
      "outcome": "Extract or reconcile sequences with strand, coordinate, translation and annotation rules."
    },
    {
      "id": "intervals",
      "name": "Genomic interval analysis",
      "outcome": "Compute coordinate-aware overlap, distance, coverage or interval transformations."
    },
    {
      "id": "read-qc",
      "name": "Sequencing quality and coverage analysis",
      "outcome": "Measure read, alignment and reference coverage with explicit eligibility and denominators."
    },
    {
      "id": "assembly",
      "name": "Sequence assembly and assessment",
      "outcome": "Assemble or assess contigs using observed read support, continuity and error evidence."
    },
    {
      "id": "variant-analysis",
      "name": "Variant analysis",
      "outcome": "Call, normalize, filter or summarize variants with explicit allele and sample semantics."
    },
    {
      "id": "variant-consequence",
      "name": "Variant consequence annotation",
      "outcome": "Connect alleles to transcript, protein or regulatory consequences under pinned references."
    },
    {
      "id": "population-genetics",
      "name": "Population genetic analysis",
      "outcome": "Estimate allele-frequency, ancestry, differentiation or inheritance quantities."
    },
    {
      "id": "orthology",
      "name": "Orthology assessment",
      "outcome": "Assess homologous gene identity, completeness and copy status across proteomes."
    },
    {
      "id": "phylogeny",
      "name": "Phylogenetic inference and tree analysis",
      "outcome": "Infer or measure trees with explicit topology, branch-length, rooting and taxon conventions."
    },
    {
      "id": "alignment-signal",
      "name": "Alignment informativeness and composition",
      "outcome": "Measure informative sites and sequence composition under explicit gap and residue rules."
    },
    {
      "id": "cell-annotation",
      "name": "Cell identity annotation",
      "outcome": "Assign or compare cell identities against declared reference evidence and an abstention policy."
    },
    {
      "id": "composition",
      "name": "Population composition analysis",
      "outcome": "Compare population counts and fractions while preserving sample-level denominators and replication."
    },
    {
      "id": "integration",
      "name": "Data integration",
      "outcome": "Reconcile batches, studies or modalities and evaluate alignment without erasing the target variation."
    },
    {
      "id": "deconvolution",
      "name": "Mixture deconvolution",
      "outcome": "Estimate component abundances or signals using declared references and identifiable mixtures."
    },
    {
      "id": "trajectory",
      "name": "Trajectory and dynamics analysis",
      "outcome": "Estimate ordered states or dynamics and distinguish model-derived order from measured time."
    },
    {
      "id": "communication",
      "name": "Cell communication analysis",
      "outcome": "Compute expression-supported ligand–receptor or sender–receiver evidence under a frozen reference."
    },
    {
      "id": "spatial",
      "name": "Spatial analysis",
      "outcome": "Quantify spatial relationships, neighborhoods or gradients with explicit geometry and null models."
    },
    {
      "id": "chromatin",
      "name": "Chromatin accessibility and binding analysis",
      "outcome": "Analyze accessibility or binding signals using controls, replicates and reference-aware regions."
    },
    {
      "id": "motifs",
      "name": "Motif analysis",
      "outcome": "Find or assess sequence motifs under explicit models and background composition."
    },
    {
      "id": "methylation",
      "name": "Methylation analysis",
      "outcome": "Quantify methylation at sites or regions with coverage, measurement-unit and reference rules."
    },
    {
      "id": "network",
      "name": "Network analysis",
      "outcome": "Construct or evaluate typed networks, modules, paths or connectivity with traceable edges."
    },
    {
      "id": "protein-structure",
      "name": "Molecular structure analysis",
      "outcome": "Measure structural geometry, residue/atom identity, contacts or structural agreement."
    },
    {
      "id": "molecular-descriptors",
      "name": "Molecular representation and descriptors",
      "outcome": "Parse chemical structures and compute graph, charge, stereochemical or descriptor properties."
    },
    {
      "id": "rna-structure",
      "name": "RNA structure analysis",
      "outcome": "Predict or compare RNA structure under declared thermodynamic or measured constraints."
    },
    {
      "id": "image-analysis",
      "name": "Image analysis",
      "outcome": "Segment, quantify, reconstruct or classify images with calibrated spatial and sample identities."
    },
    {
      "id": "signal-analysis",
      "name": "Signal and time-series analysis",
      "outcome": "Process recorded signals or time series with explicit sampling, filtering and temporal splits."
    },
    {
      "id": "dose-response",
      "name": "Dose–response and assay analysis",
      "outcome": "Estimate assay responses and control-adjusted effects with declared plate, dose and replicate structure."
    },
    {
      "id": "abundance",
      "name": "Differential abundance analysis",
      "outcome": "Estimate abundance contrasts under measurement, missingness and replicate conventions."
    },
    {
      "id": "repertoire",
      "name": "Immune repertoire analysis",
      "outcome": "Reconcile receptor chains and quantify clonotypes, diversity or sharing across samples."
    },
    {
      "id": "database-query",
      "name": "Biological database querying",
      "outcome": "Resolve identifiers and retrieve versioned records under explicit query and evidence rules."
    },
    {
      "id": "evidence-extraction",
      "name": "Structured evidence extraction",
      "outcome": "Extract specified facts or measurements with source locations, units and a finite evidence scope."
    },
    {
      "id": "evidence-ranking",
      "name": "Evidence-based prioritization",
      "outcome": "Rank candidates under declared evidence, eligibility and tie rules without asserting unmeasured causality."
    },
    {
      "id": "simulation",
      "name": "Mechanistic modeling and simulation",
      "outcome": "Construct and execute a model and evaluate predictions under specified conditions and numerical rules."
    },
    {
      "id": "sequence-design",
      "name": "Sequence construct analysis and design",
      "outcome": "Construct or audit sequence products against explicit compatibility, translation and assembly constraints."
    },
    {
      "id": "statistics",
      "name": "Statistical estimation",
      "outcome": "Calculate an endpoint with correct observation units, aggregation, uncertainty and denominators."
    },
    {
      "id": "data-management",
      "name": "Data preparation and reconciliation",
      "outcome": "Join, filter, reshape or reconcile scientific records while preserving identity and provenance."
    },
    {
      "id": "visualization",
      "name": "Scientific visualization",
      "outcome": "Produce a specified scientific view with checkable data, labels, scales and graphical elements."
    },
    {
      "id": "taxonomic-profiling",
      "name": "Taxonomic profiling",
      "outcome": "Assign sequence evidence to taxa and quantify their abundance under a pinned reference and ambiguity policy."
    },
    {
      "id": "expression-quantification",
      "name": "Expression quantification",
      "outcome": "Estimate transcript or gene abundance from reads with explicit reference, multimapping and normalization rules."
    },
    {
      "id": "cell-qc",
      "name": "Cell and feature quality control",
      "outcome": "Select cells or features using declared measurement-aware quality, contamination and doublet rules."
    },
    {
      "id": "model-inspection",
      "name": "Model inspection",
      "outcome": "Inspect architecture, parameter identity or uncertainty from an executable model and pinned checkpoint."
    }
  ],
