# Standalone grader for the task log parser; do not edit by hand.
# Parser: @@PARSER@@
@@NOTE@@from __future__ import annotations

import json
import sys
from enum import Enum
@@IMPORTS@@

LOG_PARSER = '@@PARSER@@'


class TestStatus(str, Enum):
    FAILED = "FAILED"
    PASSED = "PASSED"
    SKIPPED = "SKIPPED"
    ERROR = "ERROR"

    def __str__(self):
        return self.value


@@DEFINITIONS@@


def parse_test_log(test_log):
    test_log = ansi_escape(test_log).replace("\r", "\n")
    test_log = repair_interleaved_harness_echo(test_log)
    parsed = @@PARSER@@(test_log)
    for name in _names_failed_on_any_line(test_log, @@PARSER@@) & parsed.keys():
        if parsed[name] == TestStatus.PASSED:
            parsed[name] = TestStatus.FAILED
    results = {"FAILED": set(), "PASSED": set(), "SKIPPED": set(), "ERROR": set()}
    for name, status in parsed.items():
        results[status.value].add(name)
    return results


def grade(config, test_log):
    fail_to_pass = config["FAIL_TO_PASS"]
    pass_to_pass = config["PASS_TO_PASS"]
    results = parse_test_log(test_log)
    expected = {"PASSED": set(fail_to_pass) | set(pass_to_pass)}
    # Disclosed repair: with NO test ids at all and an empty parsed log, the subset check is
    # vacuously true and scores a PASS from zero evidence (observed on a row whose grader
    # scored 1.0 upstream vs 0.0 condensed from identical empty logs). That case is
    # UNSCORABLE, not a pass: the verdict is not resolved, so the reward stays 0.
    unscorable = not fail_to_pass and not pass_to_pass and not any(results.values())
    actual_passed = _actual_passed_aliases(_normalized_passed_names(results["PASSED"]))
    # A parsed pass whose capture line was cut by the interleaved harness echo carries
    # TRUNCATED_TEST_NAME_MARK. The configured id it refers to is recoverable only when
    # exactly one configured id is consistent with the surviving prefix — the same id for
    # this verdict — and no other configured id shares the prefix. Fail-closed: any
    # ambiguity keeps the id unsatisfied.
    truncated_prefixes = _normalized_passed_names(_truncated_actual_prefixes(results["PASSED"]))
    expected_ids = _normalized_passed_names(expected["PASSED"])

    def _truncation_recoverable(normalized_name):
        consistent = [p for p in truncated_prefixes if normalized_name == p or normalized_name.startswith(p)]
        if len(consistent) != 1:
            return False
        prefix = consistent[0]
        extending = [i for i in expected_ids if i == prefix or i.startswith(prefix)]
        return extending == [normalized_name]

    def status(names):
        verdicts = {}
        for name in names:
            normalized_options = _normalized_passed_names({name})
            satisfied = all(
                _expected_name_satisfied(actual_passed, normalized) for normalized in normalized_options
            )
            if not satisfied:
                satisfied = any(_truncation_recoverable(normalized) for normalized in normalized_options)
            verdicts[name] = satisfied
        return verdicts

    fail_to_pass_status = status(fail_to_pass)
    pass_to_pass_status = status(pass_to_pass)
    resolved = bool(expected["PASSED"]) and not unscorable and all(fail_to_pass_status.values()) and all(
        pass_to_pass_status.values()
    )

    return {
        "log_parser": LOG_PARSER,
        "unscorable": unscorable,
        "resolved": resolved,
        "parsed_counts": {key: len(value) for key, value in results.items()},
        "fail_to_pass": fail_to_pass_status,
        "pass_to_pass": pass_to_pass_status,
        "test_results": {key: sorted(value) for key, value in results.items()},
    }


def main():
    config_path, log_path, report_path = sys.argv[1:4]
    with open(config_path, encoding="utf-8") as fh:
        config = json.load(fh)
    with open(log_path, encoding="utf-8", errors="replace") as fh:
        report = grade(config, fh.read())
    test_results = report.pop("test_results")
    with open(report_path, "w", encoding="utf-8") as fh:
        fh.write(json.dumps(report, indent=2) + "\n")
    if len(sys.argv) > 4:
        with open(sys.argv[4], "w", encoding="utf-8") as fh:
            fh.write(json.dumps(test_results) + "\n")
    f2p_ok = sum(report["fail_to_pass"].values())
    p2p_ok = sum(report["pass_to_pass"].values())
    print("parser=%s parsed=%s" % (LOG_PARSER, report["parsed_counts"]))
    print("F2P %d/%d P2P %d/%d" % (f2p_ok, len(report["fail_to_pass"]), p2p_ok, len(report["pass_to_pass"])))
    if report["unscorable"]:
        print("UNSCORABLE: no FAIL_TO_PASS/PASS_TO_PASS ids and an empty parsed log")
    print("RESOLVED" if report["resolved"] else "UNRESOLVED")
    sys.exit(0 if report["resolved"] else 1)


if __name__ == "__main__":
    main()
