+def test_newton_schulz_with_size_one_explicit_matrix_axes():
+    run_on_cpu_devices(
+        """
+        import os
+        os.environ['XLA_FLAGS'] += ' --xla_allow_excess_precision=false'
+        import jax
+        import jax.numpy as jnp
+        import numpy as np
+        from jax.sharding import AxisType, Mesh, NamedSharding, PartitionSpec as P
+        from experiments.grug.fast_track.grugmuon_stacked import (
+            _newtonschulz_padded_stack_sharded, _zeropower_via_newtonschulz_local,
+            _newtonschulz_4d_distributed,
+        )
+        values = np.random.default_rng(23).normal(size=(3,8,16)).astype(np.float32)
+        expected = jax.jit(jax.vmap(_zeropower_via_newtonschulz_local))(jnp.asarray(values))
+        mesh = Mesh(np.asarray(jax.devices()).reshape(1,1,1,1),
+                    ('replica_dcn','data','expert','model'), axis_types=(AxisType.Explicit,)*4)
+        sharding = NamedSharding(mesh, P(None,'data','model'))
+        with jax.set_mesh(mesh):
+            matrices = jax.device_put(values, sharding)
+            actual = jax.jit(lambda x: _newtonschulz_padded_stack_sharded(x, target_sharding=sharding))(matrices)
+        np.testing.assert_array_equal(np.asarray(actual), np.asarray(expected))
+        assert actual.sharding == sharding
+        values4 = np.random.default_rng(24).normal(size=(2,3,8,16)).astype(np.float32)
+        expected4 = jax.jit(jax.vmap(jax.vmap(_zeropower_via_newtonschulz_local)))(jnp.asarray(values4))
+        sharding4 = NamedSharding(mesh, P(None,'expert','data','model'))
+        with jax.set_mesh(mesh):
+            matrices4 = jax.device_put(values4, sharding4)
+            actual4 = jax.jit(lambda x: _newtonschulz_4d_distributed((), x, 5, 1e-7, 'quintic'))(matrices4)
+        np.testing.assert_array_equal(np.asarray(actual4), np.asarray(expected4))
+        assert actual4.sharding == sharding4
+        """,
+        device_count=1,
+    )
