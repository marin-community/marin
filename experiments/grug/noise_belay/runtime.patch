diff --git a/lib/levanter/tests/grug/test_grugformer_moe.py b/lib/levanter/tests/grug/test_grugformer_moe.py
index 7de13bbbd5..ec1caf39ae 100644
--- a/lib/levanter/tests/grug/test_grugformer_moe.py
+++ b/lib/levanter/tests/grug/test_grugformer_moe.py
@@ -53 +52,0 @@ from levanter.utils.activation import ActivationFunctionEnum
-
@@ -383,0 +383,58 @@ def test_local_moe_mlp_writes_a_different_width_than_it_reads():
+def test_local_ungated_relu2_moe_matches_dense_expert_outputs_and_gradients():
+    x, selected, weights, _, _ = _make_inputs(
+        key=jax.random.key(32), tokens=8, hidden_dim=4, intermediate_dim=6, num_experts=4, topk=2
+    )
+    w_up = jax.random.normal(jax.random.key(33), (4, 4, 6))
+    w_down = jax.random.normal(jax.random.key(34), (4, 6, 8))
+    valid = jnp.array([True, False, True, True, False, True, True, True])
+
+    def reference(x, up, down):
+        hidden = jnp.einsum("td,tkdi->tki", x, up[selected])
+        outputs = jnp.einsum("tki,tkio->tko", jax.nn.relu(hidden) ** 2, down[selected])
+        return jnp.einsum("tko,tk->to", outputs, weights) * valid[:, None]
+
+    def actual(x, up, down):
+        return moe_mlp(
+            x,
+            selected,
+            weights,
+            up,
+            down,
+            token_valid=valid,
+            activation=ActivationFunctionEnum.relu2,
+            implementation="scatter",
+            mesh=None,
+        )
+
+    with jax.default_matmul_precision("highest"):
+        expected = reference(x, w_up, w_down)
+        observed = actual(x, w_up, w_down)
+        expected_grads = jax.grad(lambda *args: reference(*args).sum(), argnums=(0, 1, 2))(x, w_up, w_down)
+        observed_grads = jax.grad(lambda *args: actual(*args).sum(), argnums=(0, 1, 2))(x, w_up, w_down)
+    for observed, expected in zip((observed, *observed_grads), (expected, *expected_grads), strict=True):
+        np.testing.assert_allclose(observed, expected, atol=1e-5, rtol=1e-5)
+
+
+def test_local_bfloat16_moe_preserves_small_expert_contributions():
+    # Accumulating these expert outputs in BF16 loses the first unit term.
+    # Route combination must accumulate before rounding back to compute dtype.
+    x = jnp.ones((2, 1), dtype=jnp.bfloat16)
+    selected = jnp.array([[0, 1, 2, 3], [3, 2, 1, 0]], dtype=jnp.int32)
+    up = jnp.ones((4, 1, 1), dtype=jnp.bfloat16)
+    down = jnp.array([256, 1, -256, 1], dtype=jnp.bfloat16).reshape(4, 1, 1)
+    output = jax.jit(
+        lambda x, up, down: moe_mlp(
+            x,
+            selected,
+            jnp.ones((2, 4), dtype=jnp.bfloat16),
+            up,
+            down,
+            token_valid=jnp.array([True, False]),
+            activation=ActivationFunctionEnum.relu2,
+            implementation="scatter",
+            mesh=None,
+        )
+    )(x, up, down)
+    np.testing.assert_array_equal(output.astype(jnp.float32), np.array([[2.0], [0.0]]))
+
+
