@@ -586,0 +596,81 @@ class LoweredMpmdFun:
+    def precompile_local(self, *local_args: Any) -> PrecompiledLocalExecution:
+        local_jaxpr = self._local_jaxpr
+        if len(local_args) != len(local_jaxpr.closed_jaxpr.invars):
+            raise ValueError(
+                "precompile_local expects arguments in "
+                "local_jaxpr.global_invar_indices order: expected "
+                f"{len(local_jaxpr.closed_jaxpr.invars)}, got {len(local_args)}"
+            )
+
+        recv_buffers: tuple[Any, ...] = ()
+        task_count = 0
+        with self.mpmd_mesh:
+            for eqn in local_jaxpr.closed_jaxpr.eqns:
+                if eqn.primitive is zeros_p:
+                    if recv_buffers:
+                        raise ValueError(
+                            "precompile_local supports one receive-buffer prologue"
+                        )
+                    recv_buffers = tuple(
+                        zeros_p.bind(**eqn.primitive.get_bind_params(eqn.params))
+                    )
+                    jax.block_until_ready(recv_buffers)
+                elif eqn.primitive is task_p:
+                    precompile_task(
+                        **eqn.primitive.get_bind_params(eqn.params)
+                    )
+                    task_count += 1
+
+        return PrecompiledLocalExecution(
+            local_jaxpr=local_jaxpr,
+            recv_buffers=recv_buffers,
+            task_count=task_count,
+        )
+
+    def eval_local_precompiled(
+        self,
+        execution: PrecompiledLocalExecution,
+        *local_args: Any,
+    ) -> list[Any]:
+        local_jaxpr = self._local_jaxpr
+        if execution.local_jaxpr is not local_jaxpr:
+            raise ValueError(
+                "precompiled execution belongs to a different local jaxpr"
+            )
+        if len(local_args) != len(local_jaxpr.closed_jaxpr.invars):
+            raise ValueError(
+                "eval_local_precompiled expects arguments in "
+                "local_jaxpr.global_invar_indices order: expected "
+                f"{len(local_jaxpr.closed_jaxpr.invars)}, got {len(local_args)}"
+            )
+
+        jaxpr = local_jaxpr.closed_jaxpr.jaxpr
+        if not execution.recv_buffers:
+            with self.mpmd_mesh:
+                return jcore.eval_jaxpr(
+                    jaxpr,
+                    local_jaxpr.closed_jaxpr.consts,
+                    *local_args,
+                )
+
+        zeros_eqn, *runtime_eqns = jaxpr.eqns
+        if zeros_eqn.primitive is not zeros_p:
+            raise ValueError(
+                "precompiled receive buffers require a leading zeros prologue"
+            )
+        if len(zeros_eqn.outvars) != len(execution.recv_buffers):
+            raise ValueError(
+                "precompiled receive-buffer count does not match zeros prologue"
+            )
+        runtime_jaxpr = jaxpr.replace(
+            invars=[*jaxpr.invars, *zeros_eqn.outvars],
+            eqns=runtime_eqns,
+        )
+        with self.mpmd_mesh:
+            return jcore.eval_jaxpr(
+                runtime_jaxpr,
+                local_jaxpr.closed_jaxpr.consts,
+                *local_args,
+                *execution.recv_buffers,
+            )
+
