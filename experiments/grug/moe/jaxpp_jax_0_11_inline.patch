+        jax.ShapeDtypeStruct(
+            aval.shape,
+            aval.dtype,
+            sharding=sharding,
+            weak_type=getattr(aval, "weak_type", False),
+        )
+        for aval, sharding in zip(
+            call_jaxpr.in_avals, in_shardings, strict=True
+        )
+    )
+    key = (jc.jit_p, params)
+    with jax.set_mesh(params.ctx_mesh):
+        compiled = callable_task(*key).lower(*abstract_args).compile()
+    _precompiled_callable_tasks[key] = compiled
+    return compiled
+
+
