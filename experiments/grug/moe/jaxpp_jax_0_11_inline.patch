+def precompile_task(
+    *,
+    call_jaxpr: jcore.ClosedJaxpr,
+    task_name,
+    task_info,
+    mpmd_idx,
+    in_shardings: tuple[jax.NamedSharding, ...],
+    out_shardings: tuple[jax.NamedSharding, ...],
+    donate_invars,
+    latency: float | None = None,
+    call_counter: int | None = None,
