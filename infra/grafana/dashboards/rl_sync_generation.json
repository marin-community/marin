    {
      "id": 236,
      "type": "timeseries",
      "title": "KV-cache utilisation",
      "description": "Mean and peak KV-cache occupancy across the run's engines, a gauge. Read it with the waiting-reason lines: a cache pinned near full while requests wait explains queueing that no amount of extra concurrency will clear, and a cache that stays empty says the engines had room the trainer never used.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "KV-cache in use"
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "No KV-cache gauge from this run's engines. Never an empty cache.",
          "displayName": "${__field.labels.series}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
