          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "identity_kind",
                "value": "run_id"
              },
              {
                "key": "identity",
                "value": "${run}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "bucket_ms",
                "value": "${__interval_ms}"
              },
              {
                "key": "view",
                "value": "latency"
              }
            ]
          },
          "columns": [
            {
              "selector": "metric",
              "text": "stage",
              "type": "string"
            },
            {
              "selector": "stat",
              "text": "quantile",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "seconds",
              "type": "number"
            },
