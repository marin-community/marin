{
  "uid": "marin-rl-sync-generation",
  "title": "RL Post-training (sync): generation",
  "description": "Why generation takes as long as it does. It is 57-66% of an E6 step and the half that moves: after the grouped-mm fix made training about 13x faster, generation did not move and the bottleneck relocated here. The driver's own view of the fan-out sits above what the serving engines report.",
  "tags": [
    "marin",
    "generated"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "links": [
    {
      "linkRef": "rl_post_training"
    },
    {
      "linkRef": "rl_sync_training_step"
    },
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Inference",
      "type": "link",
      "url": "/d/marin-inference"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "custom",
        "query": "cw-rno2a,cw-us-east-02a,cw-us-east-08a,marin,marin-dev",
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "finelog-marin"
        },
        "multi": false,
        "includeAll": false,
        "refresh": 2,
        "sort": 0,
        "current": {},
        "options": [],
        "query": {
          "queryType": "infinity",
          "refId": "variable-run",
          "infinityQuery": {
            "refId": "variable-run",
            "type": "json",
            "source": "url",
            "format": "table",
            "parser": "backend",
            "url": "/query",
            "url_options": {
              "method": "GET",
              "params": [
                {
                  "key": "sql",
                  "value": "SELECT run_id AS value FROM \"telemetry_v1.marinskyrl\" WHERE service = 'marinskyrl' AND name = 'policy_step' AND COALESCE(json_get(resource_attributes_json, 'training_loop'), '') <> 'async' AND COALESCE(NULLIF(\"cluster\", ''), 'marin') IN (${cluster:sqlstring}) AND timestamp_ms >= CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) AND timestamp_ms < CAST(EXTRACT(EPOCH FROM {{to}}) * 1000 AS BIGINT) AND run_id IS NOT NULL GROUP BY 1 ORDER BY MAX(timestamp_ms) DESC"
                },
                {
                  "key": "from",
                  "value": "${__from}"
                },
                {
                  "key": "to",
                  "value": "${__to}"
                }
              ]
            },
            "columns": [
              {
                "selector": "value",
                "text": "value",
                "type": "string"
              }
            ]
          }
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Does generation own this step?",
      "collapsed": false,
      "id": 300,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 305,
      "type": "timeseries",
      "title": "Generation against training, per step",
      "description": "The two halves of the step side by side. Generation is 57-66% of it and moves 95-139 s between steps; training is 21-27% and barely moves. The step range is generation's variance, not training's — which is why this board exists.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "mean seconds per step"
          },
          "unit": "s",
          "min": 0,
          "noValue": "No inclusive-wall driver rows under root='step'. This build publishes no step timings.",
          "displayName": "${__field.labels.series}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/v1/rl/generation",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "clusters",
                "value": "${cluster:csv}"
              },
              {
                "key": "run",
                "value": "${run}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "bucket_ms",
                "value": "${__interval_ms}"
              },
              {
                "key": "view",
                "value": "generation_vs_training"
              }
            ]
          },
          "columns": [
            {
              "selector": "t",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "series",
              "text": "series",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "value",
              "type": "number"
            }
          ]
        }
      ],
      "interval": "1m"
    },
    {
      "id": 302,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "panelRef": "rl_generate_breakdown"
    },
    {
      "id": 303,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "panelRef": "rl_trajectory_wait"
    },
    {
      "type": "row",
      "title": "Is it the tail, or the whole batch?",
      "collapsed": false,
      "id": 310,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 306,
      "type": "timeseries",
      "title": "How far the slowest trajectory runs past the mean",
      "description": "The longest single engine wait divided by the per-trajectory mean — about 7.6x on this run, a 93.6 s tail against a 12.3 s mean. Generation is tail-latency-bound: the step ends with the last trajectory, so the mean alone actively misleads.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "slowest ÷ mean"
          },
          "unit": "none",
          "min": 0,
          "noValue": "No rollout counters. This build does not instrument the generation coroutines."
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/v1/rl/generation",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "clusters",
                "value": "${cluster:csv}"
              },
              {
                "key": "run",
                "value": "${run}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "bucket_ms",
                "value": "${__interval_ms}"
              },
              {
                "key": "view",
                "value": "tail_over_mean"
              }
            ]
          },
          "columns": [
            {
              "selector": "t",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "tail_over_mean",
              "text": "tail_over_mean",
              "type": "number"
            }
          ]
        }
      ],
      "interval": "1m"
    },
    {
      "id": 304,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "panelRef": "rl_environment_wait_split"
    },
    {
      "id": 231,
      "type": "table",
      "title": "Generated tokens per request",
      "description": "Generated tokens per rollout request, as percentiles over the vLLM histogram. The step ends with the slowest sample, so the p99-over-p50 gap is what generation costs it, not the mean.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No request_generation_tokens histogram, in either the vllm namespace or the trainer's forwarded one.",
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/v1/vllm/overview",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "identity_kind",
                "value": "run_id"
              },
              {
                "key": "identity",
                "value": "${run}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "bucket_ms",
                "value": "${__interval_ms}"
              },
              {
                "key": "view",
                "value": "workload"
              }
            ]
          },
          "columns": [
            {
              "selector": "stat",
              "text": "quantile",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "tokens/request",
              "type": "number"
            },
            {
              "selector": "samples",
              "text": "requests",
              "type": "number"
            }
          ],
          "filterExpression": "stat == 'p50' || stat == 'p90' || stat == 'p99'"
        }
      ],
      "interval": "1m"
    },
    {
      "type": "row",
      "title": "Is the engine slow, or is nothing reaching it?",
      "collapsed": false,
      "id": 320,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 232,
      "type": "timeseries",
      "title": "Time to first token and inter-token latency",
      "description": "Prefill responsiveness and decode speed. Inter-token latency times the p99 length is the floor on the generate phase at any concurrency. Only TTFT survives the trainer's forwarder, so the ITL lines are often absent.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "seconds"
          },
          "unit": "s",
          "min": 0,
          "noValue": "Neither histogram reached finelog from this run's engines. Never an instant prefill.",
          "displayName": "${__field.labels.series}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/v1/vllm/overview",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "identity_kind",
                "value": "run_id"
              },
              {
                "key": "identity",
                "value": "${run}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "bucket_ms",
                "value": "${__interval_ms}"
              },
              {
                "key": "view",
                "value": "latency"
              }
            ]
          },
          "columns": [
            {
              "selector": "t",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "series",
              "text": "series",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "value",
              "type": "number"
            },
            {
              "selector": "metric",
              "text": "metric",
              "type": "string"
            },
            {
              "selector": "stat",
              "text": "stat",
              "type": "string"
            }
          ],
          "filterExpression": "stat == 'mean_over_time' && (metric == 'ttft' || metric == 'inter_token_latency')"
        }
      ],
      "interval": "1m"
    },
    {
      "id": 233,
      "type": "table",
      "title": "Request latency by stage",
      "description": "Where a request's wall goes inside the engine, as percentiles: queue, prefill, decode, end to end. Queue large against decode is an admission problem, not a slow model. Means and gauges for the same stages are on RL runs.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No per-stage latency histograms. The generate row above reports the same wait from the driver's side.",
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/v1/vllm/overview",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "identity_kind",
                "value": "run_id"
              },
              {
                "key": "identity",
                "value": "${run}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "bucket_ms",
                "value": "${__interval_ms}"
              },
              {
                "key": "view",
                "value": "latency"
              }
            ]
          },
          "columns": [
            {
              "selector": "metric",
              "text": "stage",
              "type": "string"
            },
            {
              "selector": "stat",
              "text": "quantile",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "seconds",
              "type": "number"
            },
            {
              "selector": "samples",
              "text": "requests",
              "type": "number"
            }
          ],
          "filterExpression": "(metric == 'queue' || metric == 'decode' || metric == 'e2e') && (stat == 'p50' || stat == 'p99')"
        }
      ],
      "interval": "1m"
    },
    {
      "id": 234,
      "type": "timeseries",
      "title": "Engine queue depth and why requests are waiting",
      "description": "Queue depth and the requests held back by each reason, summed across engines. A queue that never fills while the step waits is under-subscription; waiting on KV-cache is the opposite.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
