    {
      "id": 304,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "panelRef": "rl_environment_wait_split"
    },
    {
      "id": 231,
      "type": "table",
      "title": "vLLM generated tokens per request",
      "description": "p50, p90 and p99 of vLLM `request_generation_tokens` over the whole time range. `generate` waits for its longest requests, so compare p99 with p50.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No request_generation_tokens histogram from this run's vLLM engines. vLLM detail needs a time range of 7 hours or less.",
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/v1/vllm/overview",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "identity_kind",
                "value": "run_id"
              },
              {
                "key": "identity",
                "value": "${run}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "bucket_ms",
                "value": "${__interval_ms}"
              },
              {
                "key": "view",
                "value": "workload"
              }
            ]
          },
          "columns": [
            {
              "selector": "stat",
              "text": "quantile",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "tokens/request",
              "type": "number"
            },
            {
              "selector": "samples",
              "text": "requests",
              "type": "number"
            }
          ],
          "filterExpression": "stat == 'p50' || stat == 'p90' || stat == 'p99'"
        }
      ],
      "interval": "1m"
    },
    {
      "type": "row",
