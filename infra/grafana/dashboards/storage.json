{
  "uid": "marin-storage",
  "title": "Storage",
  "description": "Daily CoreWeave object-storage usage from the cost collector.",
  "tags": [
    "marin",
    "storage"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 42,
  "refresh": "1h",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "title": "Home",
      "type": "link",
      "url": "/d/marin-home"
    },
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "title": "Infra",
      "type": "link",
      "url": "/d/infra"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CoreWeave object storage by bucket",
      "description": "Last recorded byte value for each UTC day. The collector refreshes the trailing three days on each run.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/query",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "sql",
                "value": "SELECT ts AS t, detail AS series, usage_amount AS value FROM (SELECT ts, usage_date, provider, category, region, detail, usage_amount, usage_unit, ROW_NUMBER() OVER (PARTITION BY usage_date, provider, category, region, detail ORDER BY seq DESC) AS rn FROM \"cost.events\" WHERE provider = 'coreweave' AND category = 'storage' AND usage_unit = 'bytes' AND ts >= {{from}} AND ts < {{to}}) WHERE rn = 1 ORDER BY 1, 2"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "columns": [
            {
              "selector": "t",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "series",
              "text": "series",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "value",
              "type": "number"
            }
          ]
        }
      ]
    }
  ]
}
