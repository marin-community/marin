{
  "uid": "marin-runs",
  "title": "Runs",
  "description": "How each Levanter training run is doing, from the telemetry_v1 stream every JAX process reports. Runs are identified by root_run_uid. Only clusters whose jobs compose the Levanter tracker appear -- today that is the CoreWeave GPU clusters; the GCE TPU cluster runs tasks but reports no Levanter metrics.",
  "tags": [
    "marin",
    "generated"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "custom",
        "description": "The clusters the bridge serves (infra/grafana/src/config.py). A custom list rather than a query so a cluster that has gone silent -- exactly when you want to select it -- is still in the dropdown.",
        "query": "cw-rno2a,cw-us-east-02a,cw-us-east-08a,cw-us-west-04a,marin,marin-dev",
        "options": [
          {
            "selected": false,
            "text": "cw-rno2a",
            "value": "cw-rno2a"
          },
          {
            "selected": false,
