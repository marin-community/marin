      "id": 7,
      "type": "timeseries",
      "title": "GPU power by selected run",
      "description": "Watts drawn by the GPUs on the nodes each selected run occupies, attributed per bucket. Power flat while step time climbs is a run spinning without computing.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 22,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
