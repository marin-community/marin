  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Active runs",
      "description": "One row per Levanter run reporting in the last 15 minutes. Sample age is the stall signal: a run whose telemetry is minutes old has stopped stepping. Start here, then narrow the run selector.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sample age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 300
                    },
                    {
                      "color": "red",
                      "value": 900
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tokens/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "sample age",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/query",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "sql",
                "value": "SELECT json_get(resource_attributes_json, 'root_run_uid') AS run, COALESCE(NULLIF(\"cluster\", ''), 'marin') AS cluster, COUNT(DISTINCT json_get(resource_attributes_json, 'node_name')) AS nodes, COUNT(DISTINCT json_get(resource_attributes_json, 'process_index')) AS processes, MAX(CASE WHEN name = 'global_step' THEN value END) AS step, AVG(CASE WHEN name = 'throughput_mfu' THEN value END) AS mfu, AVG(CASE WHEN name = 'throughput_tokens_per_second' THEN value END) AS tokens_per_second, MIN(CASE WHEN name = 'train_loss' THEN value END) AS best_loss, (CAST(EXTRACT(EPOCH FROM now()) * 1000 AS BIGINT) - MAX(timestamp_ms)) / 1000.0 AS sample_age_seconds FROM \"telemetry_v1\" WHERE service = 'levanter' AND name IN ('global_step', 'throughput_mfu', 'throughput_tokens_per_second', 'train_loss') AND json_get(resource_attributes_json, 'root_run_uid') IN (${run:sqlstring}) AND COALESCE(NULLIF(\"cluster\", ''), 'marin') IN (${cluster:sqlstring}) AND timestamp_ms >= CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) AND timestamp_ms < CAST(EXTRACT(EPOCH FROM {{to}}) * 1000 AS BIGINT) GROUP BY 1, 2 ORDER BY 5 DESC"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "columns": [
            {
              "selector": "run",
              "text": "run",
              "type": "string"
            },
            {
              "selector": "cluster",
              "text": "cluster",
              "type": "string"
            },
            {
              "selector": "nodes",
              "text": "nodes",
              "type": "number"
            },
            {
              "selector": "processes",
              "text": "processes",
              "type": "number"
            },
            {
              "selector": "step",
              "text": "step",
              "type": "number"
            },
            {
              "selector": "mfu",
              "text": "MFU %",
              "type": "number"
            },
            {
              "selector": "tokens_per_second",
              "text": "tokens/s",
              "type": "number"
            },
            {
              "selector": "best_loss",
              "text": "best loss",
              "type": "number"
            },
            {
              "selector": "sample_age_seconds",
              "text": "sample age",
              "type": "number"
            }
          ]
        }
      ],
      "timeFrom": "15m"
    },
