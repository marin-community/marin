{
  "uid": "marin-runs",
  "title": "Runs",
  "description": "How each Levanter training run is doing, from its semantic telemetry stream. Runs are identified by run_id. Only process zero reports Levanter metrics. Only clusters whose jobs compose the Levanter tracker appear -- today that is the CoreWeave GPU clusters; the GCE TPU cluster runs tasks but reports no Levanter metrics.",
  "tags": [
    "marin",
    "generated"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "custom",
        "description": "The clusters the bridge serves (infra/grafana/src/config.py). A custom list rather than a query so a cluster that has gone silent -- exactly when you want to select it -- is still in the dropdown.",
        "query": "cw-rno2a,cw-us-east-02a,cw-us-east-08a,marin,marin-dev",
        "options": [
          {
            "selected": false,
            "text": "cw-rno2a",
            "value": "cw-rno2a"
          },
          {
            "selected": false,
            "text": "cw-us-east-02a",
            "value": "cw-us-east-02a"
          },
          {
            "selected": false,
            "text": "cw-us-east-08a",
            "value": "cw-us-east-08a"
          },
          {
            "selected": false,
            "text": "marin",
            "value": "marin"
          },
          {
            "selected": false,
            "text": "marin-dev",
            "value": "marin-dev"
          }
        ],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "includeAll": true,
        "multi": true,
        "hide": 0,
        "refresh": 0
      },
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "description": "Levanter runs that reported a step inside the dashboard window.",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "finelog-marin"
        },
        "definition": "WITH telemetry AS (SELECT * FROM \"levanter.metrics\") SELECT DISTINCT run_id AS value FROM telemetry WHERE step IS NOT NULL",
        "query": {
          "queryType": "infinity",
          "refId": "variable-run",
          "infinityQuery": {
            "refId": "variable-run",
            "type": "json",
            "source": "url",
            "format": "table",
            "parser": "backend",
            "url": "/query",
            "url_options": {
              "method": "GET",
              "params": [
                {
                  "key": "sql",
                  "value": "WITH telemetry AS (SELECT * FROM \"levanter.metrics\") SELECT DISTINCT run_id AS value FROM telemetry WHERE step IS NOT NULL AND COALESCE(NULLIF(\"cluster\", ''), 'marin') IN (${cluster:sqlstring}) AND timestamp_ms >= CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) AND timestamp_ms < CAST(EXTRACT(EPOCH FROM {{to}}) * 1000 AS BIGINT) AND run_id IS NOT NULL ORDER BY 1"
                },
                {
                  "key": "from",
                  "value": "${__from}"
                },
                {
                  "key": "to",
                  "value": "${__to}"
                }
              ]
            },
            "columns": [
              {
                "selector": "value",
                "text": "value",
                "type": "string"
              }
            ]
          }
        },
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "hide": 0
      }
    ]
  },
