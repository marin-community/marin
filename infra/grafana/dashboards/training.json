      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/query",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "sql",
                "value": "SELECT MAX(CASE WHEN name = 'phase' THEN value END) AS phase, MAX(CASE WHEN name = 'step' THEN value END) AS step, MAX(CASE WHEN name = 'run_progress' THEN value END) AS progress, (CAST(EXTRACT(EPOCH FROM now()) * 1000 AS BIGINT) - CAST(MAX(CASE WHEN name = 'progress_time_seconds' THEN value END) * 1000 AS BIGINT)) / 1000.0 AS since_last_step, AVG(CASE WHEN name = 'throughput_duration' THEN value END) AS step_time, AVG(CASE WHEN name = 'throughput_mfu' THEN value END) AS mfu, AVG(CASE WHEN name = 'throughput_tokens_per_second' THEN value END) AS tokens_per_second, MAX(CASE WHEN name = 'throughput_total_tokens' THEN value END) AS total_tokens, AVG(CASE WHEN name = 'train_loss' THEN value END) AS train_loss, (CAST(EXTRACT(EPOCH FROM now()) * 1000 AS BIGINT) - MAX(timestamp_ms)) / 1000.0 AS sample_age_seconds FROM \"telemetry_v1\" WHERE service = 'levanter' AND name IN ('phase', 'step', 'run_progress', 'progress_time_seconds', 'throughput_duration', 'throughput_mfu', 'throughput_tokens_per_second', 'throughput_total_tokens', 'train_loss') AND run_id IN (${run:sqlstring}) AND timestamp_ms >= CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) AND timestamp_ms < CAST(EXTRACT(EPOCH FROM {{to}}) * 1000 AS BIGINT)"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
