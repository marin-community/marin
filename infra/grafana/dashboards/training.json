            },
            {
              "selector": "step",
              "text": "step",
              "type": "number"
            },
            {
              "selector": "slowest",
              "text": "slowest step",
              "type": "number"
            },
            {
              "selector": "loading",
              "text": "loading",
              "type": "number"
            },
            {
              "selector": "hooks",
              "text": "hooks",
              "type": "number"
            }
          ]
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Throughput",
      "description": "Model FLOP utilization on the left axis and token rate on the right. MFU is the throughput-regression signal that moves before loss does; tokens per second falls with it on a slowdown and without it on a smaller job.",
      "datasource": {
