                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/query",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "sql",
                "value": "SELECT date_bin(INTERVAL '${__interval_ms} milliseconds', to_timestamp_millis(timestamp_ms)) AS t, AVG(CASE WHEN name = 'throughput_duration' THEN value END) AS step, MAX(CASE WHEN name = 'throughput_duration' THEN value END) AS slowest, AVG(CASE WHEN name = 'throughput_loading_time' THEN value END) AS loading, AVG(CASE WHEN name = 'throughput_hook_time' THEN value END) AS hooks FROM \"telemetry_v1\" WHERE service = 'levanter' AND name IN ('throughput_duration', 'throughput_loading_time', 'throughput_hook_time') AND run_id IN (${run:sqlstring}) AND timestamp_ms >= CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) AND timestamp_ms < CAST(EXTRACT(EPOCH FROM {{to}}) * 1000 AS BIGINT) GROUP BY 1 ORDER BY 1"
              },
              {
