{
  "uid": "marin-training",
  "title": "Training telemetry",
  "description": "Levanter gauges exported directly to Finelog telemetry_v1. Series use the tracker run, falling back to Iris job identity. Producer time is stored as epoch milliseconds and converted only for display and binning.",
  "tags": [
    "marin",
    "generated"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "datasource",
        "query": "yesoreyeram-infinity-datasource",
        "current": {
          "text": "finelog-marin",
          "value": "finelog-marin"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Training loss by run",
      "description": "train_loss from service=levanter, averaged per time bin for each run.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${cluster}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/query",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "sql",
                "value": "SELECT date_bin(INTERVAL '${__interval_ms} milliseconds', to_timestamp_millis(timestamp_ms)) AS t, COALESCE(json_get(resource_attributes_json, 'run'), json_get(resource_attributes_json, 'job_id'), 'unknown') AS series, AVG(value) AS value FROM \"telemetry_v1\" WHERE service = 'levanter' AND name = 'train_loss' AND timestamp_ms >= CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) AND timestamp_ms < CAST(EXTRACT(EPOCH FROM {{to}}) * 1000 AS BIGINT) GROUP BY 1, 2 ORDER BY 1"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "columns": [
            {
              "selector": "t",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "series",
              "text": "run",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "loss",
              "type": "number"
            }
          ]
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Throughput by run",
      "description": "throughput_tokens_per_second from service=levanter, averaged per time bin for each run.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${cluster}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/query",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "sql",
                "value": "SELECT date_bin(INTERVAL '${__interval_ms} milliseconds', to_timestamp_millis(timestamp_ms)) AS t, COALESCE(json_get(resource_attributes_json, 'run'), json_get(resource_attributes_json, 'job_id'), 'unknown') AS series, AVG(value) AS value FROM \"telemetry_v1\" WHERE service = 'levanter' AND name = 'throughput_tokens_per_second' AND timestamp_ms >= CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) AND timestamp_ms < CAST(EXTRACT(EPOCH FROM {{to}}) * 1000 AS BIGINT) GROUP BY 1, 2 ORDER BY 1"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "columns": [
            {
              "selector": "t",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "series",
              "text": "run",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "throughput",
              "type": "number"
            }
          ]
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Training step by run",
      "description": "step from service=levanter (the most recent training step logged) per run.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${cluster}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/query",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "sql",
                "value": "SELECT date_bin(INTERVAL '${__interval_ms} milliseconds', to_timestamp_millis(timestamp_ms)) AS t, COALESCE(json_get(resource_attributes_json, 'run'), json_get(resource_attributes_json, 'job_id'), 'unknown') AS series, MAX(value) AS value FROM \"telemetry_v1\" WHERE service = 'levanter' AND name = 'step' AND timestamp_ms >= CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) AND timestamp_ms < CAST(EXTRACT(EPOCH FROM {{to}}) * 1000 AS BIGINT) GROUP BY 1, 2 ORDER BY 1"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "columns": [
            {
              "selector": "t",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "series",
              "text": "run",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "step",
              "type": "number"
            }
          ]
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Telemetry services over the window",
      "description": "Distinct metric names and total samples per service in telemetry_v1.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${cluster}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/query",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "sql",
                "value": "SELECT service, COUNT(DISTINCT name) AS metrics, COUNT(*) AS samples FROM \"telemetry_v1\" WHERE timestamp_ms >= CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) AND timestamp_ms < CAST(EXTRACT(EPOCH FROM {{to}}) * 1000 AS BIGINT) GROUP BY service ORDER BY samples DESC"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "columns": [
            {
              "selector": "service",
              "text": "service",
              "type": "string"
            },
            {
              "selector": "metrics",
              "text": "metrics",
              "type": "number"
            },
            {
              "selector": "samples",
              "text": "samples",
              "type": "number"
            }
          ]
        }
      ]
    }
  ]
}
