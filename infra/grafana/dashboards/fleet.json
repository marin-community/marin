{
  "uid": "marin-fleet",
  "title": "Fleet",
  "description": "Worker fleet and canary health, from the infra.canary.metrics finelog namespace that infra/probes writes.",
  "tags": ["marin", "generated"],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "datasource",
        "query": "yesoreyeram-infinity-datasource",
        "current": { "text": "finelog-marin", "value": "finelog-marin" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Healthy workers by region",
      "description": "worker_healthy{region=...}. The region label is grouped by the bridge: finelog's engine (DataFusion) has no JSON functions, so labels cannot be grouped in SQL.",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${cluster}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/series",
          "url_options": {
            "method": "GET",
            "params": [
              { "key": "metric", "value": "worker_healthy" },
              { "key": "group_by", "value": "region" },
              { "key": "from", "value": "${__from}" },
              { "key": "to", "value": "${__to}" }
            ]
          },
          "columns": [
            { "selector": "time", "text": "time", "type": "timestamp_epoch_ms" },
            { "selector": "series", "text": "region", "type": "string" },
            { "selector": "value", "text": "workers", "type": "number" }
          ]
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Fleet TPU chips",
      "description": "worker_tpu_chips{scope=fleet}. The scope=fleet filter selects the rollup row probes emits alongside the per-region rows.",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${cluster}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/series",
          "url_options": {
            "method": "GET",
            "params": [
              { "key": "metric", "value": "worker_tpu_chips" },
              { "key": "label.scope", "value": "fleet" },
              { "key": "from", "value": "${__from}" },
              { "key": "to", "value": "${__to}" }
            ]
          },
          "columns": [
            { "selector": "time", "text": "time", "type": "timestamp_epoch_ms" },
            { "selector": "series", "text": "metric", "type": "string" },
            { "selector": "value", "text": "chips", "type": "number" }
          ]
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Canary probe health",
      "description": "probe_up per check: 1 healthy, 0 failing. Grouped by the probe name label.",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${cluster}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "max": 1, "custom": { "drawStyle": "line", "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/series",
          "url_options": {
            "method": "GET",
            "params": [
              { "key": "metric", "value": "probe_up" },
              { "key": "group_by", "value": "probe" },
              { "key": "from", "value": "${__from}" },
              { "key": "to", "value": "${__to}" }
            ]
          },
          "columns": [
            { "selector": "time", "text": "time", "type": "timestamp_epoch_ms" },
            { "selector": "series", "text": "probe", "type": "string" },
            { "selector": "value", "text": "up", "type": "number" }
          ]
        }
      ]
    }
  ]
}
