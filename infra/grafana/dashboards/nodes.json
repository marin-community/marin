      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "description": "GPU nodes that reported inventory inside the dashboard window.",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "finelog-marin"
        },
        "definition": "GPU nodes reporting hardware_inventory in the selected clusters",
        "query": {
          "queryType": "infinity",
          "refId": "variable-node",
          "infinityQuery": {
            "refId": "variable-node",
            "type": "json",
            "source": "url",
            "format": "table",
            "parser": "backend",
            "url": "/query",
            "url_options": {
              "method": "GET",
              "params": [
                {
                  "key": "sql",
                  "value": "SELECT DISTINCT json_get(attributes_json, 'node_name') AS value FROM \"telemetry_v1\" WHERE service = 'iris-node-agent' AND name = 'hardware_inventory' AND json_get(attributes_json, 'device_kind') = 'gpu' AND COALESCE(NULLIF(\"cluster\", ''), 'marin') IN (${cluster:sqlstring}) AND timestamp_ms >= CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) AND timestamp_ms < CAST(EXTRACT(EPOCH FROM {{to}}) * 1000 AS BIGINT) ORDER BY 1"
                },
                {
                  "key": "from",
                  "value": "${__from}"
                },
                {
                  "key": "to",
                  "value": "${__to}"
                }
              ]
            },
            "columns": [
              {
                "selector": "value",
                "text": "value",
                "type": "string"
              }
            ]
          }
        },
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": [],
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "hide": 0
      }
    ]
  },
