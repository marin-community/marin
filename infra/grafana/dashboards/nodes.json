    {
      "id": 2,
      "type": "timeseries",
      "title": "GPU engine activity",
      "description": "Per-GPU utilization, SM activity, and tensor-pipe activity. SM activity is the fraction of time at least one warp was active on a streaming multiprocessor; 80% is necessary but not sufficient for effective use.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/query",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "sql",
                "value": "SELECT date_bin(INTERVAL '${__interval_ms} milliseconds', to_timestamp_millis(timestamp_ms)) AS t, 'GPU ' || json_get(attributes_json, 'gpu_index') || ' · ' || CASE name WHEN 'gpu_utilization_percent' THEN 'utilization' WHEN 'gpu_sm_active_ratio' THEN 'SM active' ELSE 'tensor active' END AS series, AVG(CASE WHEN name = 'gpu_utilization_percent' THEN value ELSE value * 100.0 END) AS value FROM \"telemetry_v1\" WHERE service = 'iris-node-agent' AND name IN ('gpu_utilization_percent', 'gpu_sm_active_ratio', 'gpu_tensor_active_ratio') AND json_get(attributes_json, 'node_name') IN (${node:sqlstring}) AND COALESCE(NULLIF(\"cluster\", ''), 'marin') IN (${cluster:sqlstring}) AND timestamp_ms >= CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) AND timestamp_ms < CAST(EXTRACT(EPOCH FROM {{to}}) * 1000 AS BIGINT) GROUP BY 1, 2 ORDER BY 1"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "columns": [
            {
              "selector": "t",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "series",
              "text": "series",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "value",
              "type": "number"
            }
          ]
        }
      ],
      "interval": "1m"
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GPU temperatures",
      "description": "Per-GPU core and HBM temperatures. The memory-temperature series appears only on exporters that expose DCGM_FI_DEV_MEMORY_TEMP.",
