                "value": "SELECT json_get(attributes_json, 'gpu_index') AS gpu, json_get(attributes_json, 'gpu_uuid') AS uuid, json_get(attributes_json, 'pci_bus_id') AS pci_bus, MAX(json_get(attributes_json, 'gpu_model')) AS model, MAX(json_get(attributes_json, 'driver_version')) AS driver, (CAST(EXTRACT(EPOCH FROM now()) * 1000 AS BIGINT) - MAX(timestamp_ms)) / 1000.0 AS lag FROM \"telemetry_v1\" WHERE service = 'iris-node-agent' AND name = 'hardware_inventory' AND json_get(attributes_json, 'device_kind') = 'gpu' AND json_get(attributes_json, 'node_name') IN (${node:sqlstring}) AND COALESCE(NULLIF(\"cluster\", ''), 'marin') IN (${cluster:sqlstring}) AND timestamp_ms >= CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) AND timestamp_ms < CAST(EXTRACT(EPOCH FROM {{to}}) * 1000 AS BIGINT) GROUP BY 1, 2, 3 ORDER BY 1"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
