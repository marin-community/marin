    {
      "id": 7,
      "type": "timeseries",
      "title": "Host utilization",
      "description": "Node CPU, memory, and local-disk utilization. Memory and disk are derived from paired used and total gauges.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/query",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "sql",
                "value": "WITH raw AS ( SELECT date_bin(INTERVAL '${__interval_ms} milliseconds', to_timestamp_millis(timestamp_ms)) AS t, name, AVG(value) AS value FROM \"telemetry_v1\" WHERE service = 'iris-node-agent' AND name IN ('node_cpu_utilization_percent', 'node_memory_used_bytes', 'node_memory_total_bytes', 'node_disk_used_bytes', 'node_disk_total_bytes') AND json_get(attributes_json, 'node_name') IN (${node:sqlstring}) AND COALESCE(NULLIF(\"cluster\", ''), 'marin') IN (${cluster:sqlstring}) AND timestamp_ms >= CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) AND timestamp_ms < CAST(EXTRACT(EPOCH FROM {{to}}) * 1000 AS BIGINT) GROUP BY 1, 2 ) SELECT t, 'CPU' AS series, MAX(CASE WHEN name = 'node_cpu_utilization_percent' THEN value END) AS value FROM raw GROUP BY 1 UNION ALL SELECT t, 'memory' AS series, 100.0 * MAX(CASE WHEN name = 'node_memory_used_bytes' THEN value END) / NULLIF(MAX(CASE WHEN name = 'node_memory_total_bytes' THEN value END), 0) AS value FROM raw GROUP BY 1 UNION ALL SELECT t, 'local disk' AS series, 100.0 * MAX(CASE WHEN name = 'node_disk_used_bytes' THEN value END) / NULLIF(MAX(CASE WHEN name = 'node_disk_total_bytes' THEN value END), 0) AS value FROM raw GROUP BY 1 ORDER BY 1"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "columns": [
            {
              "selector": "t",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "series",
              "text": "series",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "value",
              "type": "number"
            }
          ]
        }
      ],
      "interval": "1m"
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Host network throughput",
      "description": "Receive and transmit rates derived from node-exporter's cumulative physical-interface counters. Counter identity prevents an agent restart from joining two boots.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/query",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "sql",
                "value": "WITH samples AS ( SELECT timestamp_ms, name, value, LAG(value) OVER (PARTITION BY name, json_get(attributes_json, 'source_replica_uid') ORDER BY timestamp_ms) AS prior_value FROM \"telemetry_v1\" WHERE service = 'iris-node-agent' AND name IN ('node_network_receive_bytes', 'node_network_transmit_bytes') AND json_get(attributes_json, 'node_name') IN (${node:sqlstring}) AND COALESCE(NULLIF(\"cluster\", ''), 'marin') IN (${cluster:sqlstring}) AND timestamp_ms >= CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) - ${__interval_ms} AND timestamp_ms < CAST(EXTRACT(EPOCH FROM {{to}}) * 1000 AS BIGINT) ) SELECT date_bin(INTERVAL '${__interval_ms} milliseconds', to_timestamp_millis(timestamp_ms)) AS t, CASE name WHEN 'node_network_receive_bytes' THEN 'receive' ELSE 'transmit' END AS series, SUM(CASE WHEN value >= prior_value THEN value - prior_value ELSE 0 END) * 1000.0 / ${__interval_ms} AS value FROM samples WHERE timestamp_ms >= CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) GROUP BY 1, 2 ORDER BY 1"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "columns": [
            {
              "selector": "t",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "series",
              "text": "series",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "value",
              "type": "number"
            }
          ]
        }
      ],
      "interval": "1m"
    },
    {
