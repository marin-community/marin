{
  "uid": "marin-pipelines",
  "title": "Pipelines",
  "description": "Zephyr throughput and shard memory, scoped to one execution. zephyr.worker carries a row per shard per sample interval; zephyr.stage carries one row per stage completion.",
  "tags": [
    "marin",
    "generated"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "custom",
        "description": "The clusters the bridge serves (infra/grafana/src/config.py). A custom list rather than a query so a cluster that has gone silent -- exactly when you want to select it -- is still in the dropdown.",
        "query": "cw-rno2a,cw-us-east-02a,cw-us-east-08a,cw-us-west-04a,marin,marin-dev",
        "options": [
          {
            "selected": false,
            "text": "cw-rno2a",
            "value": "cw-rno2a"
          },
          {
            "selected": false,
            "text": "cw-us-east-02a",
            "value": "cw-us-east-02a"
          },
          {
            "selected": false,
            "text": "cw-us-east-08a",
            "value": "cw-us-east-08a"
          },
          {
            "selected": false,
            "text": "cw-us-west-04a",
            "value": "cw-us-west-04a"
          },
          {
            "selected": false,
            "text": "marin",
            "value": "marin"
          },
          {
            "selected": false,
            "text": "marin-dev",
            "value": "marin-dev"
          }
        ],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "includeAll": true,
        "multi": true,
        "hide": 0,
        "refresh": 0
      },
      {
        "name": "execution",
        "label": "Execution",
        "type": "query",
        "description": "Zephyr executions with shard samples inside the dashboard window.",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "finelog-marin"
        },
        "definition": "SELECT DISTINCT execution_id AS value FROM \"zephyr.worker\" WHERE COALESCE(NULLIF(\"cluster\", ''), 'marin') IN (${cluster:",
        "query": {
          "queryType": "infinity",
          "refId": "variable-execution",
          "infinityQuery": {
            "refId": "variable-execution",
            "type": "json",
            "source": "url",
            "format": "table",
            "parser": "backend",
            "url": "/query",
            "url_options": {
              "method": "GET",
              "params": [
                {
                  "key": "sql",
                  "value": "SELECT DISTINCT execution_id AS value FROM \"zephyr.worker\" WHERE COALESCE(NULLIF(\"cluster\", ''), 'marin') IN (${cluster:sqlstring}) AND ts >= {{from}} AND ts < {{to}} ORDER BY 1"
                },
                {
                  "key": "from",
                  "value": "${__from}"
                },
                {
                  "key": "to",
                  "value": "${__to}"
                }
              ]
            },
            "columns": [
              {
                "selector": "value",
                "text": "value",
                "type": "string"
              }
            ]
          }
        },
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "hide": 0
      }
    ]
  },
