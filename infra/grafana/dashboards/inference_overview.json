{
  "uid": "marin-inference-overview",
  "title": "Inference overview",
  "description": "Is inference progressing, and is there evidence of pressure or slow responses? One serve/run, existing telemetry only. Open diagnostics for engine comparisons and latency tails.",
  "tags": [
    "marin",
    "inference",
    "vllm"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "2m",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "identity_kind",
        "label": "Identity kind",
        "type": "custom",
        "query": "job_id,run_id,execution_uid",
        "current": {
          "text": "job_id",
          "value": "job_id"
        },
        "options": [
          {
            "selected": true,
            "text": "job_id",
            "value": "job_id"
          },
          {
            "selected": false,
            "text": "run_id",
            "value": "run_id"
          },
          {
            "selected": false,
            "text": "execution_uid",
            "value": "execution_uid"
          }
        ]
      },
      {
        "name": "identity",
        "label": "Serve",
        "type": "query",
        "description": "Standalone vLLM and MarinSkyRL serves with request-state telemetry. For ranges over seven hours, the list scans only the first seven hours; paste an exact ID into Manual serve ID for later sessions.",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "finelog-marin"
        },
        "definition": "distinct ${identity_kind} from indexed request-state rows",
        "query": {
          "queryType": "infinity",
          "refId": "variable-identity",
          "infinityQuery": {
            "refId": "variable-identity",
            "type": "json",
            "source": "url",
            "format": "table",
            "parser": "backend",
            "url": "/query",
            "url_options": {
              "method": "GET",
              "params": [
                {
                  "key": "sql",
                  "value": "WITH sessions AS (SELECT job_id, run_id, execution_uid, timestamp_ms FROM \"telemetry_v1.vllm\" WHERE service = 'vllm' AND name = 'num_requests_running' UNION ALL SELECT job_id, run_id, execution_uid, timestamp_ms FROM \"telemetry_v1.marinskyrl\" WHERE service = 'marinskyrl' AND name = 'num_requests_running' AND json_get(attributes_json, 'metric_source') = 'vllm') SELECT DISTINCT CASE '${identity_kind}' WHEN 'job_id' THEN job_id WHEN 'run_id' THEN run_id WHEN 'execution_uid' THEN execution_uid END AS value FROM sessions WHERE timestamp_ms >= CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) AND timestamp_ms < CAST(EXTRACT(EPOCH FROM {{to}}) * 1000 AS BIGINT) AND timestamp_ms < CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) + 25200000 AND CASE '${identity_kind}' WHEN 'job_id' THEN job_id WHEN 'run_id' THEN run_id WHEN 'execution_uid' THEN execution_uid END IS NOT NULL ORDER BY 1"
                },
                {
                  "key": "from",
                  "value": "${__from}"
                },
                {
                  "key": "to",
                  "value": "${__to}"
                }
              ]
            },
            "columns": [
              {
                "selector": "value",
                "text": "value",
                "type": "string"
              }
            ]
          }
        },
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": [],
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "hide": 0
      },
      {
        "name": "identity_override",
        "label": "Manual serve ID (optional)",
        "type": "textbox",
        "description": "Paste an exact job, run, or execution ID when a long-range picker slice omits it. This takes precedence over Serve.",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "Select one serve and time range. **Run triage** separates query health from a selected-range server count cue. A count gap needs range and evaluator checks. Above seven hours, zoom for engine and latency detail. Use **Manual serve ID** if the picker omits a later session. Open **Inference diagnostics** for the serve and evaluator Iris links."
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      }
    },
    {
      "panelRef": "inference_status",
      "id": 19,
