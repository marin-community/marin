        "x": 0,
        "y": 4,
        "w": 24,
        "h": 4
      }
    },
    {
      "type": "table",
      "title": "Observed server summary",
      "description": "Selected-range totals use reset-aware engine counters. Peaks are observed samples; native ITL is a token-weighted mean. This summary omits latency tails, output-length distribution, per-engine detail, and client/proxy time.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No summary values; see query status"
