{
  "type": "row",
  "title": "Which diagnostics explain missing or stalled work?",
  "collapsed": true,
  "panels": [
    {
      "id": 101,
      "type": "table",
      "title": "Services reporting this run",
      "description": "Services, roles and metric sources reporting this run, with their latest observation times. Missing expected services or old records can explain blank panels; the expected set depends on the workload and whether engines report independently or through the trainer. The node agent has no run id and is absent here. Run-wide: this panel ignores the Job and Execution pickers.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "x": 0,
        "y": 100,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "No services under this run_id in this window."
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "last_record_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/v1/rl/producers",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "run",
                "value": "${run}"
              },
              {
                "key": "clusters",
                "value": "${cluster:csv}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "columns": [
            {
              "selector": "producer",
              "text": "service",
              "type": "string"
            },
            {
              "selector": "role",
              "text": "role",
              "type": "string"
            },
            {
              "selector": "attempt",
              "text": "attempt",
              "type": "string"
            },
            {
              "selector": "metric_source",
              "text": "metric_source",
              "type": "string"
            },
            {
              "selector": "signals",
              "text": "signals",
              "type": "number"
            },
            {
              "selector": "records",
              "text": "records",
              "type": "number"
            },
            {
              "selector": "last_record_ms",
              "text": "last_record_ms",
              "type": "number"
            }
          ]
        }
      ],
      "maxDataPoints": 360
    },
    {
      "id": 4,
      "type": "table",
      "title": "Process lifecycle and terminal export counts",
      "description": "Latest lifecycle or terminal event per process, with lost and queued record counts from its terminal event. A missing terminal event leaves the counts empty.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "x": 8,
        "y": 100,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No lifecycle or terminal events. Check the window, Job/Execution and Services reporting."
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "url": "/v1/rl/execution",
          "columns": [
            {
              "selector": "execution_uid",
              "text": "execution_uid",
              "type": "string"
            },
            {
              "selector": "role",
              "text": "role",
              "type": "string"
            },
            {
              "selector": "process",
              "text": "process",
              "type": "string"
            },
            {
              "selector": "event",
              "text": "event",
              "type": "string"
            },
            {
              "selector": "status",
              "text": "status",
              "type": "string"
            },
            {
              "selector": "reason",
              "text": "reason",
              "type": "string"
            },
            {
              "selector": "export_lost_records",
              "text": "export lost records",
              "type": "number"
            },
            {
              "selector": "export_queued_records",
              "text": "export queued records",
              "type": "number"
            },
            {
              "selector": "last_record_ms",
              "text": "last_record_ms",
              "type": "timestamp_epoch"
            }
          ],
          "targetRef": "rl_execution",
          "view": "lifecycle"
        }
      ],
      "maxDataPoints": 360,
      "interval": "30s"
    },
    {
      "id": 120,
      "type": "table",
      "title": "Span coverage: clock domain and failed steps",
      "description": "Observed steps and failed steps by role and timing clock domain. Use coverage to check which timing panels represent the selected executions; higher failure counts identify interrupted work. Missing outcomes leave failure counts empty.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "x": 16,
        "y": 100,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No spans. The run reported a policy_step, so the trainer's timing sink is not reaching Finelog."
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failed_steps"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "-"
              }
            ]
          }
        ]
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "targetRef": "rl_execution",
          "url": "/v1/rl/execution",
          "view": "span_coverage",
          "format": "table",
          "columns": [
            {
              "selector": "role",
              "text": "sink role",
              "type": "string"
            },
            {
              "selector": "clock_domain",
              "text": "clock domain",
              "type": "string"
            },
            {
              "selector": "steps",
              "text": "steps",
              "type": "number"
            },
            {
              "selector": "failed_steps",
              "text": "steps that failed",
              "type": "number"
            }
          ]
        }
      ],
      "maxDataPoints": 360,
      "interval": "30s"
    },
    {
      "id": 28,
      "type": "table",
      "title": "Exporter and nonfinite observations",
      "description": "Lost/rejected export records and nonfinite training values by process. Increasing export counts mean observations are missing; nonfinite values can signal an invalid update. Nonfinite values sum deltas, while exporter counters use their maximum cumulative reading; nonfinite observations require trainer.training_metrics.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "x": 0,
        "y": 108,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No exporter or nonfinite observations. Check the window, Job/Execution and Services reporting."
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "url": "/v1/rl/execution",
          "columns": [
            {
              "selector": "execution_uid",
              "text": "execution_uid",
              "type": "string"
            },
            {
              "selector": "process",
              "text": "process",
              "type": "string"
            },
            {
              "selector": "name",
              "text": "name",
              "type": "string"
            },
            {
              "selector": "observed_value",
              "text": "observed_value",
              "type": "number"
            },
            {
              "selector": "last_record_ms",
              "text": "last_record_ms",
              "type": "timestamp_epoch"
            }
          ],
          "targetRef": "rl_execution",
          "view": "exporter"
        }
      ],
      "maxDataPoints": 360,
      "interval": "30s"
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Signed timing residuals",
      "description": "Signed rollout-call and Megatron residual walls after named child phases. Large positive residuals identify unassigned time; negative values indicate overlapping observations and remain visible. Rollout residuals require trainer.rollout_spans; Megatron residuals require trainer.policy_train_spans. Megatron phases are CPU wall time around asynchronous CUDA launches (clock_domain=cpu_dispatch_wall), so a phase can end before its GPU work does.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "x": 8,
        "y": 108,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No matching execution observations. Check the window, Job/Execution and Services reporting.",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "displayName": "${__field.labels.series}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "timeseries",
          "url": "/v1/rl/execution",
          "targetRef": "rl_execution",
          "view": "residuals"
        }
      ],
      "interval": "30s",
      "maxDataPoints": 360
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Driver event-loop lag",
      "description": "Worst observed delay of the driver event loop in each bucket. Sustained lag can delay admission, telemetry and control work even when device work continues. The monitor samples once per second; requires trainer.rollout_spans.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "x": 16,
        "y": 108,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No rollout-span observations. Check trainer.rollout_spans and the selected Job/Execution.",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0,
          "displayName": "${__field.labels.series}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "timeseries",
          "url": "/v1/rl/execution",
          "targetRef": "rl_execution",
          "view": "event_loop_lag"
        }
      ],
      "interval": "30s",
      "maxDataPoints": 360
    }
  ]
}
