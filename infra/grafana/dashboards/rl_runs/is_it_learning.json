    {
      "type": "timeseries",
      "title": "Training reward and informative groups",
      "description": "Raw training reward, reward/avg_pass_at_{n} and the fraction of informative groups. Compare sustained reward changes with held-out evaluation; an informative-group fraction near zero means most groups provide little relative training signal. Reward scales depend on the task, and pass-at-n depends on group size; requires trainer.training_metrics.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No training-metric observations. Check trainer.training_metrics and the selected Job/Execution.",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0,
          "displayName": "${__field.labels.series}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "timeseries",
          "url": "/v1/rl/execution",
          "targetRef": "rl_execution",
          "view": "reward"
