{
  "type": "stat",
  "title": "Since last record",
  "description": "Age of the latest record across every record type in the selected executions. Old steps with fresh records suggest a trainer stall; both ages rising suggests missing telemetry. Green is under 300 seconds, orange is 300–899 and red is at least 900. Age is measured to the end of the selected range, so a finished run also reads as old; check its terminal event in Diagnostics.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "fieldConfig": {
    "defaults": {
      "unit": "s",
      "noValue": "No matching execution observations in this window.",
      "color": {
        "mode": "thresholds"
      },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          {
            "color": "green",
            "value": null
          },
          {
            "color": "orange",
            "value": 300
          },
          {
            "color": "red",
            "value": 900
          }
        ]
      }
    },
    "overrides": []
  },
  "options": {
    "reduceOptions": {
      "calcs": [
        "lastNotNull"
      ],
      "fields": "",
      "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
  },
  "targets": [
    {
      "refId": "A",
      "targetRef": "rl_execution",
      "url": "/v1/rl/execution",
      "view": "status",
      "format": "table",
      "columns": [
        {
          "selector": "since_last_record",
          "text": "Since last record",
          "type": "number"
        }
      ]
    }
  ],
  "interval": "30s",
  "maxDataPoints": 360
}
