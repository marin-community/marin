{
  "type": "row",
  "title": "Do trainer and vLLM logprobs agree?",
  "collapsed": true,
  "panels": [
    {
      "id": 30,
      "type": "timeseries",
      "title": "Pre-update model log-ratio drift",
      "description": "Trainer-minus-generation logprob drift before the policy update. Values near zero mean the trainer reproduces rollout probabilities; growing magnitude suggests policy drift or a serving/training mismatch. Only finite loss tokens contribute; requires rollout logprobs and trainer.training_metrics.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "x": 0,
        "y": 97,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No training-metric observations. Check trainer.training_metrics and the selected Job/Execution.",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "displayName": "${__field.labels.series}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "timeseries",
          "url": "/v1/rl/execution",
          "targetRef": "rl_execution",
          "view": "drift"
        }
      ],
      "interval": "30s",
      "maxDataPoints": 360
    },
