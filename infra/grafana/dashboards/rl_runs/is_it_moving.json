        }
      ],
      "interval": "30s",
      "maxDataPoints": 360,
      "id": 3,
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Rollouts and samples completed",
      "description": "Completed trajectories and generated response segments per display bucket. Falling completions can explain a draining training buffer; compare samples with rollouts to spot changes in trajectory structure. Each counter advances when its work completes.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
