{
  "uid": "marin-iris",
  "title": "Iris resources",
  "description": "Per-task and per-worker resource usage from the iris.task and iris.worker finelog namespaces. iris.task is written on every backend, so this dashboard has data on marin-dev; iris.worker heartbeats are GCE/TPU-only.",
  "tags": ["marin", "generated"],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "datasource",
        "query": "yesoreyeram-infinity-datasource",
        "current": { "text": "finelog-marin", "value": "finelog-marin" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Task memory by task",
      "description": "Mean resident memory per task, from iris.task.memory_mb.",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${cluster}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "decmbytes", "min": 0, "custom": { "drawStyle": "line", "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/query",
          "url_options": {
            "method": "GET",
            "params": [
              { "key": "sql", "value": "SELECT date_bin(INTERVAL '${__interval_ms} milliseconds', ts) AS t, task_id AS series, AVG(memory_mb) AS value FROM \"iris.task\" WHERE ts >= {{from}} AND ts < {{to}} GROUP BY 1, 2 ORDER BY 1" },
              { "key": "from", "value": "${__from}" },
              { "key": "to", "value": "${__to}" }
            ]
          },
          "columns": [
            { "selector": "t", "text": "time", "type": "timestamp_epoch_ms" },
            { "selector": "series", "text": "task", "type": "string" },
            { "selector": "value", "text": "memory_mb", "type": "number" }
          ]
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Task peak memory by task",
      "description": "Peak resident memory per task, from iris.task.memory_peak_mb (populated on GCE/TPU; k8s until the producer stamps it).",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${cluster}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "decmbytes", "min": 0, "custom": { "drawStyle": "line", "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/query",
          "url_options": {
            "method": "GET",
            "params": [
              { "key": "sql", "value": "SELECT date_bin(INTERVAL '${__interval_ms} milliseconds', ts) AS t, task_id AS series, MAX(memory_peak_mb) AS value FROM \"iris.task\" WHERE ts >= {{from}} AND ts < {{to}} GROUP BY 1, 2 ORDER BY 1" },
              { "key": "from", "value": "${__from}" },
              { "key": "to", "value": "${__to}" }
            ]
          },
          "columns": [
            { "selector": "t", "text": "time", "type": "timestamp_epoch_ms" },
            { "selector": "series", "text": "task", "type": "string" },
            { "selector": "value", "text": "memory_peak_mb", "type": "number" }
          ]
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Task CPU by task",
      "description": "Mean CPU in millicores per task, from iris.task.cpu_millicores.",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${cluster}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/query",
          "url_options": {
            "method": "GET",
            "params": [
              { "key": "sql", "value": "SELECT date_bin(INTERVAL '${__interval_ms} milliseconds', ts) AS t, task_id AS series, AVG(cpu_millicores) AS value FROM \"iris.task\" WHERE ts >= {{from}} AND ts < {{to}} GROUP BY 1, 2 ORDER BY 1" },
              { "key": "from", "value": "${__from}" },
              { "key": "to", "value": "${__to}" }
            ]
          },
          "columns": [
            { "selector": "t", "text": "time", "type": "timestamp_epoch_ms" },
            { "selector": "series", "text": "task", "type": "string" },
            { "selector": "value", "text": "cpu_millicores", "type": "number" }
          ]
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Task disk by task",
      "description": "Peak disk usage per task, from iris.task.disk_mb (populated on GCE/TPU; k8s until the producer stamps it).",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${cluster}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "decmbytes", "min": 0, "custom": { "drawStyle": "line", "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/query",
          "url_options": {
            "method": "GET",
            "params": [
              { "key": "sql", "value": "SELECT date_bin(INTERVAL '${__interval_ms} milliseconds', ts) AS t, task_id AS series, MAX(disk_mb) AS value FROM \"iris.task\" WHERE ts >= {{from}} AND ts < {{to}} GROUP BY 1, 2 ORDER BY 1" },
              { "key": "from", "value": "${__from}" },
              { "key": "to", "value": "${__to}" }
            ]
          },
          "columns": [
            { "selector": "t", "text": "time", "type": "timestamp_epoch_ms" },
            { "selector": "series", "text": "task", "type": "string" },
            { "selector": "value", "text": "disk_mb", "type": "number" }
          ]
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Worker host CPU by worker",
      "description": "Host CPU percent per worker heartbeat, from iris.worker.cpu_pct. GCE/TPU only.",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${cluster}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/query",
          "url_options": {
            "method": "GET",
            "params": [
              { "key": "sql", "value": "SELECT date_bin(INTERVAL '${__interval_ms} milliseconds', ts) AS t, worker_id AS series, AVG(cpu_pct) AS value FROM \"iris.worker\" WHERE ts >= {{from}} AND ts < {{to}} GROUP BY 1, 2 ORDER BY 1" },
              { "key": "from", "value": "${__from}" },
              { "key": "to", "value": "${__to}" }
            ]
          },
          "columns": [
            { "selector": "t", "text": "time", "type": "timestamp_epoch_ms" },
            { "selector": "series", "text": "worker", "type": "string" },
            { "selector": "value", "text": "cpu_pct", "type": "number" }
          ]
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Worker memory used by worker",
      "description": "Host memory in use per worker heartbeat, from iris.worker.mem_bytes. GCE/TPU only.",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${cluster}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0, "custom": { "drawStyle": "line", "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/query",
          "url_options": {
            "method": "GET",
            "params": [
              { "key": "sql", "value": "SELECT date_bin(INTERVAL '${__interval_ms} milliseconds', ts) AS t, worker_id AS series, AVG(mem_bytes) AS value FROM \"iris.worker\" WHERE ts >= {{from}} AND ts < {{to}} GROUP BY 1, 2 ORDER BY 1" },
              { "key": "from", "value": "${__from}" },
              { "key": "to", "value": "${__to}" }
            ]
          },
          "columns": [
            { "selector": "t", "text": "time", "type": "timestamp_epoch_ms" },
            { "selector": "series", "text": "worker", "type": "string" },
            { "selector": "value", "text": "mem_bytes", "type": "number" }
          ]
        }
      ]
    }
  ]
}
