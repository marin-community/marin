{
  "uid": "marin-accel",
  "title": "Fleet accelerators",
  "description": "Where the fleet's power goes and whether it is doing work. Sourced from each CoreWeave node's dcgm-exporter via the iris-node-agent telemetry stream, so it covers GPU clusters only -- TPU hosts report no power. Keep the window short because longer ranges scan proportionally more node telemetry.",
  "tags": [
    "marin",
    "generated"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "custom",
        "description": "The clusters the bridge serves (infra/grafana/src/config.py). A custom list rather than a query so a cluster that has gone silent -- exactly when you want to select it -- is still in the dropdown.",
        "query": "cw-rno2a,cw-us-east-02a,cw-us-east-08a,marin,marin-dev",
        "options": [
          {
            "selected": false,
            "text": "cw-rno2a",
