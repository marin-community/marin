    {
      "id": 15,
      "type": "table",
      "title": "Telemetry freshness",
      "description": "Seconds since each cluster's newest GPU sample, with the GPU and node counts behind it. Clusters forward in bursts: a lag of minutes means the power charts' right edge is still filling in, not that the fleet went quiet.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
