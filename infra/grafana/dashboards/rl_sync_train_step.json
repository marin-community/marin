{
  "uid": "marin-rl-sync-train-step",
  "title": "RL Post-training (sync): train step",
  "description": "Why the training half of an RL step takes as long as it does: the per-rank spans MarinSkyRL publishes from inside the policy worker, and the DCGM occupancy of the same nodes. Training is 21-27% of the step; generation is the larger half and has its own board.",
  "tags": [
    "marin",
    "generated"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "links": [
    {
      "linkRef": "rl_post_training"
    },
    {
      "linkRef": "rl_sync_generation"
    },
    {
      "linkRef": "fleet_accelerators"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "custom",
        "query": "cw-rno2a,cw-us-east-02a,cw-us-east-08a,marin,marin-dev",
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "finelog-marin"
        },
        "multi": false,
        "includeAll": false,
        "refresh": 2,
        "sort": 0,
        "current": {},
        "options": [],
        "query": {
          "queryType": "infinity",
          "refId": "variable-run",
          "infinityQuery": {
            "refId": "variable-run",
            "type": "json",
            "source": "url",
            "format": "table",
            "parser": "backend",
            "url": "/query",
            "url_options": {
              "method": "GET",
              "params": [
                {
                  "key": "sql",
                  "value": "SELECT run_id AS value FROM \"telemetry_v1.marinskyrl\" WHERE service = 'marinskyrl' AND name = 'policy_step' AND COALESCE(json_get(resource_attributes_json, 'training_loop'), '') <> 'async' AND COALESCE(NULLIF(\"cluster\", ''), 'marin') IN (${cluster:sqlstring}) AND timestamp_ms >= CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) AND timestamp_ms < CAST(EXTRACT(EPOCH FROM {{to}}) * 1000 AS BIGINT) AND run_id IS NOT NULL GROUP BY 1 ORDER BY MAX(timestamp_ms) DESC"
                },
                {
                  "key": "from",
                  "value": "${__from}"
                },
                {
                  "key": "to",
                  "value": "${__to}"
                }
              ]
            },
            "columns": [
              {
                "selector": "value",
                "text": "value",
                "type": "string"
              }
            ]
          }
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Why is the training step slow?",
      "collapsed": false,
      "id": 210,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 211,
      "type": "timeseries",
      "title": "policy_ppo_train decomposition at the critical rank",
      "description": "Exclusive spans on r* = argmax_rank(policy_ppo_train), the rank the driver blocked on. Never take a per-phase maximum across ranks: barrier and compute are anti-correlated, so the maxima come from different ranks and can sum past the parent. `unattributed` is recomputed here, and signed.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "mean seconds per step at r*",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "s",
          "noValue": "No worker spans. Set trainer.policy_train_spans=true, and check the telemetry endpoint, run id and execution uid reached the Ray actors — an unconfigured runtime discards every record and still reports a healthy flush.",
          "min": 0,
          "displayName": "${__field.labels.series}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/v1/rl/train-step",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "clusters",
                "value": "${cluster:csv}"
              },
              {
                "key": "run",
