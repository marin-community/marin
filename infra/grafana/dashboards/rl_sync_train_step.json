            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "active"
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "No node join: trainer rows carry no node_name, or the node agent is not reporting this cluster. Never idle GPUs.",
          "displayName": "${__field.labels.series}"
        },
