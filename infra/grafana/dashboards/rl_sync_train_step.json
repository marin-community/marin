        "type": "yesoreyeram-infinity-datasource",
        "uid": "finelog-marin"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "seconds per micro-step"
          },
          "unit": "s",
          "min": 0,
          "noValue": "No micro_step_count counter. Workers publish it only with trainer.policy_train_spans=true."
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "micro_steps"
            },
            "properties": [
