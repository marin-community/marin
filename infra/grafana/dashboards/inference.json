              "type": "string"
            },
            {
              "selector": "t",
              "text": "last sample",
              "type": "timestamp_epoch"
            },
            {
              "selector": "value",
              "text": "age at range end (s)",
              "type": "number"
            },
            {
              "selector": "gap_seconds",
