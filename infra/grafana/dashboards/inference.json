{
  "uid": "marin-inference",
  "title": "Inference telemetry",
  "description": "Bounded, reset-aware views over Marin's centralized service=vllm telemetry. Select one Iris job or canonical run identity; the bridge enforces the identity, seven-day range, bucket, and result caps server-side.",
  "tags": [
    "marin",
    "inference",
    "vllm"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "datasource",
        "query": "yesoreyeram-infinity-datasource",
        "current": {
          "text": "finelog-marin",
          "value": "finelog-marin"
        }
      },
      {
        "name": "identity_kind",
        "label": "Identity kind",
        "type": "custom",
        "query": "job_id,root_run_uid,execution_uid",
        "current": {
          "text": "job_id",
          "value": "job_id"
        },
        "options": [
          {
            "selected": true,
            "text": "job_id",
            "value": "job_id"
          },
          {
            "selected": false,
            "text": "root_run_uid",
            "value": "root_run_uid"
          },
          {
            "selected": false,
            "text": "execution_uid",
            "value": "execution_uid"
          }
        ]
      },
      {
        "name": "identity",
        "label": "Job or run identity (required)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Telemetry freshness",
      "description": "Explicitly distinguishes no matching records, a range ending after the last sample, an in-range scrape/export gap, and continuous samples. Current telemetry_v1 records producer time but not ingest time, so producer and export gaps cannot yet be separated.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${cluster}"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/v1/vllm/overview",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "identity_kind",
                "value": "${identity_kind}"
              },
              {
                "key": "identity",
                "value": "${identity}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "bucket_ms",
                "value": "${__interval_ms}"
              },
              {
                "key": "view",
                "value": "freshness"
              }
            ]
          },
          "columns": [
            {
              "selector": "status",
              "text": "status",
              "type": "string"
            },
            {
              "selector": "t",
              "text": "last sample",
              "type": "timestamp_epoch"
            },
            {
              "selector": "value",
              "text": "age at range end (s)",
              "type": "number"
            },
            {
              "selector": "gap_seconds",
              "text": "largest sample gap (s)",
              "type": "number"
            },
            {
              "selector": "samples",
              "text": "replica samples",
              "type": "number"
            }
          ]
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Prompt and generated token rate",
      "description": "Per-bucket rates from reset-aware cumulative snapshot deltas, summed only after replica-local deltas are computed.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${cluster}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "tps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/v1/vllm/overview",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "identity_kind",
                "value": "${identity_kind}"
              },
              {
                "key": "identity",
                "value": "${identity}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "bucket_ms",
                "value": "${__interval_ms}"
              },
              {
                "key": "view",
                "value": "token_rate"
              }
            ]
          },
          "columns": [
            {
              "selector": "t",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "series",
              "text": "series",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "tokens/s",
              "type": "number"
            }
          ]
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Running and waiting requests",
      "description": "Per-bin replica averages summed across the selected serve. KV-cache uses a separate unweighted replica view because no capacity weight is stored.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${cluster}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/v1/vllm/overview",
          "filterExpression": "metric != 'kv_cache_usage'",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "identity_kind",
                "value": "${identity_kind}"
              },
              {
                "key": "identity",
                "value": "${identity}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "bucket_ms",
                "value": "${__interval_ms}"
              },
              {
                "key": "view",
                "value": "saturation"
              }
            ]
          },
          "columns": [
            {
              "selector": "t",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "metric",
              "text": "metric",
              "type": "string"
            },
            {
              "selector": "series",
              "text": "series",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "requests",
              "type": "number"
            }
          ]
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Window totals",
      "description": "Prompt/generated tokens and preemptions over the selected range. Native Rigging counter rows are summed directly; imported Prometheus counters use reset-aware deltas.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${cluster}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/v1/vllm/overview",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "identity_kind",
                "value": "${identity_kind}"
              },
              {
                "key": "identity",
                "value": "${identity}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "bucket_ms",
                "value": "${__interval_ms}"
              },
              {
                "key": "view",
                "value": "counter_total"
              }
            ]
          },
          "columns": [
            {
              "selector": "series",
              "text": "metric",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "total",
              "type": "number"
            },
            {
              "selector": "unit",
              "text": "unit",
              "type": "string"
            }
          ]
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "KV-cache usage",
      "description": "Unweighted average of per-replica KV-cache usage for each time bin. A capacity-weighted serve-wide percentage is not available in the stored family.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${cluster}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "/v1/vllm/overview",
          "filterExpression": "metric == 'kv_cache_usage'",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "identity_kind",
                "value": "${identity_kind}"
              },
              {
                "key": "identity",
                "value": "${identity}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "bucket_ms",
                "value": "${__interval_ms}"
              },
              {
                "key": "view",
                "value": "saturation"
              }
            ]
          },
          "columns": [
            {
              "selector": "t",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "metric",
              "text": "metric",
              "type": "string"
            },
            {
              "selector": "series",
              "text": "series",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "usage",
              "type": "number"
            }
          ]
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Saturation average and peak",
      "description": "Average and peak of the binned serve-wide request counts and unweighted replica KV-cache usage.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${cluster}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/v1/vllm/overview",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "identity_kind",
                "value": "${identity_kind}"
              },
              {
                "key": "identity",
                "value": "${identity}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "bucket_ms",
                "value": "${__interval_ms}"
              },
              {
                "key": "view",
                "value": "saturation_summary"
              }
            ]
          },
          "columns": [
            {
              "selector": "series",
              "text": "metric",
              "type": "string"
            },
            {
              "selector": "stat",
              "text": "stat",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "value",
              "type": "number"
            },
            {
              "selector": "unit",
              "text": "unit",
              "type": "string"
            }
          ]
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Reset-aware latency evidence",
      "description": "TTFT, TPOT/inter-token, queue, and end-to-end means from _sum/_count deltas plus p50/p90/p99 upper-bound estimates from bucket deltas. A null quantile means the stored finite buckets do not bound it.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${cluster}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/v1/vllm/overview",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "identity_kind",
                "value": "${identity_kind}"
              },
              {
                "key": "identity",
                "value": "${identity}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "bucket_ms",
                "value": "${__interval_ms}"
              },
              {
                "key": "view",
                "value": "latency"
              }
            ]
          },
          "columns": [
            {
              "selector": "series",
              "text": "latency",
              "type": "string"
            },
            {
              "selector": "stat",
              "text": "stat",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "seconds",
              "type": "number"
            }
          ]
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Request outcomes",
      "description": "Reset-aware request_success_total grouped by the stored finish/outcome label, plus compatible failure/timeout counter families when a vLLM version exposes them. Preemptions are shown in Window totals.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${cluster}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/v1/vllm/overview",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "identity_kind",
                "value": "${identity_kind}"
              },
              {
                "key": "identity",
                "value": "${identity}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "bucket_ms",
                "value": "${__interval_ms}"
              },
              {
                "key": "view",
                "value": "request_outcome"
              }
            ]
          },
          "columns": [
            {
              "selector": "series",
              "text": "outcome",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "requests",
              "type": "number"
            }
          ]
        }
      ]
    }
  ]
}
