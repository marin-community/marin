{
  "type": "timeseries",
  "title": "Per-trajectory wait: rollout_engine_await and rollout_env_await",
  "description": "`_seconds_sum` ÷ `rollout_trajectory_count` for `rollout_engine_await` and `rollout_env_await`, and `rollout_engine_await_seconds_max`. The sums overlap across coroutines, so never stack them. `rollout_engine_await` is the caller's wait on the inference client. For callers that pass text, it includes chat templating on the driver thread.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "fieldConfig": {
    "defaults": {
      "custom": {
        "drawStyle": "line",
        "lineWidth": 1,
        "fillOpacity": 8,
        "showPoints": "never",
        "spanNulls": false,
        "axisLabel": "seconds per trajectory"
      },
      "unit": "s",
      "noValue": "No rollout wait counters. This build or runner does not publish them.",
      "min": 0
    },
    "overrides": []
  },
  "options": {
    "legend": {
      "showLegend": true,
      "displayMode": "list",
      "placement": "bottom",
      "calcs": []
    },
    "tooltip": {
      "mode": "multi",
      "sort": "desc"
    }
  },
  "targets": [
    {
      "refId": "A",
      "targetRef": "rl_run",
      "url": "/v1/rl/generation",
      "view": "trajectory_wait",
      "format": "timeseries",
      "columns": [
        {
          "selector": "t",
          "text": "time",
          "type": "timestamp_epoch"
        },
        {
          "selector": "engine_wait_per_trajectory",
          "text": "engine_wait_per_trajectory",
          "type": "number"
        },
        {
          "selector": "env_wait_per_trajectory",
          "text": "env_wait_per_trajectory",
          "type": "number"
        },
        {
          "selector": "engine_await_max",
          "text": "engine_await_max",
          "type": "number"
        }
      ]
    }
  ],
  "interval": "1m"
}
