{
  "type": "timeseries",
  "title": "A trajectory's wait: the engine against the environment",
  "description": "Per-trajectory wait, from concurrent sums divided by rollout_trajectory_count. The raw sums run about 200x their own parent and must never be banded. `slowest` is what generate waits for. The engine wait also contains any driver-thread tokenization on the call path, so it is not purely engine time.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "fieldConfig": {
    "defaults": {
      "custom": {
        "drawStyle": "line",
        "lineWidth": 1,
        "fillOpacity": 8,
        "showPoints": "never",
        "spanNulls": false,
        "axisLabel": "seconds per trajectory"
      },
      "unit": "s",
      "noValue": "No rollout counters. This build does not instrument the generation coroutines.",
      "min": 0
    },
    "overrides": []
  },
  "options": {
    "legend": {
      "showLegend": true,
      "displayMode": "list",
      "placement": "bottom",
      "calcs": []
    },
    "tooltip": {
      "mode": "multi",
      "sort": "desc"
    }
  },
  "targets": [
    {
      "refId": "A",
      "type": "json",
      "source": "url",
      "format": "timeseries",
      "parser": "backend",
      "url": "/v1/rl/generation",
      "url_options": {
        "method": "GET",
        "params": [
          {
            "key": "clusters",
            "value": "${cluster:csv}"
          },
          {
            "key": "run",
            "value": "${run}"
          },
          {
            "key": "from",
            "value": "${__from}"
          },
          {
            "key": "to",
            "value": "${__to}"
          },
          {
            "key": "bucket_ms",
            "value": "${__interval_ms}"
          },
          {
            "key": "view",
            "value": "trajectory_wait"
          }
        ]
      },
      "columns": [
        {
          "selector": "t",
          "text": "time",
          "type": "timestamp_epoch"
        },
        {
          "selector": "engine_wait_per_trajectory",
          "text": "engine_wait_per_trajectory",
          "type": "number"
        },
        {
          "selector": "env_wait_per_trajectory",
          "text": "env_wait_per_trajectory",
          "type": "number"
        },
        {
          "selector": "slowest_single_trajectory",
          "text": "slowest_single_trajectory",
          "type": "number"
        }
      ]
    }
  ],
  "interval": "1m"
}
