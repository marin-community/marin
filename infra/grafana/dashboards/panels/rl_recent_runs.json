{
  "type": "table",
  "title": "Recent RL runs",
  "description": "RL runs that reported a policy step in the selected window, most recently active first. The link opens RL Post-training with the run's training type, cluster and window around its lifecycle, policy-step and rollout-call records, clipped to Home's range. A run with any async stamp on its lifecycle, policy-step or rollout-call records is async; every other run is sync. Attempts counts the distinct executions that reported policy steps.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "fieldConfig": {
    "defaults": {
      "custom": {
        "align": "auto",
        "cellOptions": {
          "type": "auto"
        }
      }
    },
    "overrides": [
      {
        "matcher": {
          "id": "byName",
          "options": "run"
        },
        "properties": [
          {
            "id": "custom.width",
            "value": 520
          },
          {
            "id": "links",
            "value": [
              {
                "targetBlank": false,
                "title": "Open the RL Post-training view",
                "url": "/d/marin-rl-runs?var-training_type=${__data.fields.type}&var-run=${__data.fields.run}&var-cluster=${__data.fields.cluster}&from=${__data.fields.window_from_ms}&to=${__data.fields.window_to_ms}"
              }
            ]
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "last seen"
        },
        "properties": [
          {
            "id": "unit",
            "value": "dateTimeAsIso"
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "window_from_ms"
        },
        "properties": [
          {
            "id": "custom.hidden",
            "value": true
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "window_to_ms"
        },
        "properties": [
          {
            "id": "custom.hidden",
            "value": true
          }
        ]
      }
    ]
  },
  "options": {
    "showHeader": true,
    "sortBy": []
  },
  "targets": [
    {
      "refId": "A",
      "type": "json",
      "source": "url",
      "format": "table",
      "parser": "backend",
      "url": "/v1/rl/recent",
      "url_options": {
        "method": "GET",
        "params": [
          {
            "key": "from",
            "value": "${__from}"
          },
          {
            "key": "to",
            "value": "${__to}"
          }
        ]
      },
      "columns": [
        {
          "selector": "run",
          "text": "run",
          "type": "string"
        },
        {
          "selector": "cluster",
          "text": "cluster",
          "type": "string"
        },
        {
          "selector": "step",
          "text": "step",
          "type": "number"
        },
        {
          "selector": "attempts",
          "text": "attempts",
          "type": "number"
        },
        {
          "selector": "window_from_ms",
          "text": "window_from_ms",
          "type": "number"
        },
        {
          "selector": "window_to_ms",
          "text": "window_to_ms",
          "type": "number"
        },
        {
          "selector": "last seen",
          "text": "last seen",
          "type": "number"
        },
        {
          "selector": "type",
          "text": "type",
          "type": "string"
        }
      ]
    }
  ]
}
