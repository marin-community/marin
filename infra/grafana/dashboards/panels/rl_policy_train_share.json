{
  "type": "timeseries",
  "title": "policy_train share of the step",
  "description": "The share of step time in the bucket spent in `policy_train`: driver `policy_train` seconds ÷ `step` seconds, each summed over the bucket's steps. Near 1 means `policy_train` dominates the step. Near 0 means `generate` does.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "fieldConfig": {
    "defaults": {
      "custom": {
        "drawStyle": "line",
        "lineWidth": 1,
        "fillOpacity": 8,
        "showPoints": "never",
        "spanNulls": false,
        "axisLabel": "fraction of the step"
      },
      "unit": "percentunit",
      "min": 0,
      "max": 1,
      "noValue": "No policy_train row, and no phases naming step as their parent. The trainer's timing sink is not reaching Finelog."
    },
    "overrides": []
  },
  "options": {
    "legend": {
      "showLegend": true,
      "displayMode": "list",
      "placement": "bottom",
      "calcs": []
    },
    "tooltip": {
      "mode": "multi",
      "sort": "desc"
    }
  },
  "targets": [
    {
      "refId": "A",
      "targetRef": "rl_run",
      "url": "/v1/rl/overview",
      "view": "policy_train_share",
      "format": "timeseries",
      "columns": [
        {
          "selector": "t",
          "text": "time",
          "type": "timestamp_epoch"
        },
        {
          "selector": "policy_train_share",
          "text": "policy_train ÷ step",
          "type": "number"
        }
      ]
    }
  ],
  "interval": "1m"
}
