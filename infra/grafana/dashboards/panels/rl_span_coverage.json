{
  "type": "table",
  "title": "Span coverage: clock domain, ranks, failed steps",
  "description": "Rows per role and `clock_domain`, the ranks that reported, and steps with `outcome=failure`. `_launch` rows measure launch time and are not comparable with `_wall` rows. A failed step looks fast.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "fieldConfig": {
    "defaults": {
      "noValue": "No spans. The run reported a policy_step, so the trainer's timing sink is not reaching Finelog."
    },
    "overrides": [
      {
        "matcher": {
          "id": "byName",
          "options": "ranks"
        },
        "properties": [
          {
            "id": "noValue",
            "value": "—"
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "failed_steps"
        },
        "properties": [
          {
            "id": "noValue",
            "value": "—"
          }
        ]
      }
    ]
  },
  "options": {},
  "targets": [
    {
      "refId": "A",
      "type": "json",
      "source": "url",
      "format": "table",
      "parser": "backend",
      "url": "/v1/rl/overview",
      "url_options": {
        "method": "GET",
        "params": [
          {
            "key": "clusters",
            "value": "${cluster:csv}"
          },
          {
            "key": "run",
            "value": "${run}"
          },
          {
            "key": "from",
            "value": "${__from}"
          },
          {
            "key": "to",
            "value": "${__to}"
          },
          {
            "key": "bucket_ms",
            "value": "${__interval_ms}"
          },
          {
            "key": "view",
            "value": "span_coverage"
          }
        ]
      },
      "columns": [
        {
          "selector": "role",
          "text": "sink role",
          "type": "string"
        },
        {
          "selector": "clock",
          "text": "clock domain",
          "type": "string"
        },
        {
          "selector": "ranks",
          "text": "ranks",
          "type": "number"
        },
        {
          "selector": "steps",
          "text": "steps",
          "type": "number"
        },
        {
          "selector": "failed_steps",
          "text": "steps that failed",
          "type": "number"
        }
      ]
    }
  ]
}
