{
  "type": "stat",
  "title": "Fleet tasks in flight",
  "description": "Sum over each selected cluster's latest iris.task_state rollup row (root_job_id='') within the last 2 minutes: tasks running, building, and pending. A cluster whose controller has stopped emitting drops out of this sum.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "timeFrom": "2m",
  "fieldConfig": {
    "defaults": {
      "unit": "short",
      "color": {
        "mode": "fixed",
        "fixedColor": "text"
      }
    },
    "overrides": [
      {
        "matcher": {
          "id": "byName",
          "options": "running"
        },
        "properties": [
          {
            "id": "color",
            "value": {
              "mode": "fixed",
              "fixedColor": "green"
            }
          }
        ]
      }
    ]
  },
  "options": {
    "reduceOptions": {
      "calcs": [
        "lastNotNull"
      ],
      "fields": "",
      "values": false
    },
    "orientation": "horizontal",
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name"
  },
  "targets": [
    {
      "refId": "A",
      "type": "json",
      "source": "url",
      "format": "table",
      "parser": "backend",
      "url": "/v1/jobs/overview",
      "url_options": {
        "method": "GET",
        "params": [
          {
            "key": "clusters",
            "value": "${cluster:csv}"
          },
          {
            "key": "jobs",
            "value": "${job:csv}"
          },
          {
            "key": "from",
            "value": "${__from}"
          },
          {
            "key": "to",
            "value": "${__to}"
          },
          {
            "key": "bucket_ms",
            "value": "${__interval_ms}"
          },
          {
            "key": "view",
            "value": "fleet_tasks"
          }
        ]
      },
      "columns": [
        {
          "selector": "running",
          "text": "running",
          "type": "number"
        },
        {
          "selector": "building",
          "text": "building",
          "type": "number"
        },
        {
          "selector": "pending",
          "text": "pending",
          "type": "number"
        }
      ]
    }
  ]
}
