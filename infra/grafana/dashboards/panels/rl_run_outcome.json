{
  "type": "table",
  "title": "Terminal event and lost records",
  "description": "The `terminal` event per role: status, reason, and the exporter's queued and lost record counts. A nonzero lost count means every panel here reads an incomplete row set.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "fieldConfig": {
    "defaults": {
      "noValue": "No terminal event. The run is still going, or it exited without publishing one. Check the job's own state."
    },
    "overrides": []
  },
  "options": {},
  "targets": [
    {
      "refId": "A",
      "type": "json",
      "source": "url",
      "format": "table",
      "parser": "backend",
      "url": "/v1/rl/overview",
      "url_options": {
        "method": "GET",
        "params": [
          {
            "key": "clusters",
            "value": "${cluster:csv}"
          },
          {
            "key": "run",
            "value": "${run}"
          },
          {
            "key": "from",
            "value": "${__from}"
          },
          {
            "key": "to",
            "value": "${__to}"
          },
          {
            "key": "bucket_ms",
            "value": "${__interval_ms}"
          },
          {
            "key": "view",
            "value": "run_outcome"
          }
        ]
      },
      "columns": [
        {
          "selector": "role",
          "text": "process",
          "type": "string"
        },
        {
          "selector": "status",
          "text": "status",
          "type": "string"
        },
        {
          "selector": "reason",
          "text": "reason",
          "type": "string"
        },
        {
          "selector": "lost_records",
          "text": "records lost",
          "type": "number"
        },
        {
          "selector": "queued_records",
          "text": "records queued",
          "type": "number"
        }
      ]
    }
  ]
}
