{
  "type": "table",
  "title": "Terminal event and lost records",
  "description": "The `terminal` event of each attempt's processes, by role: status, reason, and the exporter's queued and lost records summed over those processes. A nonzero lost count means every panel here reads an incomplete row set.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "fieldConfig": {
    "defaults": {
      "noValue": "No terminal event. The run is still going, or it exited without publishing one. Check the job's own state."
    },
    "overrides": []
  },
  "options": {},
  "targets": [
    {
      "refId": "A",
      "targetRef": "rl_run",
      "url": "/v1/rl/overview",
      "view": "run_outcome",
      "format": "table",
      "columns": [
        {
          "selector": "execution_uid",
          "text": "attempt",
          "type": "string"
        },
        {
          "selector": "role",
          "text": "process",
          "type": "string"
        },
        {
          "selector": "status",
          "text": "status",
          "type": "string"
        },
        {
          "selector": "reason",
          "text": "reason",
          "type": "string"
        },
        {
          "selector": "lost_records",
          "text": "records lost",
          "type": "number"
        },
        {
          "selector": "queued_records",
          "text": "records queued",
          "type": "number"
        }
      ]
    }
  ]
}
