{
  "type": "table",
  "title": "Query status",
  "description": "The bridge reports detail, summary-only, empty data, timeout, or sample-limit rejection.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "fieldConfig": {
    "defaults": {
      "noValue": "Query status unavailable"
    },
    "overrides": []
  },
  "targets": [
    {
      "refId": "A",
      "type": "json",
      "source": "url",
      "format": "table",
      "parser": "backend",
      "url": "/v1/vllm/overview",
      "url_options": {
        "method": "GET",
        "params": [
          {
            "key": "identity_kind",
            "value": "${identity_kind}"
          },
          {
            "key": "identity",
            "value": "${identity}"
          },
          {
            "key": "identity_override",
            "value": "${identity_override}"
          },
          {
            "key": "from",
            "value": "${__from}"
          },
          {
            "key": "to",
            "value": "${__to}"
          },
          {
            "key": "bucket_ms",
            "value": "15000"
          },
          {
            "key": "view",
            "value": "diagnostic_status"
          }
        ]
      },
      "columns": [
        {
          "selector": "status",
          "text": "state",
          "type": "string"
        },
        {
          "selector": "series",
          "text": "detail",
          "type": "string"
        }
      ]
    }
  ],
  "options": {
    "showHeader": true,
    "cellHeight": "sm"
  }
}
