{
  "type": "timeseries",
  "title": "Step composition: exclusive seconds per span",
  "description": "Seconds each driver span spent outside its children, so the bands sum to `step`. The `step` band is time outside every child span. `generate` is near zero when its child spans are on. Harbor and MiniSwe runners publish no generate child spans, so all of `generate` lands in its own band. A negative band means a child is counted inside another.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "fieldConfig": {
    "defaults": {
      "custom": {
        "drawStyle": "line",
        "lineWidth": 1,
        "fillOpacity": 60,
        "showPoints": "never",
        "spanNulls": false,
        "axisLabel": "mean seconds per step",
        "stacking": {
          "mode": "normal",
          "group": "A"
        }
      },
      "unit": "s",
      "min": 0,
      "noValue": "No inclusive-wall driver rows under root='step'. This build publishes no step timings.",
      "displayName": "${__field.labels.series}"
    },
    "overrides": []
  },
  "options": {
    "legend": {
      "showLegend": true,
      "displayMode": "list",
      "placement": "bottom",
      "calcs": []
    },
    "tooltip": {
      "mode": "multi",
      "sort": "desc"
    }
  },
  "targets": [
    {
      "refId": "A",
      "type": "json",
      "source": "url",
      "format": "timeseries",
      "parser": "backend",
      "url": "/v1/rl/overview",
      "url_options": {
        "method": "GET",
        "params": [
          {
            "key": "clusters",
            "value": "${cluster:csv}"
          },
          {
            "key": "run",
            "value": "${run}"
          },
          {
            "key": "from",
            "value": "${__from}"
          },
          {
            "key": "to",
            "value": "${__to}"
          },
          {
            "key": "bucket_ms",
            "value": "${__interval_ms}"
          },
          {
            "key": "view",
            "value": "step_composition"
          }
        ]
      },
      "columns": [
        {
          "selector": "t",
          "text": "time",
          "type": "timestamp_epoch"
        },
        {
          "selector": "series",
          "text": "series",
          "type": "string"
        },
        {
          "selector": "value",
          "text": "value",
          "type": "number"
        }
      ]
    }
  ],
  "interval": "1m"
}
