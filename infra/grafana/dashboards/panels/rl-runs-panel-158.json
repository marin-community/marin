{
  "type": "timeseries",
  "title": "Gradient norm and policy entropy",
  "description": "Gradient norm and policy entropy by optimizer step. Sudden norm spikes can precede unstable updates; collapsing entropy can indicate reduced policy diversity. These quantities have different scales and separate axes; requires trainer.training_metrics.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "fieldConfig": {
    "defaults": {
      "unit": "none",
      "noValue": "No training-metric observations. Check trainer.training_metrics and the selected Job/Execution.",
      "custom": {
        "drawStyle": "line",
        "lineWidth": 1,
        "fillOpacity": 5,
        "showPoints": "auto",
        "spanNulls": false,
        "stacking": {
          "mode": "none",
          "group": "A"
        }
      },
      "displayName": "${__field.labels.series}"
    },
    "overrides": [
      {
        "matcher": {
          "id": "byRegexp",
          "options": ".*policy_entropy.*"
        },
        "properties": [
          {
            "id": "custom.axisPlacement",
            "value": "right"
          }
        ]
      }
    ]
  },
  "options": {
    "legend": {
      "showLegend": true,
      "displayMode": "list",
      "placement": "bottom",
      "calcs": []
    },
    "tooltip": {
      "mode": "multi",
      "sort": "desc"
    }
  },
  "targets": [
    {
      "refId": "A",
      "format": "timeseries",
      "url": "/v1/rl/execution",
      "targetRef": "rl_execution",
      "view": "optimizer"
    }
  ],
  "interval": "30s",
  "maxDataPoints": 360,
  "transformations": [
    {
      "id": "filterFieldsByName",
      "options": {
        "include": {
          "pattern": "/(^time$|policy\\/(raw_grad_norm|policy_entropy))/"
        }
      }
    }
  ]
}
