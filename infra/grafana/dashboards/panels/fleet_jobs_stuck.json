{
  "type": "stat",
  "title": "Stuck jobs",
  "description": "Active root jobs with a task waiting over 15 minutes — oldest PENDING task un-dispatched, or oldest ASSIGNED/BUILDING task not yet RUNNING — across the selected clusters, latest iris.task_state snapshot within the last 2 minutes. A non-zero value is the queue-saturation signal; the Jobs dashboard names them.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "timeFrom": "2m",
  "fieldConfig": {
    "defaults": {
      "unit": "short",
      "thresholds": {
        "mode": "absolute",
        "steps": [
          {
            "color": "green",
            "value": null
          },
          {
            "color": "red",
            "value": 1
          }
        ]
      }
    },
    "overrides": []
  },
  "options": {
    "reduceOptions": {
      "calcs": [
        "lastNotNull"
      ],
      "fields": "",
      "values": false
    },
    "orientation": "auto",
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
  },
  "targets": [
    {
      "refId": "A",
      "type": "json",
      "source": "url",
      "format": "table",
      "parser": "backend",
      "url": "/v1/jobs/overview",
      "url_options": {
        "method": "GET",
        "params": [
          {
            "key": "clusters",
            "value": "${cluster:csv}"
          },
          {
            "key": "jobs",
            "value": "${job:csv}"
          },
          {
            "key": "from",
            "value": "${__from}"
          },
          {
            "key": "to",
            "value": "${__to}"
          },
          {
            "key": "bucket_ms",
            "value": "${__interval_ms}"
          },
          {
            "key": "view",
            "value": "stuck_jobs"
          }
        ]
      },
      "columns": [
        {
          "selector": "stuck",
          "text": "stuck",
          "type": "number"
        }
      ]
    }
  ]
}
