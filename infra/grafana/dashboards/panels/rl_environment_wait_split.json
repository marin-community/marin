{
  "type": "timeseries",
  "title": "Is the environment slow, or the loop around it?",
  "description": "The environment wait split three ways. Resume dominates on real runs — 88 s of 92 s while the environment itself ran for 0.05 s — which is the event loop being behind, not a slow environment. `unaccounted` audits the split.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "fieldConfig": {
    "defaults": {
      "custom": {
        "drawStyle": "line",
        "lineWidth": 1,
        "fillOpacity": 60,
        "showPoints": "never",
        "spanNulls": false,
        "axisLabel": "share of the environment wait",
        "stacking": {
          "mode": "normal",
          "group": "A"
        }
      },
      "unit": "percentunit",
      "min": 0,
      "max": 1,
      "noValue": "No environment-wait counters. This build does not split the environment wait.",
      "displayName": "${__field.labels.series}"
    },
    "overrides": []
  },
  "options": {
    "legend": {
      "showLegend": true,
      "displayMode": "list",
      "placement": "bottom",
      "calcs": []
    },
    "tooltip": {
      "mode": "multi",
      "sort": "desc"
    }
  },
  "targets": [
    {
      "refId": "A",
      "type": "json",
      "source": "url",
      "format": "timeseries",
      "parser": "backend",
      "url": "/v1/rl/generation",
      "url_options": {
        "method": "GET",
        "params": [
          {
            "key": "clusters",
            "value": "${cluster:csv}"
          },
          {
            "key": "run",
            "value": "${run}"
          },
          {
            "key": "from",
            "value": "${__from}"
          },
          {
            "key": "to",
            "value": "${__to}"
          },
          {
            "key": "bucket_ms",
            "value": "${__interval_ms}"
          },
          {
            "key": "view",
            "value": "environment_split"
          }
        ]
      },
      "columns": [
        {
          "selector": "t",
          "text": "time",
          "type": "timestamp_epoch"
        },
        {
          "selector": "series",
          "text": "series",
          "type": "string"
        },
        {
          "selector": "value",
          "text": "value",
          "type": "number"
        }
      ]
    }
  ],
  "interval": "1m"
}
