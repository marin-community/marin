{
  "type": "timeseries",
  "title": "Rollouts and samples completed",
  "description": "Completed trajectories and generated response segments per display bucket. Falling completions can explain a draining training buffer; compare samples with rollouts to spot changes in trajectory structure. Each counter advances when its work completes.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "fieldConfig": {
    "defaults": {
      "custom": {
        "drawStyle": "line",
        "lineWidth": 1,
        "fillOpacity": 8,
        "showPoints": "never",
        "spanNulls": false,
        "axisLabel": "count per time bucket"
      },
      "min": 0,
      "unit": "short"
    },
    "overrides": []
  },
  "options": {
    "legend": {
      "showLegend": true,
      "displayMode": "list",
      "placement": "bottom",
      "calcs": []
    },
    "tooltip": {
      "mode": "multi",
      "sort": "desc"
    }
  },
  "targets": [
    {
      "refId": "A",
      "format": "timeseries",
      "url": "/v1/rl/execution",
      "columns": [
        {
          "selector": "t",
          "text": "time",
          "type": "timestamp_epoch"
        },
        {
          "selector": "rollouts",
          "text": "rollouts",
          "type": "number"
        },
        {
          "selector": "samples",
          "text": "samples",
          "type": "number"
        }
      ],
      "targetRef": "rl_execution",
      "view": "rollout_progress"
    }
  ],
  "interval": "30s",
  "maxDataPoints": 360
}
