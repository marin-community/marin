{
  "type": "table",
  "title": "CoreWeave node health",
  "description": "Node inventory, readiness, scheduler cordons, and CoreWeave kernel-deadlock and pending lifecycle state. Select a node name to open its hardware history. KernelDeadlock=True pages after five minutes.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "k8s"
  },
  "fieldConfig": {
    "defaults": {},
    "overrides": [
      {
        "matcher": {
          "id": "byName",
          "options": "node"
        },
        "properties": [
          {
            "id": "links",
            "value": [
              {
                "targetBlank": false,
                "title": "Node details",
                "url": "/d/marin-nodes?var-cluster=${__data.fields.cluster}&var-node=${__value.text}&from=${__from}&to=${__to}"
              }
            ]
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "kernel_deadlock"
        },
        "properties": [
          {
            "id": "custom.cellOptions",
            "value": {
              "type": "color-text"
            }
          },
          {
            "id": "mappings",
            "value": [
              {
                "type": "value",
                "options": {
                  "false": {
                    "color": "green",
                    "index": 0
                  },
                  "true": {
                    "color": "red",
                    "index": 1
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "targets": [
    {
      "refId": "A",
      "type": "json",
      "source": "url",
      "format": "table",
      "parser": "backend",
      "url": "/nodes",
      "url_options": {
        "method": "GET"
      },
      "columns": [
        {
          "selector": "cluster",
          "text": "cluster",
          "type": "string"
        },
        {
          "selector": "node",
          "text": "node",
          "type": "string"
        },
        {
          "selector": "instance_type",
          "text": "instance_type",
          "type": "string"
        },
        {
          "selector": "node_pool",
          "text": "node_pool",
          "type": "string"
        },
        {
          "selector": "gpu_model",
          "text": "gpu_model",
          "type": "string"
        },
        {
          "selector": "gpu_capacity",
          "text": "gpus",
          "type": "number"
        },
        {
          "selector": "rack_name",
          "text": "rack",
          "type": "string"
        },
        {
          "selector": "node_state",
          "text": "state",
          "type": "string"
        },
        {
          "selector": "ib_speed",
          "text": "ib_speed",
          "type": "string"
        },
        {
          "selector": "ready",
          "text": "ready",
          "type": "boolean"
        },
        {
          "selector": "unschedulable",
          "text": "unschedulable",
          "type": "boolean"
        },
        {
          "selector": "kernel_deadlock",
          "text": "kernel_deadlock",
          "type": "boolean"
        },
        {
          "selector": "deadlock_reason",
          "text": "deadlock_reason",
          "type": "string"
        },
        {
          "selector": "cordon_reason",
          "text": "cordon_reason",
          "type": "string"
        },
        {
          "selector": "pending_phase",
          "text": "pending_phase",
          "type": "string"
        },
        {
          "selector": "deadlock_message",
          "text": "deadlock_message",
          "type": "string"
        },
        {
          "selector": "error_class",
          "text": "error_class",
          "type": "string"
        },
        {
          "selector": "error",
          "text": "error",
          "type": "string"
        }
      ]
    }
  ]
}
