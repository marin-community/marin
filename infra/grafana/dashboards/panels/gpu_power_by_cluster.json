{
  "type": "timeseries",
  "title": "GPU power by cluster",
  "description": "Sum of every reporting GPU's dcgm power draw, per cluster. A cluster's line dropping to zero while its jobs are still running means its node agents stopped reporting, not that the GPUs went idle -- check telemetry freshness before believing a dip.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "fieldConfig": {
    "defaults": {
      "unit": "kwatt",
      "custom": {
        "drawStyle": "line",
        "lineWidth": 1,
        "fillOpacity": 22,
        "showPoints": "never",
        "spanNulls": false,
        "stacking": {
          "mode": "normal",
          "group": "A"
        }
      },
      "min": 0,
      "decimals": 1
    },
    "overrides": [
      {
        "matcher": {
          "id": "byName",
          "options": "cw-rno2a"
        },
        "properties": [
          {
            "id": "color",
            "value": {
              "mode": "fixed",
              "fixedColor": "#3987e5"
            }
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "cw-us-east-02a"
        },
        "properties": [
          {
            "id": "color",
            "value": {
              "mode": "fixed",
              "fixedColor": "#d95926"
            }
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "cw-us-east-08a"
        },
        "properties": [
          {
            "id": "color",
            "value": {
              "mode": "fixed",
              "fixedColor": "#199e70"
            }
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "marin"
        },
        "properties": [
          {
            "id": "color",
            "value": {
              "mode": "fixed",
              "fixedColor": "#d55181"
            }
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "marin-dev"
        },
        "properties": [
          {
            "id": "color",
            "value": {
              "mode": "fixed",
              "fixedColor": "#008300"
            }
          }
        ]
      }
    ]
  },
  "options": {
    "legend": {
      "showLegend": true,
      "displayMode": "table",
      "placement": "right",
      "calcs": [
        "lastNotNull",
        "max"
      ]
    },
    "tooltip": {
      "mode": "multi",
      "sort": "desc"
    }
  },
  "targets": [
    {
      "refId": "A",
      "type": "json",
      "source": "url",
      "format": "timeseries",
      "parser": "backend",
      "url": "/query",
      "url_options": {
        "method": "GET",
        "params": [
          {
            "key": "sql",
            "value": "SELECT t, cl AS series, SUM(w) / 1000.0 AS value FROM ( SELECT COALESCE(NULLIF(\"cluster\", ''), 'marin') AS cl, date_bin(INTERVAL '${__interval_ms} milliseconds', to_timestamp_millis(timestamp_ms)) AS t, json_get(attributes_json, 'gpu_uuid') AS gpu, AVG(value) AS w FROM \"telemetry_v1\" WHERE service = 'iris-node-agent' AND name = 'gpu_power_watts' AND COALESCE(NULLIF(\"cluster\", ''), 'marin') IN (${cluster:sqlstring}) AND timestamp_ms >= CAST(EXTRACT(EPOCH FROM {{from}}) * 1000 AS BIGINT) AND timestamp_ms < CAST(EXTRACT(EPOCH FROM {{to}}) * 1000 AS BIGINT) GROUP BY 1, 2, 3) GROUP BY 1, 2 ORDER BY 1"
          },
          {
            "key": "from",
            "value": "${__from}"
          },
          {
            "key": "to",
            "value": "${__to}"
          }
        ]
      },
      "columns": [
        {
          "selector": "t",
          "text": "time",
          "type": "timestamp_epoch"
        },
        {
          "selector": "series",
          "text": "series",
          "type": "string"
        },
        {
          "selector": "value",
          "text": "value",
          "type": "number"
        }
      ]
    }
  ],
  "interval": "1m"
}
