{
  "type": "timeseries",
  "title": "generate: share of each child span",
  "description": "`generate`'s direct child spans as shares of `generate`. `rollout_collect` is the fan-out over trajectories. `generate_span_residual` should stay near zero.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "fieldConfig": {
    "defaults": {
      "custom": {
        "drawStyle": "line",
        "lineWidth": 1,
        "fillOpacity": 60,
        "showPoints": "never",
        "spanNulls": false,
        "axisLabel": "share of the generate wall",
        "stacking": {
          "mode": "normal",
          "group": "A"
        }
      },
      "unit": "percentunit",
      "min": 0,
      "max": 1,
      "noValue": "No generate child spans. This runner or build does not publish them. The generate total is on Step composition.",
      "displayName": "${__field.labels.series}"
    },
    "overrides": []
  },
  "options": {
    "legend": {
      "showLegend": true,
      "displayMode": "list",
      "placement": "bottom",
      "calcs": []
    },
    "tooltip": {
      "mode": "multi",
      "sort": "desc"
    }
  },
  "targets": [
    {
      "refId": "A",
      "type": "json",
      "source": "url",
      "format": "timeseries",
      "parser": "backend",
      "url": "/v1/rl/generation",
      "url_options": {
        "method": "GET",
        "params": [
          {
            "key": "clusters",
            "value": "${cluster:csv}"
          },
          {
            "key": "run",
            "value": "${run}"
          },
          {
            "key": "from",
            "value": "${__from}"
          },
          {
            "key": "to",
            "value": "${__to}"
          },
          {
            "key": "bucket_ms",
            "value": "${__interval_ms}"
          },
          {
            "key": "view",
            "value": "generate_breakdown"
          }
        ]
      },
      "columns": [
        {
          "selector": "t",
          "text": "time",
          "type": "timestamp_epoch"
        },
        {
          "selector": "series",
          "text": "series",
          "type": "string"
        },
        {
          "selector": "value",
          "text": "value",
          "type": "number"
        }
      ]
    }
  ],
  "interval": "1m"
}
