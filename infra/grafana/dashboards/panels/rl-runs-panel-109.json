{
  "type": "timeseries",
  "title": "vLLM token throughput",
  "description": "Prompt and generated-token throughput summed across inference engines. Rising prompt share can mean more prefill work; compare prefix-cache hit rate and the task’s sampling pattern before calling it inefficient. Rates use reset-aware per-engine counter deltas; requires engine telemetry. Run-wide: this panel ignores the Job and Execution pickers.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "fieldConfig": {
    "defaults": {
      "custom": {
        "drawStyle": "line",
        "lineWidth": 1,
        "fillOpacity": 8,
        "showPoints": "never",
        "spanNulls": false,
        "axisLabel": "tokens / s"
      },
      "min": 0,
      "unit": "tps",
      "noValue": "No vLLM rows for this run. If the whole rank is blank, the engine exporter is down rather than six separate faults."
    },
    "overrides": []
  },
  "options": {
    "legend": {
      "showLegend": true,
      "displayMode": "list",
      "placement": "bottom",
      "calcs": []
    },
    "tooltip": {
      "mode": "multi",
      "sort": "desc"
    }
  },
  "targets": [
    {
      "refId": "A",
      "format": "timeseries",
      "url": "/v1/rl/overview",
      "columns": [
        {
          "selector": "t",
          "text": "time",
          "type": "timestamp_epoch"
        },
        {
          "selector": "generation",
          "text": "generation",
          "type": "number"
        },
        {
          "selector": "prompt",
          "text": "prompt",
          "type": "number"
        }
      ],
      "targetRef": "rl_run",
      "view": "engine_tokens"
    }
  ],
  "interval": "1m",
  "maxDataPoints": 360
}
