{
  "type": "timeseries",
  "title": "Signed span residuals: generate and policy_ppo_train",
  "description": "`generate_span_residual` from the driver and `policy_span_residual` on the slowest rank. Positive is ordinary. Negative means a child is counted twice. Never clamped.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "fieldConfig": {
    "defaults": {
      "custom": {
        "drawStyle": "line",
        "lineWidth": 1,
        "fillOpacity": 8,
        "showPoints": "never",
        "spanNulls": false,
        "axisLabel": "seconds the children do not account for"
      },
      "unit": "s",
      "noValue": "No residual rows. Builds without span trees publish neither residual, and policy_span_residual also needs trainer.policy_train_spans=true."
    },
    "overrides": []
  },
  "options": {
    "legend": {
      "showLegend": true,
      "displayMode": "list",
      "placement": "bottom",
      "calcs": []
    },
    "tooltip": {
      "mode": "multi",
      "sort": "desc"
    }
  },
  "targets": [
    {
      "refId": "A",
      "targetRef": "rl_run",
      "url": "/v1/rl/overview",
      "view": "generate_residual",
      "format": "timeseries",
      "columns": [
        {
          "selector": "t",
          "text": "time",
          "type": "timestamp_epoch"
        },
        {
          "selector": "generate_span_residual",
          "text": "generate_span_residual",
          "type": "number"
        }
      ]
    },
    {
      "refId": "B",
      "targetRef": "rl_run",
      "url": "/v1/rl/overview",
      "view": "policy_residual",
      "format": "timeseries",
      "columns": [
        {
          "selector": "t",
          "text": "time",
          "type": "timestamp_epoch"
        },
        {
          "selector": "policy_span_residual",
          "text": "policy_span_residual",
          "type": "number"
        }
      ]
    }
  ],
  "interval": "1m"
}
