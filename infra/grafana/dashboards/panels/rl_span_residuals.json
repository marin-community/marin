{
  "type": "timeseries",
  "title": "Signed span residuals — both trees",
  "description": "What each parent measured that its children do not account for. Positive is ordinary. Negative means a child is double-counted — the first instrumented run read -1703 s inside a 1706 s parent. Never clamped.",
  "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "finelog-marin"
  },
  "fieldConfig": {
    "defaults": {
      "custom": {
        "drawStyle": "line",
        "lineWidth": 1,
        "fillOpacity": 8,
        "showPoints": "never",
        "spanNulls": false,
        "axisLabel": "seconds the children do not account for"
      },
      "unit": "s",
      "noValue": "No residual rows. The residual ships with the spans, so this build predates an auditable tree."
    },
    "overrides": []
  },
  "options": {
    "legend": {
      "showLegend": true,
      "displayMode": "list",
      "placement": "bottom",
      "calcs": []
    },
    "tooltip": {
      "mode": "multi",
      "sort": "desc"
    }
  },
  "targets": [
    {
      "refId": "A",
      "type": "json",
      "source": "url",
      "format": "timeseries",
      "parser": "backend",
      "url": "/v1/rl/overview",
      "url_options": {
        "method": "GET",
        "params": [
          {
            "key": "clusters",
            "value": "${cluster:csv}"
          },
          {
            "key": "run",
            "value": "${run}"
          },
          {
            "key": "from",
            "value": "${__from}"
          },
          {
            "key": "to",
            "value": "${__to}"
          },
          {
            "key": "bucket_ms",
            "value": "${__interval_ms}"
          },
          {
            "key": "view",
            "value": "generate_residual"
          }
        ]
      },
      "columns": [
        {
          "selector": "t",
          "text": "time",
          "type": "timestamp_epoch"
        },
        {
          "selector": "generate_residual",
          "text": "generate_residual",
          "type": "number"
        }
      ]
    },
    {
      "refId": "B",
      "type": "json",
      "source": "url",
      "format": "timeseries",
      "parser": "backend",
      "url": "/v1/rl/overview",
      "url_options": {
        "method": "GET",
        "params": [
          {
            "key": "clusters",
            "value": "${cluster:csv}"
          },
          {
            "key": "run",
            "value": "${run}"
          },
          {
            "key": "from",
            "value": "${__from}"
          },
          {
            "key": "to",
            "value": "${__to}"
          },
          {
            "key": "bucket_ms",
            "value": "${__interval_ms}"
          },
          {
            "key": "view",
            "value": "policy_residual"
          }
        ]
      },
      "columns": [
        {
          "selector": "t",
          "text": "time",
          "type": "timestamp_epoch"
        },
        {
          "selector": "policy_residual",
          "text": "policy_residual",
          "type": "number"
        }
      ]
    }
  ],
  "interval": "1m"
}
