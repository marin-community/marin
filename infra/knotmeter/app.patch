+        metrics: {
+          server_gpu_cache_hit_rate: 0.526827832069493,
+          server_cpu_cache_hit_rate: 0,
+          kv_cache_pool_tokens: 20609536,
+          output_tput_per_gpu: 86.31751,
+        },
+      },
+    ]);
+  });
+});
