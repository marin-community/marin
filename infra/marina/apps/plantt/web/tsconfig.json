{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@rsbuild/core/types"],
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "vue": ["./node_modules/vue"],
      "@marina/*": ["../../../web/*"]
    }
  },
  "include": [
    "src/**/*.js",
    "src/**/*.vue",
    "rsbuild.config.ts",
    "../../../web/**/*.ts",
    "../../../web/**/*.vue"
  ]
}
