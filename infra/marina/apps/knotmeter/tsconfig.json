{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@marina/*": ["../../web/*"], "vue": ["node_modules/vue"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../../web/AppBar.vue"]
}
