  "workloads": {
    "accounting": "SELECT \"cluster\",\n       json_get(labels, 'user') AS user_name,\n       json_get(labels, 'project') AS project,\n       max(value) - min(value) AS accelerator_seconds\nFROM \"telltale\"\nWHERE name = 'iris_accelerator_seconds_total'\n  AND ts >= to_timestamp_millis(1767830400001) AND ts < to_timestamp_millis(1768435200001)\nGROUP BY \"cluster\", user_name, project\nORDER BY accelerator_seconds DESC",
    "alert_evaluation": "SELECT name, \"cluster\", region, value, ts, labels\nFROM \"telltale\"\nWHERE name IN (\n    'telemetry_progress_age_seconds',\n    'telemetry_worker_heartbeat_age_seconds',\n    'telemetry_vllm_queue_saturation',\n    'telemetry_gpu_health',\n    'telemetry_forwarding_gap',\n    'telemetry_producer_heartbeat'\n  )\n  AND ts >= to_timestamp_millis(1768431600001) AND ts < to_timestamp_millis(1768435200001)\nQUALIFY row_number() OVER (\n  PARTITION BY name, \"cluster\", region, run, job_id, worker, process_index,\n               json_get(labels, 'method'),\n               json_get(labels, 'status'),\n               json_get(labels, 'le')\n  ORDER BY ts DESC\n) = 1",
    "errors": "SELECT \"cluster\", name, json_get(labels, 'error_code') AS error_code,\n       json_get(labels, 'body') AS body, sum(value) AS errors\nFROM \"telltale\"\nWHERE (\n    name = 'iris_rpc_errors_total'\n    OR (\n      name = 'iris_error_log_entries_total'\n      AND run = 'run-000007'\n      AND json_get(labels, 'body') LIKE '%OOM%'\n    )\n  )\n  AND ts >= to_timestamp_millis(1768413600001) AND ts < to_timestamp_millis(1768435200001)\nGROUP BY \"cluster\", name, error_code, body\nORDER BY errors DESC",
    "fleet_failures": "SELECT \"cluster\", region,\n       max(CASE WHEN name = 'iris_worker_state' THEN value END) AS latest_state,\n       sum(CASE WHEN name = 'iris_task_failures_total' THEN value ELSE 0 END) AS failures\nFROM \"telltale\"\nWHERE name IN ('iris_task_failures_total', 'iris_worker_state')\n  AND ts >= to_timestamp_millis(1768413600001) AND ts < to_timestamp_millis(1768435200001)\nGROUP BY \"cluster\", region\nORDER BY failures DESC",
    "node_device_history": "SELECT date_bin(INTERVAL '5 minutes', ts) AS t,\n       run,\n       name,\n       json_get(labels, 'device') AS device,\n       avg(value) AS value\nFROM \"telltale\"\nWHERE worker = 'worker-0007'\n  AND name IN (\n    'iris_device_temperature_celsius',\n    'iris_device_memory_used_bytes',\n    'iris_device_health'\n  )\n  AND ts >= to_timestamp_millis(1768348800001) AND ts < to_timestamp_millis(1768435200001)\nGROUP BY 1, 2, 3, 4\nORDER BY 1, 2, 3, 4",
    "run_drilldown_15m": "SELECT date_bin(INTERVAL '1 minute', ts) AS t, name, avg(value) AS value\nFROM \"telltale\"\nWHERE run = 'run-000007'\n  AND name IN ('levanter_train_loss', 'levanter_throughput', 'levanter_step', 'levanter_learning_rate', 'levanter_gradient_norm', 'levanter_parameter_norm', 'levanter_optimizer_step_seconds', 'levanter_checkpoint_seconds', 'levanter_input_queue_depth', 'levanter_tokens_total')\n  AND ts >= to_timestamp_millis(1768434300001) AND ts < to_timestamp_millis(1768435200001)\nGROUP BY 1, 2\nORDER BY 1, 2",
    "run_drilldown_24h": "SELECT date_bin(INTERVAL '1 minute', ts) AS t, name, avg(value) AS value\nFROM \"telltale\"\nWHERE run = 'run-000007'\n  AND name IN ('levanter_train_loss', 'levanter_throughput', 'levanter_step', 'levanter_learning_rate', 'levanter_gradient_norm', 'levanter_parameter_norm', 'levanter_optimizer_step_seconds', 'levanter_checkpoint_seconds', 'levanter_input_queue_depth', 'levanter_tokens_total')\n  AND ts >= to_timestamp_millis(1768348800001) AND ts < to_timestamp_millis(1768435200001)\nGROUP BY 1, 2\nORDER BY 1, 2",
    "run_drilldown_7d": "SELECT date_bin(INTERVAL '1 minute', ts) AS t, name, avg(value) AS value\nFROM \"telltale\"\nWHERE run = 'run-000007'\n  AND name IN ('levanter_train_loss', 'levanter_throughput', 'levanter_step', 'levanter_learning_rate', 'levanter_gradient_norm', 'levanter_parameter_norm', 'levanter_optimizer_step_seconds', 'levanter_checkpoint_seconds', 'levanter_input_queue_depth', 'levanter_tokens_total')\n  AND ts >= to_timestamp_millis(1767830400001) AND ts < to_timestamp_millis(1768435200001)\nGROUP BY 1, 2\nORDER BY 1, 2",
    "vllm_histogram": "SELECT date_bin(INTERVAL '1 minute', ts) AS t,\n       json_get(labels, 'le') AS le,\n       max(value) - min(value) AS observations\nFROM \"telltale\"\nWHERE name = 'vllm_time_to_first_token_seconds_bucket'\n  AND run = 'run-000007'\n  AND ts >= to_timestamp_millis(1768431600001) AND ts < to_timestamp_millis(1768435200001)\nGROUP BY 1, 2\nORDER BY 1, 2",
    "worker_outliers": "WITH latest AS (\n  SELECT worker, name, value, ts,\n         row_number() OVER (PARTITION BY worker, name ORDER BY ts DESC) AS row_num\n  FROM \"telltale\"\n  WHERE run = 'run-000007'\n    AND name IN ('process_resident_memory_bytes', 'process_cpu_seconds_total')\n    AND ts >= to_timestamp_millis(1768431600001) AND ts < to_timestamp_millis(1768435200001)\n)\nSELECT worker,\n       max(CASE WHEN name = 'process_resident_memory_bytes' THEN value END) AS rss_bytes,\n       max(CASE WHEN name = 'process_cpu_seconds_total' THEN value END) AS cpu_seconds\nFROM latest\nWHERE row_num = 1\nGROUP BY worker\nORDER BY rss_bytes DESC\nLIMIT 20"
  }
