  "workloads": {
    "alert_evaluation": "SELECT name, \"cluster\", region, value, ts, labels\nFROM \"telltale\"\nWHERE name IN (\n    'telemetry_progress_age_seconds',\n    'telemetry_worker_heartbeat_age_seconds',\n    'telemetry_vllm_queue_saturation',\n    'telemetry_gpu_health',\n    'telemetry_forwarding_gap',\n    'telemetry_producer_heartbeat'\n  )\n  AND ts >= to_timestamp_millis(1768431600001) AND ts < to_timestamp_millis(1768435200001)\nQUALIFY row_number() OVER (\n  PARTITION BY name, \"cluster\", region, run, job_id, worker, process_index,\n               json_get(labels, 'method'),\n               json_get(labels, 'status'),\n               json_get(labels, 'le')\n  ORDER BY ts DESC\n) = 1",
    "run_drilldown_15m": "SELECT date_bin(INTERVAL '1 minute', ts) AS t, name, avg(value) AS value\nFROM \"telltale\"\nWHERE run = 'run-000007'\n  AND name IN ('levanter_train_loss', 'levanter_throughput', 'levanter_step', 'levanter_learning_rate', 'levanter_gradient_norm', 'levanter_parameter_norm', 'levanter_optimizer_step_seconds', 'levanter_checkpoint_seconds', 'levanter_input_queue_depth', 'levanter_tokens_total')\n  AND ts >= to_timestamp_millis(1768434300001) AND ts < to_timestamp_millis(1768435200001)\nGROUP BY 1, 2\nORDER BY 1, 2"
  }
}
